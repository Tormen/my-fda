# One tccd check, its lines as `log show --style compact` prints them; a
# responsible of "-" leaves its block out, as tccd does for a program started
# with no parent it attributes it to (2026-10-31: git as uid 1001). The
# REQUEST line names the tccd that answers: 0 the system's, N that user's.
t_check() { # <tccd pid> <msgID> <service> <subject> <accessing binary> <authValue> [<time>] [<accessing pid>] [<responsible>] [<tccd uid>]
  _p="2026-10-25 ${7:-10:01:30}.083 Df tccd[$1:428a401] [com.apple.TCC:access]"
  _r="${9:-$4}"
  if [ "$_r" = "-" ]; then _r=""
  else _r="responsible={TCCDProcess: identifier=com.apple.dash, pid=45618, auid=0, euid=0, responsible_path=$_r, binary_path=$_r}, "; fi
  printf '%s\n' \
    "$_p REQUEST: tccd_uid=${10:-0}, sender_pid=${2%%.*}, sender_uid=0, sender_auid=-1, function=TCCAccessRequest, msgID=$2" \
    "$_p AUTHREQ_CTX: msgID=$2, function=TCCAccessRequest, service=$3, preflight=yes, query=1, client_dict=(null), daemon_dict=<private>" \
    "$_p AUTHREQ_ATTRIBUTION: msgID=$2, attribution={${_r}accessing={TCCDProcess: identifier=x, pid=${8:-45749}, auid=0, euid=0, binary_path=$5}, requesting={TCCDProcess: identifier=com.apple.sandboxd, pid=186, auid=0, euid=0, binary_path=/usr/libexec/sandboxd}, }," \
    "$_p AUTHREQ_SUBJECT: msgID=$2, subject=$4," \
    "$_p AUTHREQ_RESULT: msgID=$2, authValue=$6, authReason=5, authVersion=1, desired_auth=0, error=(null),"
}
t_denied_names_the_program_how_often_and_via() {
  { t_check 191 186.1 "$SERVICE" /bin/sh /usr/sbin/diskutil 0 10:00:24
    t_check 191 186.2 "$SERVICE" /usr/sbin/sshd /usr/libexec/sshd-session 2
    t_check 191 186.3 "$SERVICE" /bin/sh /usr/sbin/diskutil 0 10:06:58; } > "$T_DIR/tccd.log"
  _o=$(cmd_denied 2>&1)
  case "$_o" in *sshd*) t_fail "an allowed check is listed: '$_o'"; return ;; esac
