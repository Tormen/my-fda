# the trees: the global one, then the local one -- local wins key by key, and
# the global keys the local file does not set stay. The same whether the farm
# still links the global file or, once the local one exists, the local one.
t_config_reads_global_then_local() {
  mkdir -p -- "$T_DIR/farm" "$T_DIR/global" "$T_DIR/local"
  printf '%s\n' "CONFIG_SEARCH_DIR=\"$T_DIR/farm\"" "CONFIG_OFFER_DIR=\"$T_DIR/global\"" "CONFIG_LOCAL_DIR=\"$T_DIR/local\"" > "$T_DIR/site.conf"
  printf '%s\n' 'TCC_DB=/global' 'HELPER_DIR=/global-helpers' > "$T_DIR/global/my-fda.conf"
  printf '%s\n' 'TCC_DB=/local' 'TCC_DB_WRITABLE=no' > "$T_DIR/local/my-fda.conf"
  for _to in global local; do
    rm -f "$T_DIR/farm/my-fda.conf"; ln -s "../$_to/my-fda.conf" "$T_DIR/farm/my-fda.conf"
    _o=$( (for _k in $CONFIG_KEYS; do unset "$_k"; done; CONFIG_ARG=""; MY_FDA_CONFIG=""
    # shellcheck disable=SC2031  # load_config sets it in this subshell
           load_config && printf '%s|%s|%s|%s' "$TCC_DB" "$HELPER_DIR" "$TCC_DB_WRITABLE" "$CONFIG_FILE") 2>&1)
    [ "$_o" = "/local|/global-helpers|no|$T_DIR/global/my-fda.conf + $T_DIR/local/my-fda.conf" ] || { t_fail "farm -> $_to: '$_o'"; return; }
  done
  # --config names one file: that one alone
  _o=$( (for _k in $CONFIG_KEYS; do unset "$_k"; done; CONFIG_ARG="$T_DIR/global/my-fda.conf"; MY_FDA_CONFIG=""
    # shellcheck disable=SC2031  # load_config sets it in this subshell
         load_config && printf '%s|%s' "$TCC_DB" "$TCC_DB_WRITABLE") 2>&1)
  [ "$_o" = "/global|" ] || { t_fail "--config: '$_o'"; return; }
  printf 'TCC_DB_WRITABLE=maybe\n' >> "$T_DIR/local/my-fda.conf"
  _o=$( (for _k in $CONFIG_KEYS; do unset "$_k"; done; CONFIG_ARG=""; MY_FDA_CONFIG=""; load_config) 2>&1); _rc=$?
  case "$_rc|$_o" in 1"|ERROR "*"TCC_DB_WRITABLE='maybe'"*) t_pass ;; *) t_fail "a bad value: rc $_rc '$_o'" ;; esac
}
