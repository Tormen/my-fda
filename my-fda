t_ctrl_c_at_the_wait_ends_in_one_line_and_130() {
  [ "$(id -u)" = "0" ] && { echo "  SKIP  $T_NAME -- root writes a read-only file"; t_pass; return; }
  command -v perl > /dev/null || { echo "  SKIP  $T_NAME -- no perl to give the run its SIGINT back"; t_pass; return; }
  sed '/^#* main$/,$d' "$(self_path)" > "$T_DIR/lib.sh"
  mkfifo "$T_DIR/tty" || { t_fail "mkfifo"; return; }
  sleep 30 > "$T_DIR/tty" & _w=$!                           # a terminal nobody types into
  # shellcheck disable=SC2016  # the child expands its own $1.. and variables
  perl -e '$SIG{INT} = "DEFAULT"; exec @ARGV' /bin/dash -c '
    . "$1"; T_STUBS=$2; t_world; echo "$T_DIR" > "$3/child"
    t_grant 1 "$T_DIR/bin/tool"; chmod 444 "$TCC_DB"; TTY="$3/tty"
    interrupt_traps
    cmd_remove go <<_EOF
$(t_id 1 "$T_DIR/bin/tool")
_EOF
    echo "AFTER THE WAIT"' my-fda "$T_DIR/lib.sh" "$T_STUBS" "$T_DIR" > "$T_DIR/out" 2> "$T_DIR/err" &
  _c=$!
  _i=0
  until grep -q 'press Return' "$T_DIR/out" 2> /dev/null || [ "$_i" -ge 100 ]; do sleep 0.1; _i=$((_i + 1)); done
  kill -INT "$_c"; wait "$_c"; _rc=$?
  kill "$_w" 2> /dev/null
  _cd=$(cat "$T_DIR/child" 2> /dev/null); chmod 644 "$_cd/TCC.db" 2> /dev/null
  _e=$(cat "$T_DIR/err"); _n=$(awk 'END { print NR }' "$T_DIR/err")
  if [ "$_rc" = "130" ] && [ "$_n" = "1" ] \
     && case "$_e" in "my-fda: interrupted (Ctrl-C) while waiting for grants to be taken away by hand"*) true ;; *) false ;; esac \
     && ! grep -q 'AFTER THE WAIT' "$T_DIR/out" && [ -n "$_cd" ] && [ ! -d "$_cd/work" ]; then t_pass
  else t_fail "rc $_rc, $_n stderr line(s) '$_e', work left: $([ -d "$_cd/work" ] && echo yes || echo no), out '$(cat "$T_DIR/out")'"
  fi
  rm -rf "$_cd"
}
# --recommended replaces `list | grep -- '-> remove' | cut -f 1 | remove go`:
# exactly that set -- a shell and a GONE path -- and nothing else.
t_remove_recommended_takes_what_list_marks_remove() {
  t_grant 1 /bin/sh; t_grant 1 "$T_DIR/gone"; t_grant 1 "$T_DIR/bin/tool"; t_grant 0 com.known.app
  _want=$(QUIET=1 cmd_list | grep -- "$TO_REMOVE" | cut -f 1 | sort | tr '\n' ' ')
  [ "$(printf '%s' "$_want" | wc -w | tr -d ' ')" = "2" ] || { t_fail "setup: list marks '$_want'"; return; }
  _o=$( (RECOMMENDED=1; cmd_remove) 2>&1)
  [ "$(t_count)" = "4" ] || { t_fail "without go it took something: '$_o'"; return; }
  case "$_o" in *"remove --recommended go' takes these 2 grant(s) away"*) ;; *) t_fail "without go: '$_o'"; return ;; esac
  _o=$( (RECOMMENDED=1; cmd_remove go) 2>&1); _rc=$?
