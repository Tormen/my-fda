# Executable by everyone, so the launcher must refuse anyone but its uid --
# and the target must not run at all.
t_launcher_refuses_to_run_as_anyone_but_root() {
  { [ -x "$c_cc" ] && "$c_xcode_select" -p > /dev/null 2>&1; } || { echo "  SKIP  $T_NAME -- no cc"; t_pass; return; }
  [ "$(id -u)" = "0" ] && { echo "  SKIP  $T_NAME -- run as root, it would run"; t_pass; return; }
  printf '%s\n' '#!/bin/sh' ": > '$T_DIR/ran'" > "$T_DIR/bin/job"; chmod 755 "$T_DIR/bin/job"
  LAUNCHER_UID=0 cmd_create job "$T_DIR/bin/job" > /dev/null 2>&1
