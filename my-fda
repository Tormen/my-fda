#!/bin/dash
# my-fda -- Full Disk Access for root jobs, kept stable across upgrades.
#
# macOS ties a Full Disk Access grant to a binary's path and contents. A
# Homebrew binary changes both on every upgrade, so its grant silently stops
# applying. my-fda lists the grants and says which are stale, takes them
# away, and builds LAUNCHERS: tiny programs that hold the grant for a root
# job and never change, so the grant lasts.

SCRIPT_VERSION="0.2"
SCRIPT_COMMIT="72953f4"
SCRIPT_RELEASE="v0.2-30-g72953f4"

US="${0##*/}"
QUIET=0; VRB=0
CONFIG_ARG=""
USER_ARG=""          # create --user: the user the launcher runs its target as
GROUP_ARG=""         # create --group: that user's primary group instead of their own
RECOMMENDED=0        # remove --recommended: the grants list marks TO_REMOVE, instead of IDs
CATCH=0              # denied --catch: wait for the next refusal instead of reading the past
INSTALL=0            # --install: record what this machine lets my-fda do, in its config
SERVICE_SEL=""       # denied --service: "" = DENIED_SERVICES, all, or a part of a service's name
SITE_CONF="/LINKS/default/site.conf"   # the ONE site path in this tool: read_site
SINCE_ARG=""         # denied --since: the local time its window starts at, or ""
UNTIL_ARG=""         # denied --until: the local time a --since window ends at, or ""
TO_REMOVE="-> remove" # list's mark on a grant to take away -- remove --recommended selects on it
LAUNCHER_UID=0       # the only uid a launcher runs under: root (the tests set their own)
TAB=$(printf '\t')
SERVICE="kTCCServiceSystemPolicyAllFiles"
# An Endpoint Security system extension's Full Disk Access is kept under this
# service instead -- the pane shows it with the others, my-fda only lists it.
SERVICE_ES="kTCCServiceEndpointSecurityClient"
WORK=""
PHASE="starting -- nothing was changed"
TTY="/dev/tty"       # where a wait reads its Return (the tests point it elsewhere)

err() { # <code> [text]
  _c="$1"; shift
  printf 'ERROR %s [1]: %s\n' "$_c" "$*" 1>&2
  exit 1
}

msg() { [ "$QUIET" = "1" ] || printf '%s\n' "$*"; }   # standard output; -Q silences it
say() { printf '%s\n' "$*"; }                          # a plan a destructive step depends on: never silenced
warn() { printf '%s\n' "$*" 1>&2; }

# Echo a command under -V, then run it: one source for both.
run() {
  [ "$VRB" = "1" ] && printf ' >>> %s\n' "$*"
  "$@"
}

is_root() { [ "$(id -u)" = "0" ]; }

need_root() {
  is_root && return 0
  printf '%s\n' "needs root -- rerun under sudo:" "    sudo $0 $ARGS_TEXT" 1>&2
  exit 1
}

# The real file behind $0 -- the installed my-fda may be a link or a copy.
self_path() {
  _p="$0"
  while [ -L "$_p" ]; do
    _l=$(readlink "$_p")
    case "$_l" in /*) _p="$_l" ;; *) _p="${_p%/*}/$_l" ;; esac
  done
  printf '%s\n' "$_p"
}
# PATH as macOS records it in a grant: its own links and its directories
# followed -- /opt/tools/sbin/x is granted as /Volumes/Data/tools/sbin/x
real_path() { # <PATH>
  _rp=$1
  while [ -L "$_rp" ]; do
    _rl=$(readlink "$_rp")
    case "$_rl" in /*) _rp="$_rl" ;; *) _rp="${_rp%/*}/$_rl" ;; esac
  done
  _rd=$(cd "${_rp%/*}" 2>/dev/null && pwd -P) || { printf '%s\n' "$1"; return 0; }
  printf '%s\n' "$_rd/${_rp##*/}"
}
self_dir() { _sd=$(self_path); _sd=$(cd "${_sd%/*}" 2>/dev/null && pwd -P) && printf '%s\n' "$_sd"; }

# git is asked only where my-fda OWNS the repository: a copy inside another
# repo (the container that mirrors it) would report THAT repo's tags.
own_git() {
  _og=$(self_dir)
  [ -n "$_og" ] && [ "$(git -c safe.directory='*' -C "$_og" rev-parse --show-toplevel 2>/dev/null)" = "$_og" ]
}

version() {
  _b=$(shasum -a 256 "$(self_path)" | awk '{ print substr($1, 1, 12) }')
  _d=""; _c=""
  if own_git; then
    _d=$(git -c safe.directory='*' -C "$(self_dir)" describe --tags --long 2>/dev/null)
    _c=$(git -c safe.directory='*' -C "$(self_dir)" rev-parse --short HEAD 2>/dev/null)
  fi
  [ -z "$_d" ] && [ -z "$_c" ] && [ -n "$SCRIPT_COMMIT" ] && _d=$SCRIPT_RELEASE
  case "$_d" in
    *-*-g*)
      _t=${_d%-*-g*}
      _n=${_d%-g*}; _n=${_n##*-}
      if [ "$_n" = "0" ]; then
        printf '%s %s (%s: the %s tag, build %s)\n' "$US" "$SCRIPT_VERSION" "$_d" "$_t" "$_b"
      else
        printf '%s %s+%s (%s: %s commit(s) past %s, unreleased, build %s)\n' \
          "$US" "$SCRIPT_VERSION" "$_n" "$_d" "$_n" "$_t" "$_b"
      fi ;;
    *)
      if [ -n "$_c" ]; then
        printf '%s %s (commit %s, no release tag yet, build %s)\n' "$US" "$SCRIPT_VERSION" "$_c" "$_b"
      elif [ -n "$SCRIPT_COMMIT" ]; then
        printf '%s %s (commit %s, build %s)\n' "$US" "$SCRIPT_VERSION" "$SCRIPT_COMMIT" "$_b"
      else
        printf '%s %s (build %s, unstamped)\n' "$US" "$SCRIPT_VERSION" "$_b"
      fi ;;
  esac
}

# Record HEAD and git's describe string in this file, then AMEND the commit
# they belong to. After committing, BEFORE pushing; tag afterwards. The
# stamped sha lags HEAD by one: amending changes it, and that is expected.
stamp_version() {
  _sv_dir=$(self_dir) || err 00001 "--stamp-version: cannot resolve my own directory"
  _sv_self="$_sv_dir/my-fda"
  own_git || err 00002 "--stamp-version: $_sv_dir is not the top of my-fda's own checkout"
  _sv_sha=$(git -C "$_sv_dir" rev-parse --short HEAD 2>/dev/null)
  [ -n "$_sv_sha" ] || err 00003 "--stamp-version: no commit to stamp from"
  if git -C "$_sv_dir" rev-parse -q --verify '@{upstream}' >/dev/null 2>&1 \
     && git -C "$_sv_dir" merge-base --is-ancestor HEAD '@{upstream}' 2>/dev/null; then
    err 00004 "--stamp-version: HEAD $_sv_sha is already pushed -- amending would rewrite published history. Commit, stamp, THEN push"
  fi
  [ -n "$(git -C "$_sv_dir" show --name-only --format= HEAD -- my-fda 2>/dev/null)" ] \
    || err 00005 "--stamp-version: HEAD does not touch my-fda -- commit it first"
  _sv_staged=$(git -C "$_sv_dir" diff --cached --name-only 2>/dev/null)
  [ -z "$_sv_staged" ] || err 00006 "--stamp-version: something is staged -- the amend would fold it in: $_sv_staged"
  git -C "$_sv_dir" diff --quiet -- my-fda 2>/dev/null || err 00007 "--stamp-version: my-fda has uncommitted edits -- commit them first"
  _sv_desc=$(git -c safe.directory='*' -C "$_sv_dir" describe --tags --long 2>/dev/null)
  _sv_tmp=$(mktemp "${TMPDIR:-/tmp}/my-fda.stamp.XXXXXX") || err 00008 "--stamp-version: mktemp failed"
  cp -p "$_sv_self" "$_sv_tmp" 2>/dev/null
  sed -e "s|^SCRIPT_COMMIT=.*|SCRIPT_COMMIT=\"$_sv_sha\"|" \
      -e "s|^SCRIPT_RELEASE=.*|SCRIPT_RELEASE=\"$_sv_desc\"|" "$_sv_self" > "$_sv_tmp" \
    || { rm -f "$_sv_tmp"; err 00009 "--stamp-version: could not rewrite the stamp"; }
  grep -q "^SCRIPT_COMMIT=\"$_sv_sha\"\$" "$_sv_tmp" \
    || { rm -f "$_sv_tmp"; err 00010 "--stamp-version: the rewritten file carries no stamp -- refusing to install it"; }
  mv -f "$_sv_tmp" "$_sv_self" || { rm -f "$_sv_tmp"; err 00011 "--stamp-version: could not install the stamped file"; }
  git -C "$_sv_dir" add -- my-fda || err 00012 "--stamp-version: git add failed"
  git -C "$_sv_dir" commit -q --amend --no-edit || err 00013 "--stamp-version: git amend failed"
  printf 'stamped SCRIPT_COMMIT=%s SCRIPT_RELEASE=%s -- HEAD is now %s\n' \
    "$_sv_sha" "${_sv_desc:-<no tag yet>}" "$(git -C "$_sv_dir" rev-parse --short HEAD)"
  printf '  > the stamped sha lags HEAD by one: amending changes it. Tag AFTER this.\n'
}

usage() {
  cat <<_EOF
usage: $US [-Q] [-V] [--config <FILE>] <COMMAND> [<ARGS>]

Full Disk Access for root jobs, kept stable across Homebrew upgrades.

GRANTS -- the "+" and "-" of System Settings > Full Disk Access
  list [--service <SERVICE>|all]
                every grant, one line each: an ID, a TAB, the client (a path
                or an app id), allowed[2] / denied[0] with the raw value, and
                what to do with it:
                  GONE -> remove        the path or the app no longer exists
                  GONE: stays           a gone app where TCC.db cannot be
                                        written (TCC_DB_WRITABLE, which
                                        --install records): nothing can
                                        take it, and it applies to nothing
                  a shell, a general tool (GENERAL_TOOLS), a script, or
                  anything in Homebrew (BREW_TREES) -> remove; its job
                                        gets a launcher: whatever runs a
                                        shell or a tool gets full disk
                                        access, macOS checks a script's
                                        interpreter, and Homebrew's files
                                        change on upgrade -- but switched
                                        off (denied[0]) such a row grants
                                        nothing: macOS writes it back at each
                                        refusal, so it points at the job
                                        running the program (denied --catch)
                  system extension      an Endpoint Security extension's
                                        grant: in the pane, not removed here
                  profile               given by a configuration profile
                                        (MDMOverrides.plist): not in the pane,
                                        it goes with the profile
                An app id is GONE only when neither Spotlight nor
                LaunchServices knows it (Spotlight misses helpers inside
                other apps); Apple's own app ids are never called GONE.
                --service: instead, the grants of the TCC services whose
                name holds SERVICE, any case (AppBundles: App Management,
                Accessibility), or of every service (all), from the system
                database AND each user's own (USERS_DIR) -- App Management
                is kept per user. Two columns after the client: the
                service, and whose database holds the row (system, or a
                user's name). A user's that cannot be looked at is an
                error, never skipped. The notes above are Full Disk
                Access's. A step asks whether a program is ON by its
                row's allowed[2].
                No row is OFF on macOS 26 -- elsewhere a step cannot tell.
  denied [<PROGRAM>] [<LAST> | --since <TIME> [--until <TIME>]] [--service <SERVICE>|all]
                every file check macOS refused a program, from tccd's lines
                in the system log of the last LAST (30m, 2h, 3d or boot;
                default DENIED_LAST_DEFAULT, 1d), one line per program,
                service, answer and tccd: the program as a grant names it,
                the service (SystemPolicyAllFiles,
                SystemPolicyRemovableVolumes, ...), the answer with its raw
                values (denied[0] reason[5]: authValue, authReason), the
                tccd that answered (system[0], or a user's: alice[501]), how
                often, when last (-V: first), the binary that touched the
                file (via), the process macOS held responsible (from; "-":
                none; -V: its TCC identifier, path, uid and pid), and what
                to do. A refusal from an ssh login names Remote Login's own
                switch. A Full Disk Access probe that a narrower grant (the
                volume, the folder) allowed right after refused nothing: it
                is counted, -V shows it. A check tccd could not answer (it
                could not reach the tccd it forwards to) is the kernel's
                refusal: no answer[why], the operation and the path, and
                from: the program tccd was asked about. When that is "-" or
                only a shell, nothing names the job: the hint is denied
                --catch, never a launcher. A kernel refusal
                with no tccd or sandboxd failure is another macOS
                protection, not a privacy refusal: counted, -V shows it.
                An answer whose request (the service) is not in the log
                is nothing to act on: counted, -V shows it.
                An app (a bundle id) is pointed at the pane, a program at
                a launcher. DENIED_IGNORE names programs to leave out
                (counted, -V shows them; -Q leaves them out too).
                PROGRAM: a name (git) matches the program, via or from,
                ignoring case; a path matches that file, its links
                followed. A LAST starts with a digit, or is boot.
                --since <TIME>: from that local time (YYYY-MM-DD HH:MM:SS)
                to now, however long ago -- instead of LAST, for a caller
                that reads window after window with no gap and no overlap.
                --until <TIME> (with --since): the window ends there, not
                now -- at a time the caller took before it asked, where its
                next window starts.
                --service: by default the services in DENIED_SERVICES (the
                file and folder protections); else every service whose
                name holds SERVICE, ignoring case (RemovableVolumes,
                volumes, Camera); all: every TCC service.
                Without Full Disk Access (a LaunchDaemon) the grants are not
                read, and it says so; the log still is.
  denied --catch [<PROGRAM>] [--service <SERVICE>|all]
                waits for the next refusal and shows the refused process
                with its parents and the files it has open, while it still
                runs -- the job behind a program refused "from -", and as
                near as anything comes to the file it was refused; it ends
                after the first one it could still see, or on Ctrl-C; with
                -V it also stops at a kernel refusal with no privacy check
  add <PATH>    "+": puts PATH into the Full Disk Access list switched OFF
                and opens the pane -- macOS grants only on a click, so you
                switch it on there -- then checks that it is on. Where
                TCC.db cannot be written: shows PATH in Finder and puts it
                on the clipboard, for +, Cmd-Shift-G, Cmd-V. An app
                (.app) is granted under its bundle id, as the pane does
  remove [go] [<ID>...]
                "-": shows the grants it would take away; with go, takes them
                away. IDs as arguments, or one per line on stdin (the first
                column of a list line is enough):
                  $US list | grep 'denied\\[0\\]' | cut -f 1 | $US remove go
  remove --recommended [go]
                every grant that list marks "$TO_REMOVE" -- the same as
                  $US list | grep -- '$TO_REMOVE' | cut -f 1 | $US remove go
  cleanup [go]  the GONE grants -- the one class safe to take away without
                looking: shows them; with go, takes them away
  reset [go]    all grants at once: shows them; with go, takes them all away
                -- the Terminal running this loses its grant too -- and says
                what to give back
                Every change first backs up TCC.db (BACKUP_DIR). An app id
                goes through tccutil (installed apps only); the rest through
                sqlite where TCC.db can be written, else the pane opens with
                the names to take away with "-". A GONE app neither can
                take stays, said once: the pane does not show it, and it
                applies to nothing. Then the grants are read again, and
                anything else still there is an error. reset is tccutil's
                own: every grant at once. Extension and profile grants are
                never taken away by my-fda.

LAUNCHERS -- /Library/PrivilegedHelperTools/my-fda-<NAME>, root:wheel 755,
  run only as root
  create [<NAME>] <TARGET> [--user <USER> [--group <GROUP>]]
                build a launcher that runs TARGET (a script, or a Homebrew
                binary by its stable path such as /opt/homebrew/bin/rsync)
                with all its arguments; needs the Command Line Tools (cc).
                NAME: the target's file name without its extension, unless
                given (no '.': the pane cannot add a dotted name).
                Never over an existing one: a rebuild loses its grant.
                --user: TARGET runs as USER -- launchd starts the launcher as
                root (its LaunchDaemon names no UserName) and it drops to
                USER first; without it, TARGET runs as root.
                --group (with --user): GROUP is the primary group instead
                of USER's own -- what a LaunchDaemon's GroupName did; USER's
                other groups stay.
  destroy [go] <NAME>
                shows the launcher, its target, its grant and the daemon(s)
                using it; with go, deletes the launcher and its grant
  status [<NAME>]
                each launcher: its target, its grant, the LaunchDaemon that
                runs it
  test <NAME>   starts that LaunchDaemon through launchd -- the only run that
                proves the grant (a run from a Terminal uses the Terminal's)

Every command needs root, run from a Terminal that has Full Disk Access
itself: the permission database is protected. denied needs no Full Disk
Access: it reads the log, and the grants only where it can.

OPTIONS
  -V, --verbose         also: each command before it runs, the date (local time) of each
                        grant, an app's path
  -Q, --quiet           nothing but errors -- and the plans that go acts on
  --config <FILE>       use this config, bypassing the search
  --create-config [<FILE>]
                        print the default config, or write it to <FILE>
                        (never over an existing one)
  --install             test once whether TCC.db can be written here, and
                        record it (TCC_DB_WRITABLE) in this machine's config,
                        committed: list reads it, and never tests -- an error when
                        TCC.db cannot be opened (no Full Disk Access)
  --run-tests [<FILTER>]
                        run the built-in tests (name substring)
  --stamp-version       record the commit in this file (maintainer)
  --version             version, git describe, build id
  -h, --help            this help

CONFIG (first found wins)
  \$MY_FDA_CONFIG, --config <FILE>, \$CONFIG_SEARCH_DIR/my-fda.conf, then
  \$CONFIG_SEARCH_DIR/my-fda, ~/.my-fda.conf, /etc/my-fda.conf,
  /usr/local/etc/my-fda.conf
  A key the file does not set keeps its default (--create-config).
  Found in CONFIG_SEARCH_DIR, it is read from the trees instead: the
  site's CONFIG_OFFER_DIR/my-fda.conf, then CONFIG_LOCAL_DIR/my-fda.conf,
  this machine's own, which wins key by key.
  $SITE_CONF, when there, is read first: the site's
  CONFIG_SEARCH_DIR, CONFIG_OFFER_DIR, CONFIG_LOCAL_DIR, and DATA_BASE_DIR,
  under which BACKUP_DIR's default lies (/var/db without the file).
  There but unreadable: an error.
_EOF
}

default_config() {
  cat <<'_EOF'
# my-fda config -- plain shell, sourced at startup

# The system-wide permission database (Full Disk Access lives here).
TCC_DB="/Library/Application Support/com.apple.TCC/TCC.db"

# Where the users' homes are: list --service also reads each one's own
# permission database (Library/Application Support/com.apple.TCC/TCC.db) --
# App Management and other per-user services are kept only there.
USERS_DIR="/Users"

# Where each change first backs up TCC.db (and reset saves the list):
# under DATA_BASE_DIR from the site file (/var/db without it), the user, the tool.
BACKUP_DIR="$DATA_BASE_DIR/$(id -un)/my-fda"

# Where launchers are installed, and where the daemons that run them live.
HELPER_DIR="/Library/PrivilegedHelperTools"
LAUNCHD_DIR="/Library/LaunchDaemons"

# The Full Disk Access pane, for add.
FDA_PANE_URL="x-apple.systempreferences:com.apple.preference.security?Privacy_AllFiles"

# Where Homebrew keeps its versioned binaries: a grant on a path under one
# of these breaks on the next upgrade of that formula.
BREW_CELLARS="/opt/homebrew/Cellar /usr/local/Cellar"

# Shells: a grant on one gives full disk access to every script it runs.
SHELLS="/bin/sh /bin/bash /bin/zsh /bin/dash /bin/ksh /bin/tcsh /bin/csh"

# Homebrew's trees: a grant on anything in them breaks on the next upgrade,
# and gives full disk access to what its packages run. (BREW_CELLARS above
# only keeps create off a version path: /opt/homebrew/bin/x is its target.)
BREW_TREES="/opt/homebrew /usr/local/Cellar /usr/local/Caskroom /usr/local/Homebrew"

# General tools, by file name (shell patterns): whatever runs one gets full
# disk access too -- a job that needs it gets a launcher instead.
GENERAL_TOOLS="curl wget git python python[0-9]* perl perl[0-9]* ruby node env osascript php lua tclsh* expect"

# The commands my-fda runs.
c_sqlite3="/usr/bin/sqlite3"
c_md5="/sbin/md5"
c_mdfind="/usr/bin/mdfind"
c_open="/usr/bin/open"
c_pbcopy="/usr/bin/pbcopy"
c_killall="/usr/bin/killall"
c_launchctl="/bin/launchctl"
c_plutil="/usr/bin/plutil"
c_cc="/usr/bin/cc"
c_xcode_select="/usr/bin/xcode-select"
c_tccutil="/usr/bin/tccutil"
c_osascript="/usr/bin/osascript"
c_codesign="/usr/bin/codesign"
c_csreq="/usr/bin/csreq"
c_dscl="/usr/bin/dscl"
c_log="/usr/bin/log"
c_ps="/bin/ps"
c_lsof="/usr/sbin/lsof"
c_id="/usr/bin/id"
c_date="/bin/date"
c_git="/usr/bin/git"

# How far back denied reads the system log when given no window.
DENIED_LAST_DEFAULT="1d"

# The TCC services denied reports without --service: shell patterns, '|'
# between them. kTCCServiceSystemPolicy* are the file and folder
# protections (Full Disk Access, the removable and network volumes, Desktop,
# Documents, Downloads, ...).
DENIED_SERVICES="kTCCServiceSystemPolicy*"

# Programs whose refusals denied leaves out -- counted in its summary, shown
# with -V, left out with -Q too: file names or globs, '|' between them,
# ignoring case, matched against the program, via and from (empty: none).
DENIED_IGNORE=""

# Whether TCC.db can be written here: yes, no, or empty (not known yet).
# my-fda --install finds it out and records it in this machine'''s own
# config; list reads it -- it never writes TCC.db to find out.
TCC_DB_WRITABLE=""

# Full Disk Access given by configuration profiles (MDM) -- listed, never
# shown in System Settings.
MDM_OVERRIDES="/Library/Application Support/com.apple.TCC/MDMOverrides.plist"
_EOF
}

CONFIG_KEYS="TCC_DB USERS_DIR BACKUP_DIR HELPER_DIR LAUNCHD_DIR FDA_PANE_URL BREW_CELLARS SHELLS BREW_TREES GENERAL_TOOLS
  c_sqlite3 c_md5 c_mdfind c_open c_killall c_launchctl c_plutil c_cc c_xcode_select c_tccutil c_osascript c_codesign c_csreq MDM_OVERRIDES c_log c_ps c_lsof DENIED_LAST_DEFAULT c_pbcopy c_dscl c_id DENIED_SERVICES c_date c_git"

# sh: 0 not there, 1 there ([ -r ] it: unreadable is the error), 2 cannot tell
# Judged by the system's own answer, never by mode bits: macOS can refuse a
# look the bits allow (TCC). On 2, _sa_m says why, for the error message.
site_absent() {
	[ -e "$1" ] && return 1
	_sa_m=$(LC_ALL=C ls -d -- "$1" 2>&1 > /dev/null)
	case $_sa_m in *": No such file or directory") return 0 ;; esac
	if [ -n "$_sa_m" ]; then _sa_m="the system says: ${_sa_m##*: }"
	elif [ -L "$1" ]; then _sa_m="a link to nothing"
	else _sa_m="listed, but it cannot be looked at"; fi
	return 2
}

# The site's values for every tool, from SITE_CONF -- the one site path this
# tool knows -- read before its own config: the base directories, where a
# config is searched and where one is offered. The neutral values first, so
# an exported variable never takes their place; then the file, plain
# KEY="value" lines, when it is there.
read_site() {
  DATA_BASE_DIR="/var/db"; LOG_BASE_DIR="/var/log"
  CONFIG_SEARCH_DIR=""; CONFIG_OFFER_DIR=""; CONFIG_OFFER_NOTE=""; CONFIG_LOCAL_DIR=""
  _rs_rc=0; site_absent "$SITE_CONF" || _rs_rc=$?
  [ "$_rs_rc" = 0 ] && return 0
  # there but unreadable: an error, never the neutral values -- they would
  # keep this user's state apart from everyone else's
  [ "$_rs_rc" = 2 ] && err 00014 "cannot tell whether '$SITE_CONF' is there -- $_sa_m"
  [ -r "$SITE_CONF" ] || err 00015 "cannot read '$SITE_CONF' -- the site's directories for every tool; its group must include $(id -un)"
  # shellcheck disable=SC1090  # the site file's path is a variable (tests point it elsewhere)
  . "$SITE_CONF" || err 00016 "'$SITE_CONF' failed to load"
}

config_search_paths() {
  [ -z "$CONFIG_SEARCH_DIR" ] || printf '%s\n' "$CONFIG_SEARCH_DIR/my-fda.conf" "$CONFIG_SEARCH_DIR/my-fda"
  printf '%s\n' "$HOME/.my-fda.conf" /etc/my-fda.conf /usr/local/etc/my-fda.conf
}

# The offer names only paths the search reads, most common place first: the
# site's offer directory -- only where the site's search directory is
# searched, which a file there reaches as the note says; never the search
# directory itself, a farm -- then /etc, then ~.
config_offer_paths() {
  if [ -n "$CONFIG_OFFER_DIR" ] && [ -n "$CONFIG_SEARCH_DIR" ]; then printf '%s\n' "$CONFIG_OFFER_DIR/my-fda.conf"; fi
  for _o in /etc/my-fda.conf "$HOME/.my-fda.conf"; do
    config_search_paths | grep -qx "$_o" && printf '%s\n' "$_o"
  done
}

# "no config found": each offered place a paste-ready line, the site's note
# beside its own place.
no_config_offer() {
  echo "!!! no config found -- write one, most common place first:"
  config_offer_paths | while IFS= read -r _o; do
    if [ "$_o" = "$CONFIG_OFFER_DIR/my-fda.conf" ] && [ -n "$CONFIG_OFFER_NOTE" ]; then
      echo "    > $US --create-config > $_o   ($CONFIG_OFFER_NOTE)"
    else
      echo "    > $US --create-config > $_o"
    fi
  done
  echo "    (--help: the full search order)"
}

# One config file over what is already set, and named in CONFIG_FILE.
read_config() { # <FILE>
  [ -r "$1" ] || err 00017 "config '$1' is not readable"
  # shellcheck disable=SC1090  # the config path is chosen at runtime
  . "$1" || err 00018 "config '$1' failed to load"
  CONFIG_FILE="${CONFIG_FILE:+$CONFIG_FILE + }$1"
}

load_config() {
  read_site
  _cf="${MY_FDA_CONFIG:-$CONFIG_ARG}"
  if [ -z "$_cf" ]; then
    while IFS= read -r _p; do
      [ -f "$_p" ] && { _cf="$_p"; break; }
    done <<_EOF
$(config_search_paths)
_EOF
  fi
  if [ -z "$_cf" ]; then
    no_config_offer 1>&2
    exit 1
  fi
  # The defaults first, the file over them: a key an older config does not
  # set keeps its default, so a new key needs no edit on every machine. The
  # defaults still live in one place only, the text --create-config prints.
  eval "$(default_config)" || err 00019 "the built-in defaults failed to load"
  # Found through the site's search directory -- a farm linking into the
  # trees -- the config is read from the trees: the global file, then this
  # machine's, which wins key by key. Elsewhere, or with neither there,
  # the file found.
  CONFIG_FILE=""
  if [ -z "${MY_FDA_CONFIG:-$CONFIG_ARG}" ] && [ -n "$CONFIG_SEARCH_DIR" ] && [ "${_cf%/*}" = "$CONFIG_SEARCH_DIR" ] \
     && { [ -f "$CONFIG_OFFER_DIR/my-fda.conf" ] || [ -f "$CONFIG_LOCAL_DIR/my-fda.conf" ]; }; then
    [ -z "$CONFIG_OFFER_DIR" ] || [ ! -f "$CONFIG_OFFER_DIR/my-fda.conf" ] || read_config "$CONFIG_OFFER_DIR/my-fda.conf"
    [ -z "$CONFIG_LOCAL_DIR" ] || [ ! -f "$CONFIG_LOCAL_DIR/my-fda.conf" ] || read_config "$CONFIG_LOCAL_DIR/my-fda.conf"
  else
    read_config "$_cf"
  fi
  case "$TCC_DB_WRITABLE" in yes|no|"") ;; *) err 00020 "TCC_DB_WRITABLE='$TCC_DB_WRITABLE' in $CONFIG_FILE: yes, no or empty -- $US --install records it" ;; esac
  _miss=""
  for _k in $CONFIG_KEYS; do
    eval "_v=\${$_k:-}"
    [ -n "$_v" ] || _miss="$_miss $_k"
  done
  [ -z "$_miss" ] || err 00021 "config '$CONFIG_FILE' sets these empty:$_miss -- '$US --create-config' shows their defaults"
}

create_config() { # [FILE]
  if [ -z "$1" ]; then default_config; return 0; fi
  [ -e "$1" ] && err 00022 "'$1' exists -- not overwritten"
  default_config > "$1" || err 00023 "cannot write '$1'"
  msg " >>> default config written to $1"
}

############################################################## grants

# A grant's ID: 6 hex characters of its client, the same on every run.
grant_id() { # <type> <client>
  "$c_md5" -q -s "$1 $2" | cut -c 1-6
}

# The app's path, as Spotlight knows it; empty when it knows none.
app_path() { # <bundle id>
  case "$1" in *"'"*) return 0 ;; esac
  "$c_mdfind" "kMDItemCFBundleIdentifier == '$1'" 2>/dev/null | head -n 1
}

# The app's path, as LaunchServices knows it; empty when it knows none.
# It finds what Spotlight does not index: a helper app inside another app
# (Backblaze's bzbmenu, Claude's helper). Neither alone is enough: as root,
# LaunchServices may not know an app in a user's ~/Applications.
ls_path() { # <bundle id>
  case "$1" in ""|*[!A-Za-z0-9._-]*) return 0 ;; esac
  _lp=$("$c_osascript" -e "POSIX path of (path to application id \"$1\")" 2>/dev/null) || return 0
  printf '%s\n' "${_lp%/}"
}

# What is wrong with <PATH> holding Full Disk Access -- a shell, a general
# tool, a script, anything in Homebrew -- or nothing. Each caller adds what to
# do, which differs: list takes a grant away, denied has none to take.
grant_flag() { # <PATH>
  _gf=""
  for _gt in $BREW_TREES; do
    case "$1" in "$_gt"/*) _gf="Homebrew: breaks on upgrade, and its packages' code gets full disk access" ;; esac
  done
  [ -f "$1" ] && [ "$(head -c 2 "$1" 2>/dev/null)" = "#!" ] && _gf="a script: macOS checks its interpreter, not the script"
  for _gt in $GENERAL_TOOLS; do
    # shellcheck disable=SC2254  # the pattern is a glob on purpose
    case "${1##*/}" in $_gt) _gf="a general tool: whatever runs it gets full disk access" ;; esac
  done
  for _gt in $SHELLS; do
    [ "$1" = "$_gt" ] && _gf="a shell: every script it runs gets full disk access"
  done
  printf '%s\n' "$_gf"
}

# One grant per line on stdin: type<TAB>client<TAB>auth<TAB>date.
# Out: id<TAB>type<TAB>client<TAB>state<TAB>note<TAB>date<TAB>app path --
# never an empty field ("-"): a TAB is IFS whitespace, and read would
# collapse two of them into one.
classify() {
  _spot=""
  while IFS="$TAB" read -r _sv _t _c _a _d _db; do
    [ -n "$_c" ] || continue
    case "$_a" in
      2) _s="allowed[2]" ;;
      0) _s="denied[0]" ;;
      *) _s="other[$_a]" ;;
    esac
    _n="-"; _x=""; _idk=$_t
    # Grants my-fda lists but does not take away: their own notes, their
    # own IDs (the same client may also hold a plain grant).
    case "$_sv" in
      "$SERVICE_ES") _n="system extension (Endpoint Security): in the pane, not removed by my-fda"; _idk="es$_t" ;;
      mdm)           _n="profile: not in System Settings -- it goes with the profile"; _idk="mdm" ;;
      "$SERVICE")    ;;
      *)             _idk="${_sv#kTCCService}$_t" ;;   # list --service: its own ID per service
    esac
    if [ "$_sv" != "$SERVICE" ]; then
      :
    elif [ "$_t" = "1" ]; then
      if [ ! -e "$_c" ]; then
        _n="GONE $TO_REMOVE"
      else
        _f=$(grant_flag "$_c")
        # Switched off, such a row grants nothing: macOS wrote it when it
        # refused the program, and writes it again at the next refusal --
        # taking it away only hides which job still runs the program.
        if [ -n "$_f" ] && [ "$_a" = "0" ]; then
          _n="$_f; refused, and macOS writes this row back at each refusal -> find the job running it ($US denied --catch), give that a launcher"
        elif [ -n "$_f" ]; then
          _n="$_f $TO_REMOVE; its job gets a launcher ($US create)"
        fi
      fi
    elif [ "$_t" = "0" ]; then
      # Spotlight off would make every app look gone: ask it about Finder first.
      if [ -z "$_spot" ]; then
        if [ -n "$(app_path com.apple.finder)" ]; then _spot=on; else _spot=off; fi
      fi
      _x=$(app_path "$_c")
      [ -n "$_x" ] || _x=$(ls_path "$_c")
      if [ -n "$_x" ]; then
        _n="app"
      elif [ "$_spot" = "off" ]; then
        _n="app (not checked: Spotlight finds no apps)"
      else
        case "$_c" in
          com.apple.*) _n="app (Apple's own, not found by Spotlight or LaunchServices: kept)" ;;
          *)
            # what remove can do with it: tccutil does not know a gone app,
            # so only sqlite takes it -- where TCC.db cannot be written
            # (TCC_DB_WRITABLE, recorded by --install) it stays, and the pane
            # does not show it either
            case "$TCC_DB_WRITABLE" in
              yes) _n="GONE $TO_REMOVE" ;;
              no)  _n="GONE: stays -- TCC.db cannot be written here (TCC_DB_WRITABLE), and the grant applies to nothing" ;;
              *)   _n="GONE $TO_REMOVE (whether it can: $US --install)" ;;
            esac ;;
        esac
      fi
    else
      _n="unknown client type [$_t]"
    fi
    [ "$_sv" = "mdm" ] && _sv=$SERVICE
    _db=${_db:-system}
    [ "$_db" = "system" ] || _idk="$_idk@$_db"   # a user's db: its own ID
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(grant_id "$_idk" "$_c")" "$_t" "$_c" "$_s" "$_n" "${_d:--}" "${_x:--}" "$_sv" "$_db"
  done
}

# Classified lines on stdin -> the table: the ID and a TAB first, so that
# `cut -f 1` returns it; with list --service, each row's service and whose
# TCC.db holds it (system, or a user's name) after the client; -V adds the
# date and an app's path.
render() {
  awk -F '\t' -v vrb="$VRB" -v svcol="$SERVICE_SEL" '
    { id[NR] = $1; c[NR] = $3; s[NR] = $4; n[NR] = $5; d[NR] = $6; x[NR] = $7
      sv[NR] = $8; sub(/^kTCCService/, "", sv[NR]); db[NR] = ($9 == "" ? "system" : $9)
      if (length($3) > w) w = length($3)
      if (length(sv[NR]) > ws) ws = length(sv[NR])
      if (length(db[NR]) > wd) wd = length(db[NR]) }
    END {
      for (i = 1; i <= NR; i++) {
        l = sprintf("%s\t%-" w "s  ", id[i], c[i])
        if (svcol != "") l = l sprintf("%-" ws "s  %-" wd "s  ", sv[i], db[i])
        l = l sprintf("%-11s  ", s[i])
        if (vrb == "1") l = l sprintf("%-19s  ", d[i])
        l = l n[i]
        if (vrb == "1" && x[i] != "-") l = l "  (" x[i] ")"
        print l
      }
    }'
}

# Classified lines on stdin -> one summary line; the parts must add up. Its
# words are lower case, so `list | grep GONE` never picks it up.
summary() {
  awk -F '\t' '
    { rows++ }
    $5 ~ /^GONE/     { gone++ }
    $5 ~ /^Homebrew/ { brew++ }
    $5 ~ /^a general tool/ { tool++ }
    $5 ~ /^a script/ { script++ }
    $5 ~ /^a shell/  { shell++ }
    $5 ~ /^app/      { app++ }
    $5 ~ /^system extension/ { ext++ }
    $5 ~ /^profile/  { prof++ }
    END {
      other = rows - gone - brew - shell - tool - script - app - ext - prof
      printf "%d grant(s): %d gone, %d in Homebrew, %d shell(s), %d general tool(s), %d script(s), %d app(s), %d system extension(s), %d from profiles, %d other [rows %d]\n",
        rows, gone, brew, shell, tool, script, app, ext, prof, other, rows
    }'
}

# Every Full Disk Access grant, classified, into <FILE> -- or, given a
# <SERVICE>, the grants of the services whose name holds it (any case), or of
# every service (all), as list --service asks.
grants_to() { # <FILE> [<SERVICE>|all]
  [ -x "$c_sqlite3" ] || err 00024 "c_sqlite3='$c_sqlite3' is not executable (config: $CONFIG_FILE)"
  _gw="service in ('$SERVICE', '$SERVICE_ES')"; _gm=1
  case "${2:-}" in
    "") ;;
    all) _gw="1" ;;
    *) _gw="instr(lower(service), lower('$(sql_q "$2")')) > 0"
       # a profile's grants are Full Disk Access: listed only when that is asked for
       _gl=$(printf '%s' "$2" | tr '[:upper:]' '[:lower:]')
       case "$(printf '%s' "$SERVICE" | tr '[:upper:]' '[:lower:]')" in *"$_gl"*) ;; *) _gm=0 ;; esac ;;
  esac
  _gq="select service, client_type, client, auth_value, datetime(last_modified,'unixepoch','localtime'), 'system' from access where $_gw order by client, service;"
  if ! "$c_sqlite3" -readonly -separator "$TAB" "$TCC_DB" "$_gq" > "$WORK/rows" 2> "$WORK/rows.err"; then
    _e=$(cat "$WORK/rows.err")
    open_refused "$_e" && err 00025 "cannot read '$TCC_DB' ($_e) -- the Terminal running this needs Full Disk Access itself"
    err 00026 "sqlite3 failed on '$TCC_DB': $_e"
  fi
  # list --service: each user's own TCC.db too -- App Management and other
  # per-user services are kept there, never in the system one
  if [ -n "${2:-}" ]; then
    for _ud in "$USERS_DIR"/*; do
      _uf="$_ud/Library/Application Support/com.apple.TCC/TCC.db"
      # [ -e ] also answers "no" for a file macOS will not let it look at
      # (TCC refuses at the call, the mode bits still allow it): only
      # ENOENT is "not there", anything else leaves a row's absence unknown
      if [ ! -e "$_uf" ]; then
        _m=$(ls -d -- "$_uf" 2>&1 > /dev/null)
        case "$_m" in *": No such file or directory") continue ;; esac
        err 00027 "cannot tell whether '$_uf' is there (${_m##*: }) -- a row it holds would read as missing; this needs Full Disk Access"
      fi
      _un=${_ud##*/}
      if ! "$c_sqlite3" -readonly -separator "$TAB" "$_uf" "$(printf '%s' "$_gq" | sed "s/'system'/'$(sql_q "$_un")'/")" >> "$WORK/rows" 2> "$WORK/rows.err"; then
        _e=$(cat "$WORK/rows.err")
        open_refused "$_e" && err 00028 "cannot read '$_uf' ($_e) -- the Terminal running this needs Full Disk Access itself"
        err 00029 "sqlite3 failed on '$_uf': $_e"
      fi
    done
  fi
  [ "$_gm" = "0" ] || mdm_rows >> "$WORK/rows"
  classify < "$WORK/rows" > "$1"
}

# Is sqlite's <MESSAGE> macOS refusing to let this process OPEN TCC.db -- no
# Full Disk Access -- rather than a refusal of what it asked?
open_refused() { # <MESSAGE>
  case "$1" in *"authorization denied"*|*"unable to open"*) return 0 ;; esac
  return 1
}

# Full Disk Access granted by a configuration profile (MDM, PPPC): kept in
# MDMOverrides.plist, never shown in System Settings. One row per client
# with a Full Disk Access entry: mdm<TAB>type<TAB>client<TAB>auth<TAB>-,
# auth 2 for Allowed true, 0 for false. Nothing when there is no file.
mdm_rows() {
  [ -e "$MDM_OVERRIDES" ] || return 0
  if ! "$c_plutil" -p "$MDM_OVERRIDES" > "$WORK/mdm.txt" 2> "$WORK/mdm.err"; then
    warn "    > cannot read $MDM_OVERRIDES ($(tr '\n' ' ' < "$WORK/mdm.err")) -- grants from profiles are not listed"
    return 0
  fi
  awk -v svc="$SERVICE" -v tab="$TAB" '
    /^  "/ && / => \{$/ { c = $0; sub(/^  "/, "", c); sub(/" => \{$/, "", c); insvc = 0; next }
    /^    "/          { insvc = (index($0, "\"" svc "\" => {") > 0); next }
    insvc && /"Allowed" => / {
      a = $0; sub(/.*=> /, "", a)
      printf "mdm%s%s%s%s%s%s%s-\n", tab, (substr(c, 1, 1) == "/") ? 1 : 0, tab, c, tab, (a == "1" || a == "true") ? 2 : 0, tab
      insvc = 0
    }' "$WORK/mdm.txt"
}

# Grants my-fda takes away -- not those of a system extension or a profile.
ours() { awk -F '\t' '$5 !~ /^(system extension|profile)/'; }

sql_q() { printf '%s' "$1" | sed "s/'/''/g"; }

# Back TCC.db up before a change: sqlite's own .backup, never cp -- tccd
# holds the file open, and a copy can be torn.
backup_tcc() {
  [ -n "$BACKUP_STAMP" ] || BACKUP_STAMP=$(date -u +%Y%m%dT%H%M%SZ)
  mkdir -p "$BACKUP_DIR" || err 00030 "cannot create BACKUP_DIR '$BACKUP_DIR'"
  chmod 700 "$BACKUP_DIR" || err 00031 "cannot chmod 700 '$BACKUP_DIR'"
  BACKUP_FILE="$BACKUP_DIR/TCC.db.$BACKUP_STAMP"
  [ -e "$BACKUP_FILE" ] && BACKUP_FILE="$BACKUP_FILE.$$"
  run "$c_sqlite3" "$TCC_DB" ".backup '$BACKUP_FILE'" \
    || err 00032 "backup of '$TCC_DB' to '$BACKUP_FILE' failed -- nothing was changed"
  [ -s "$BACKUP_FILE" ] || err 00033 "backup '$BACKUP_FILE' is empty -- nothing was changed"
}

# Can this process write TCC.db? Not everywhere, even as root with Full Disk
# Access (macOS 26 refused it). The probe must WRITE: sqlite opens a file it
# may not write read-only without a word, and `BEGIN IMMEDIATE; ROLLBACK`
# alone still succeeds then -- a DELETE of nothing is refused. The answer,
# or sqlite's refusal, is left in $WORK/probe.
tcc_writable() {
  "$c_sqlite3" "$TCC_DB" "BEGIN IMMEDIATE; DELETE FROM access WHERE 0; ROLLBACK;" > "$WORK/probe" 2>&1
}

# --install: what this machine lets my-fda do, found out once and recorded in
# its config, so that no other run has to try -- today whether TCC.db can be
# written (TCC_DB_WRITABLE, which list reads). The answer is this machine's:
# it goes into the site's local config directory (CONFIG_LOCAL_DIR, from the
# site file), else into the config that was read, and is committed where that
# is a git tree. The test is a real write (tcc_writable): macOS refuses it
# once, here, instead of on every list. Where TCC.db cannot even be opened, the
# write was never tried: an error, nothing recorded.
cmd_install() {
  [ -x "$c_git" ] || err 00034 "c_git='$c_git' is not executable (config: $CONFIG_FILE) -- --install commits what it records"
  if tcc_writable; then _v=yes; _why="allowed"
  else
    _e=$(head -n 1 "$WORK/probe")
    # not opened at all: the write was never tried, so there is no answer
    open_refused "$_e" && err 00035 "cannot open '$TCC_DB' ($_e) -- this needs Full Disk Access itself (a Terminal that has it, or a launcher: $US create) -- nothing recorded"
    _v=no; _why="refused ($_e)"
  fi
  # a site with a search directory shares its configs between machines:
  # without CONFIG_LOCAL_DIR there is no place for this machine's answer
  [ -n "$CONFIG_LOCAL_DIR" ] || [ -z "$CONFIG_SEARCH_DIR" ] \
    || err 00036 "$SITE_CONF names no CONFIG_LOCAL_DIR -- this machine's answer would land in $CONFIG_FILE, which every machine reads"
  if [ -n "$CONFIG_LOCAL_DIR" ]; then _f="$CONFIG_LOCAL_DIR/my-fda.conf"; else _f="${CONFIG_FILE##* + }"; fi
  _was=""
  [ -f "$_f" ] && _was=$(sed -n 's/^TCC_DB_WRITABLE=//p' "$_f" | tr -d "\"'" | tail -n 1)
  if [ "$_was" = "$_v" ]; then
    msg " >>> TCC.db write test: $_why -> TCC_DB_WRITABLE=$_v already recorded in $_f"
    return 0
  fi
  _d="${_f%/*}"
  [ -d "$_d" ] || err 00037 "no directory '$_d' for this machine's config -- CONFIG_LOCAL_DIR in $SITE_CONF"
  if [ -f "$_f" ]; then
    _how="was ${_was:-not set}"
    cp -p "$_f" "$_f.new" || err 00038 "cannot write '$_f.new'"
    awk -v v="$_v" '
      /^TCC_DB_WRITABLE=/ { if (!d) print "TCC_DB_WRITABLE=" v; d = 1; next }
      { print }
      END { if (!d) { print ""; print "# whether TCC.db can be written here: recorded by my-fda --install"; print "TCC_DB_WRITABLE=" v } }' "$_f" > "$_f.new" \
      || err 00039 "cannot write '$_f.new'"
  else
    _how="created"
    printf '%s\n' "# my-fda: this machine's own values, read after the global config" \
      "# whether TCC.db can be written here: recorded by my-fda --install" "TCC_DB_WRITABLE=$_v" > "$_f.new" \
      || err 00040 "cannot write '$_f.new'"
  fi
  mv -f "$_f.new" "$_f" || err 00041 "cannot replace '$_f'"
  _c=""
  if "$c_git" -C "$_d" rev-parse --git-dir > /dev/null 2>&1; then
    if ! { "$c_git" -C "$_d" add -- "${_f##*/}" > "$WORK/git" 2>&1 \
      && "$c_git" -C "$_d" commit -q -m "my-fda --install: TCC_DB_WRITABLE=$_v (the TCC.db write test, $_v)" -- "${_f##*/}" >> "$WORK/git" 2>&1; }; then
      err 00042 "TCC_DB_WRITABLE=$_v written to $_f, but not committed: $(tail -n 1 "$WORK/git")"
    fi
    _c=", committed"
  fi
  msg " >>> TCC.db write test: $_why -> TCC_DB_WRITABLE=$_v recorded in $_f ($_how)$_c"
}

# The grants of <FILE> (classified lines) that are still there, read afresh.
still_there() { # <FILE>
  grants_to "$WORK/after"
  # FILENAME, never NR == FNR: with an empty first file that is true for the
  # second one too -- every line a key, nothing printed
  awk -F '\t' 'FILENAME == ARGV[1] { k[$1] = 1; next } $1 in k' "$WORK/after" "$1"
}

# Take away the grants in <FILE>, each the one way this machine allows: an
# app id through tccutil, macOS's own command -- it knows installed apps
# only; the rest (paths, and apps tccutil does not know, such as a GONE one)
# through sqlite where TCC.db can be written, else by hand in System
# Settings. Then the grants are read again: only that says what is gone.
# Sets TOOK to the tally; an error when anything asked for is still there.
take_away() { # <FILE>
  backup_tcc
  grants_to "$WORK/before"          # to tell, afterwards, what went that was NOT asked for
  VIA_TCC=0; VIA_SQL=0; VIA_HAND=0
  : > "$WORK/rest"
  PHASE="taking grants away -- TCC.db backup: $BACKUP_FILE; '$US list' shows what is gone"
  while IFS= read -r _line; do
    _t=$(printf '%s\n' "$_line" | cut -f 2); _c=$(printf '%s\n' "$_line" | cut -f 3)
    if [ "$_t" = "0" ]; then
      [ "$VRB" = "1" ] && printf ' >>> %s reset SystemPolicyAllFiles %s\n' "$c_tccutil" "$_c"
      if "$c_tccutil" reset SystemPolicyAllFiles "$_c" < /dev/null > "$WORK/tccutil.out" 2>&1; then
        VIA_TCC=$((VIA_TCC + 1)); continue
      fi
      [ "$VRB" = "1" ] && printf '    > %s\n' "$(cat "$WORK/tccutil.out")"
    fi
    printf '%s\n' "$_line" >> "$WORK/rest"
  done < "$1"
  _hand=0
  : > "$WORK/stays"; : > "$WORK/byhand"
  if [ -s "$WORK/rest" ]; then
    if tcc_writable; then
      sqlite_delete "$WORK/rest"
      VIA_SQL=$(wc -l < "$WORK/rest" | tr -d ' ')
    else
      # A GONE app tccutil does not know cannot go at all here: not by
      # sqlite, and not by hand -- the pane does not show it. It applies to
      # nothing, so it stays, said once, and is not an error.
      awk -F '\t' '$2 == "0" && $5 ~ /^GONE/' "$WORK/rest" > "$WORK/stays"
      awk -F '\t' '!($2 == "0" && $5 ~ /^GONE/)' "$WORK/rest" > "$WORK/byhand"
      if [ -s "$WORK/stays" ]; then
        say " >>> these stay: the app is gone, so tccutil does not know it, TCC.db cannot be written, and the pane does not show it -- it applies to nothing:"
        awk -F '\t' '{ printf "      %s   [%s]\n", $3, $1 }' "$WORK/stays"
      fi
      [ -s "$WORK/byhand" ] && { guide_removal "$WORK/byhand"; _hand=1; }
    fi
  fi
  STAYS=$(wc -l < "$WORK/stays" | tr -d ' ')
  still_there "$1" > "$WORK/still"
  # FILENAME, not NR == FNR: no grant STAYS (the usual case) made "still there"
  # read as "remaining 0" -- 2026-10-05: the rsync asked for was counted gone
  awk -F '\t' 'FILENAME == ARGV[1] { k[$1] = 1; next } !($1 in k)' "$WORK/stays" "$WORK/still" > "$WORK/left"
  REMAINING=$(wc -l < "$WORK/left" | tr -d ' ')
  [ "$_hand" = "1" ] && VIA_HAND=$(( $(wc -l < "$WORK/byhand" | tr -d ' ') - REMAINING ))
  TAKEN=$((VIA_TCC + VIA_SQL + VIA_HAND))
  TOOK="[tccutil $VIA_TCC, sqlite $VIA_SQL, by hand $VIA_HAND, stay $STAYS; remaining $REMAINING]"
  # a grant that went although it was not asked for: by hand, the wrong row is
  # one click away (2026-10-05: a helper went, the rsync asked for stayed)
  awk -F '\t' 'FILENAME == ARGV[1] { a[$1] = 1; next } FILENAME == ARGV[2] { k[$1] = 1; next } !($1 in a) && !($1 in k)' \
    "$WORK/after" "$1" "$WORK/before" > "$WORK/other"
  if [ -s "$WORK/other" ]; then
    say " >>> taken away too, though NOT asked for -- add it back in System Settings if it should stay:"
    render < "$WORK/other" | sed 's/^/    /'
  fi
  if [ "$REMAINING" != "0" ]; then
    render < "$WORK/left" | sed 's/^/    /' 1>&2
    err 00043 "$REMAINING grant(s) still there $TOOK -- TCC.db backup: $BACKUP_FILE"
  fi
  [ -s "$WORK/other" ] && err 00044 "$(wc -l < "$WORK/other" | tr -d ' ') grant(s) taken away that were not asked for -- see above; TCC.db backup: $BACKUP_FILE"
  return 0
}

# Open something on the screen. Root's shell is outside the GUI session, and
# macOS refuses to launch an app from there (`open` failed with launchd's
# "Domain does not support specified action", macOS 26, 2026-10-04), so as root
# it runs inside the session of the user at the screen: the owner of
# /dev/console.
# Run a command in the session of the user at the screen -- where the pane,
# Finder and the clipboard are; as root, in its own session otherwise.
as_screen_user() { # <command...>
  if is_root; then
    _cu=$(/bin/ls -ln /dev/console 2>/dev/null | awk '{ print $3 }')
    case "$_cu" in
      ""|0|*[!0-9]*) ;;
      *) run "$c_launchctl" asuser "$_cu" "$@"; return ;;
    esac
  fi
  run "$@"
}
gui_open() { as_screen_user "$c_open" "$@"; }   # <open args...>

# Where TCC.db cannot be written: open the pane, name exactly what to take
# away with "-", and wait for it when someone is at the keyboard.
# Each one by the name the pane shows -- not the client, which it does not:
# a path by its file name, an app by its .app name. One short line each, so
# the rows shown above are not repeated.
guide_removal() { # <FILE>
  _n=$(wc -l < "$1" | tr -d ' ')
  say " >>> TCC.db cannot be written here -- macOS refuses it, even for root [sqlite: $(tr '\n' ' ' < "$WORK/probe")]"
  say "    > take these $_n grant(s) away by hand -- System Settings > Full Disk Access, find the name, select it, then -:"
  pane_names < "$1"
  guide_wait
}

# Classified lines on stdin -> "   > <name in the pane>   [<ID>]".
pane_names() {
  awk -F '\t' '{
    n = ($2 == "1") ? $3 : $7
    if (n == "-") n = $3 " (app gone: probably not in the pane)"
    else sub(/.*\//, "", n)
    printf "      %s   [%s]\n", n, $1
  }'
}

# The rest of the hand removal: open the pane, then wait at the keyboard.
# Is someone at a terminal to press Return? Asked of the terminal itself, not
# of stdin: `my-fda list | ... | my-fda remove go` has its IDs on stdin and
# still a person in front of it (2026-10-27: a step piping the IDs skipped
# the wait, and the grants taken away by hand counted as still there).
# In a subshell: a failed redirection on : (a special builtin) ends dash itself.
have_tty() { ( : < "$TTY" ) 2> /dev/null; }

guide_wait() {
  gui_open "$FDA_PANE_URL" || warn "    > could not open the pane ($FDA_PANE_URL) -- open it by hand"
  if have_tty; then
    PHASE="waiting for grants to be taken away by hand -- TCC.db backup: $BACKUP_FILE; '$US list' shows what is gone"
    printf '    > press Return when they are gone: '
    read -r _x < "$TTY"
  fi
}

# Delete the grants listed in <FILE> with sqlite: ONE transaction, a count
# in the same session of what is left, then restart tccd.
sqlite_delete() { # <FILE>
  _sql="$WORK/delete.sql"
  {
    echo "BEGIN;"
    while IFS="$TAB" read -r _i _t _c _rest; do
      case "$_t" in ""|*[!0-9]*) err 00045 "client type '$_t' of '$_c' is not a number -- nothing was changed" ;; esac
      printf "DELETE FROM access WHERE service='%s' AND client_type=%s AND client='%s';\n" "$SERVICE" "$_t" "$(sql_q "$_c")"
    done < "$1"
    echo "COMMIT;"
    echo "SELECT total_changes();"
    printf "SELECT count(*) FROM access WHERE service='%s' AND (0" "$SERVICE"
    while IFS="$TAB" read -r _i _t _c _rest; do
      printf " OR (client_type=%s AND client='%s')" "$_t" "$(sql_q "$_c")"
    done < "$1"
    echo ");"
  } > "$_sql"
  PHASE="deleting grants -- one transaction: it landed whole or not at all; TCC.db backup: $BACKUP_FILE"
  [ "$VRB" = "1" ] && printf ' >>> %s -bail %s < %s\n' "$c_sqlite3" "$TCC_DB" "$_sql"
  _out=$("$c_sqlite3" -bail "$TCC_DB" < "$_sql" 2>&1) \
    || err 00046 "sqlite3 delete failed: $_out -- the transaction did not land; backup: $BACKUP_FILE"
  DELETED=$(printf '%s\n' "$_out" | sed -n 1p)
  REMAINING=$(printf '%s\n' "$_out" | sed -n 2p)
  [ "$REMAINING" = "0" ] || err 00047 "grants still there after the delete [rows deleted $DELETED, remaining $REMAINING] -- backup: $BACKUP_FILE"
  run "$c_killall" tccd > /dev/null 2>&1 \
    || warn "    > could not restart tccd ($c_killall tccd) -- it may show the old grants until it restarts"
}

# Put <PATH> into the Full Disk Access list SWITCHED OFF: the pane then shows
# it, and one click there grants it -- the click stays the person's. The row
# is the one the pane keeps for a refused program: auth 0, the file's code
# requirement (codesign's designated requirement, compiled by csreq) where
# the schema has a csreq column, TCC.db backed up first and tccd restarted
# after. Fails, and changes nothing, where TCC.db cannot be written.
# An app bundle's id -- macOS records an app's grant under it, not under
# the path; empty for anything that is not an app bundle.
bundle_id() { # <PATH>
  [ -f "$1/Contents/Info.plist" ] || return 0
  "$c_plutil" -extract CFBundleIdentifier raw -o - "$1/Contents/Info.plist" 2>/dev/null
}

list_off() { # <PATH> <client type> <client>
  tcc_writable || return 1
  backup_tcc
  PHASE="listing $1 switched off -- TCC.db backup: $BACKUP_FILE"
  "$c_sqlite3" -readonly "$TCC_DB" "select name from pragma_table_info('access');" > "$WORK/cols" \
    || err 00048 "cannot read the columns of $TCC_DB's access table -- nothing was changed"
  _cols="service, client, client_type, auth_value"
  _vals="'$SERVICE', '$(sql_q "$3")', $2, 0"
  for _cv in "auth_reason:3" "auth_version:1" "flags:0" "last_modified:CAST(strftime('%s','now') AS INTEGER)"; do
    grep -qx "${_cv%%:*}" "$WORK/cols" && { _cols="$_cols, ${_cv%%:*}"; _vals="$_vals, ${_cv#*:}"; }
  done
  if grep -qx csreq "$WORK/cols"; then
    _req=$("$c_codesign" -d -r- "$1" 2>&1 | sed -n 's/^# *designated => //p; s/^designated => //p')
    if [ -n "$_req" ] && "$c_csreq" -r "=$_req" -b "$WORK/csreq.bin" > /dev/null 2>&1; then
      _cols="$_cols, csreq"; _vals="$_vals, readfile('$WORK/csreq.bin')"
    else
      warn "    > no code requirement for $1 (codesign: ${_req:-none}) -- listed without one"
    fi
  fi
  [ "$VRB" = "1" ] && printf ' >>> %s %s "insert into access (%s) ..."\n' "$c_sqlite3" "$TCC_DB" "$_cols"
  "$c_sqlite3" -bail "$TCC_DB" "INSERT INTO access ($_cols) VALUES ($_vals);" > "$WORK/insert.out" 2>&1 \
    || err 00049 "cannot list $1 in TCC.db: $(cat "$WORK/insert.out") -- backup: $BACKUP_FILE"
  run "$c_killall" tccd > /dev/null 2>&1 \
    || warn "    > could not restart tccd ($c_killall tccd) -- the pane may show it only after a restart"
}

cmd_list() {
  [ $# -eq 0 ] || err 00050 "list takes no arguments"
  PHASE="reading the grants -- nothing was changed"
  grants_to "$WORK/all" "$SERVICE_SEL"
  render < "$WORK/all"
  [ "$QUIET" = "1" ] || summary < "$WORK/all"
}

# Can the user at the screen read (r) or execute (x) <PATH>? As its owner,
# through one of their groups, or as anyone else -- the mode bit that
# applies to THEM. Sets SCREEN_USER; nobody at the screen (or root): the
# "others" bit decides.
screen_user_can() { # <r|x> <PATH>
  case "$1" in r) _off=0 ;; x) _off=2 ;; *) err 00051 "screen_user_can: '$1' is neither r nor x" ;; esac
  _su=$(/bin/ls -ln /dev/console 2>/dev/null | awk '{ print $3 }')
  # shellcheck disable=SC2012  # only the MODE, owner and group columns are read, never a name
  set -- "$1" "$(ls -ld "$2" | cut -c1-10)" "$(ls -lnd "$2" | awk '{ print $3 " " $4 }')"
  _want=$1; _mode=$2; _own=${3% *}; _grp=${3#* }
  if case "$_su" in ""|0|*[!0-9]*) true ;; *) false ;; esac; then
    SCREEN_USER="nobody at the screen"; _bit=8
  else
    SCREEN_USER=$(id -un "$_su" 2>/dev/null || echo "uid $_su")
    if [ "$_su" = "$_own" ]; then _bit=2
    elif id -G "$_su" 2>/dev/null | tr ' ' '\n' | grep -qx "$_grp"; then _bit=5
    else _bit=8; fi
  fi
  case "$_want$(printf '%s' "$_mode" | cut -c$((_bit + _off)))" in rr|xx|xs|xt) return 0 ;; esac
  return 1
}

cmd_add() { # <PATH>
  [ $# -eq 1 ] || err 00052 "add takes one path: $US add <PATH>"
  _p=$1
  case "$_p" in /*) ;; *) _p="$(pwd)/$_p" ;; esac
  [ -e "$_p" ] || err 00053 "'$_p' does not exist"
  _r=$(real_path "$_p")
  if [ "$_r" != "$_p" ]; then
    msg "    > $_p is $_r -- macOS records the grant under that path"
    _p=$_r
  fi
  _f=$(grant_flag "$_p")
  [ -n "$_f" ] && warn "    > $_f -- a launcher holds it for the job instead: $US create <TARGET>"
  _add_t=1; _add_c=$_p; _b=$(bundle_id "$_p")
  if [ -n "$_b" ]; then
    _add_t=0; _add_c=$_b
    msg "    > $_p is the app $_b -- macOS records the grant under that id"
  fi
  PHASE="reading the grants -- nothing was changed"
  grants_to "$WORK/every"
  ours < "$WORK/every" > "$WORK/all"
  awk -F '\t' -v t="$_add_t" -v c="$_add_c" '$2 == t && $3 == c' "$WORK/all" > "$WORK/row"
  _listed=0
  if [ -s "$WORK/row" ]; then
    case "$(cut -f 4 "$WORK/row")" in
      "allowed[2]") msg "already granted:"; render < "$WORK/row" | sed 's/^/    /'; return 0 ;;
      *) _listed=1; msg " >>> listed, but not allowed:"; render < "$WORK/row" | sed 's/^/    /' ;;
    esac
  fi
  case "$_p" in "$HELPER_DIR"/my-fda.*)
    err 00054 "'$_p' is named with a dot: macOS takes it for a document, and the pane cannot add it -- $US destroy go ${_p##*/my-fda.}, then $US create (it is named my-fda-<NAME> now)" ;;
  esac
  # System Settings runs as the screen's user and must READ the file to add
  # it -- a file that user cannot read is refused there without a word
  if ! screen_user_can r "$_p"; then
    case "$_p" in
      "$HELPER_DIR"/my-fda-*)
        run chmod 744 "$_p" || err 00055 "cannot make '$_p' readable (chmod 744)"
        msg "    > $_p made readable (744): System Settings, running as you, reads it to add it" ;;
      *) err 00056 "'$_p' is not readable by the screen's user ($SCREEN_USER) -- System Settings runs as that user and cannot add it: chmod a+r '$_p' first" ;;
    esac
  fi
  if [ "$_listed" = "0" ] && list_off "$_p" "$_add_t" "$_add_c"; then
    _listed=1
    msg "    > $_p put into the list, switched OFF [TCC.db backup: $BACKUP_FILE]"
  fi
  gui_open "$FDA_PANE_URL" || err 00057 "could not open the Full Disk Access pane ($FDA_PANE_URL)"
  if [ "$_listed" = "1" ]; then
    say " >>> Full Disk Access is open: switch ${_p##*/} ON there"
  else
    gui_open -R "$_p" || err 00058 "could not show '$_p' in Finder"
    say " >>> Full Disk Access is open, and $_p is selected in Finder (TCC.db cannot be written here):"
    # The pane silently loses a dragged-in program the screen's user cannot
    # execute (macOS 27, 2026-10-26: 744 lost, 755 taken); + takes it.
    if printf '%s' "$_p" | as_screen_user "$c_pbcopy" > /dev/null 2>&1; then
      _plus="+, then Cmd-Shift-G, Cmd-V, Return -- the path is on the clipboard"
    else
      _plus="+, then Cmd-Shift-G, paste the path, Return"
    fi
    if screen_user_can x "$_p"; then
      say "    > drag it into the list -- or $_plus"
    else
      say "    > $_plus"
      say "    > (not by drag: the pane loses a program $SCREEN_USER cannot execute)"
    fi
  fi
  if have_tty; then
    PHASE="waiting for the grant to be switched on"
    printf '    > press Return when it is ON: '
    read -r _x < "$TTY"
    grants_to "$WORK/all"
    awk -F '\t' -v t="$_add_t" -v c="$_add_c" '$2 == t && $3 == c && $4 == "allowed[2]"' "$WORK/all" > "$WORK/row"
    [ -s "$WORK/row" ] || err 00059 "'$_add_c' is not in the list as allowed yet [grants $(wc -l < "$WORK/all" | tr -d ' ')] -- add it with + and switch it on, then $US list"
    msg "granted:"; render < "$WORK/row" | sed 's/^/    /'
  else
    say "--> then check: $US list"
  fi
}

# IDs from the arguments, or one per line on stdin -- the first word of each
# line, so a whole `list` line works too. Every ID must be 6 hex characters.
ids_to() { # <FILE> [ID...]
  _f=$1; shift
  if [ $# -gt 0 ]; then
    printf '%s\n' "$@" > "$_f"
  elif [ -t 0 ]; then
    err 00060 "no IDs: give them as arguments, or pipe them in ($US list | grep ... | cut -f 1 | $US remove)"
  else
    awk 'NF { print $1 }' > "$_f"
  fi
  while IFS= read -r _i; do
    case "$_i" in
      [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]) ;;
      *) err 00061 "'$_i' is not an ID -- IDs are the first column of '$US list' -- nothing was changed" ;;
    esac
  done < "$_f"
}

# The grants named by ID -- or, with --recommended, every grant list marks
# TO_REMOVE: the same set as `list | grep -- '-> remove' | cut -f 1`.
cmd_remove() { # [go] [ID...]
  _go=0; [ "${1:-}" = "go" ] && { _go=1; shift; }
  if [ "$RECOMMENDED" = "1" ]; then
    [ $# -eq 0 ] || err 00062 "remove --recommended takes no IDs -- it takes what '$US list' marks '$TO_REMOVE'"
    PHASE="reading the grants -- nothing was changed"
    grants_to "$WORK/all"
    awk -F '\t' -v m="$TO_REMOVE" 'index($5, m)' "$WORK/all" > "$WORK/sel"
    if [ ! -s "$WORK/sel" ]; then
      msg "no grant is marked '$TO_REMOVE' -- nothing to remove [grants $(wc -l < "$WORK/all" | tr -d ' ')]"
      return 0
    fi
    _again="'$US remove --recommended go'"
  else
    ids_to "$WORK/ids" "$@"
    if [ ! -s "$WORK/ids" ]; then msg "no IDs on stdin -- nothing to remove"; return 0; fi
    PHASE="reading the grants -- nothing was changed"
    grants_to "$WORK/all"
    : > "$WORK/sel"; _bad=""
    while IFS= read -r _i; do
      _m=$(awk -F '\t' -v i="$_i" '$1 == i' "$WORK/all")
      [ -n "$_m" ] || { _bad="$_bad $_i"; continue; }
      [ "$(printf '%s\n' "$_m" | wc -l | tr -d ' ')" = "1" ] || err 00063 "ID $_i matches more than one grant -- nothing was changed; remove those in System Settings"
      grep -qxF "$_m" "$WORK/sel" || printf '%s\n' "$_m" >> "$WORK/sel"
    done < "$WORK/ids"
    [ -z "$_bad" ] || err 00064 "no such grant:$_bad -- nothing was changed ($US list shows the IDs)"
    _again="'$US remove go' with the same IDs"
  fi
  _not=$(awk -F '\t' '$5 ~ /^(system extension|profile)/ { printf " %s", $1 }' "$WORK/sel")
  [ -z "$_not" ] || err 00065 "not taken away by $US:$_not -- a system extension's grant goes in System Settings, a profile's with the profile; nothing was changed"
  _k=$(wc -l < "$WORK/sel" | tr -d ' ')
  render < "$WORK/sel"
  if [ "$_go" = "0" ]; then
    say "--> nothing changed -- $_again takes these $_k grant(s) away"
    return 0
  fi
  take_away "$WORK/sel"
  msg "removed $TAKEN of $_k grant(s) $TOOK -- TCC.db backup: $BACKUP_FILE"
}

# The GONE grants -- the one class safe to take away without looking: nothing
# is left that the grant could apply to. The same delete path as remove.
cmd_cleanup() { # [go]
  _go=0; [ "${1:-}" = "go" ] && { _go=1; shift; }
  [ $# -eq 0 ] || err 00066 "cleanup takes no IDs -- '$US remove' takes some"
  PHASE="reading the grants -- nothing was changed"
  grants_to "$WORK/all"
  awk -F '\t' '$5 ~ /^GONE/' "$WORK/all" > "$WORK/sel"
  _k=$(wc -l < "$WORK/sel" | tr -d ' ')
  if [ "$_k" = "0" ]; then
    msg "no GONE grants -- nothing to clean up [grants $(wc -l < "$WORK/all" | tr -d ' ')]"
    return 0
  fi
  render < "$WORK/sel"
  if [ "$_go" = "0" ]; then
    say "--> nothing changed -- '$US cleanup go' takes these $_k GONE grant(s) away"
    return 0
  fi
  take_away "$WORK/sel"
  msg "cleaned up $TAKEN of $_k GONE grant(s) $TOOK -- TCC.db backup: $BACKUP_FILE"
}

cmd_reset() { # [go]
  _go=0; [ "${1:-}" = "go" ] && { _go=1; shift; }
  [ $# -eq 0 ] || err 00067 "reset takes no IDs -- '$US remove' takes some"
  PHASE="reading the grants -- nothing was changed"
  grants_to "$WORK/every"
  ours < "$WORK/every" > "$WORK/all"
  _k=$(wc -l < "$WORK/all" | tr -d ' ')
  if [ "$_k" = "0" ]; then msg "no grants -- nothing to reset"; return 0; fi
  render < "$WORK/all"
  say " >>> this takes away ALL $_k grant(s) -- the Terminal running this loses its grant too:"
  say "    > give that one back first (System Settings > Full Disk Access), then $US list"
  if [ "$_go" = "0" ]; then
    say "--> nothing changed -- '$US reset go' does it"
    return 0
  fi
  BACKUP_STAMP=$(date -u +%Y%m%dT%H%M%SZ)
  mkdir -p "$BACKUP_DIR" || err 00068 "cannot create BACKUP_DIR '$BACKUP_DIR'"
  _l="$BACKUP_DIR/list.$BACKUP_STAMP.txt"
  VRB=1 render < "$WORK/all" > "$_l" || err 00069 "cannot save the list to '$_l' -- nothing was changed"
  backup_tcc
  # macOS's own bulk command: no app lookup, no writable TCC.db needed.
  PHASE="taking all grants away -- TCC.db backup: $BACKUP_FILE, the list: $_l"
  [ "$VRB" = "1" ] && printf ' >>> %s reset SystemPolicyAllFiles\n' "$c_tccutil"
  "$c_tccutil" reset SystemPolicyAllFiles < /dev/null > "$WORK/tccutil.out" 2>&1; _rc=$?
  [ "$_rc" = "0" ] || err 00070 "tccutil reset SystemPolicyAllFiles failed [rc $_rc]: $(cat "$WORK/tccutil.out") -- backup: $BACKUP_FILE"
  msg "took away all $_k grant(s) [tccutil rc $_rc] -- TCC.db backup: $BACKUP_FILE, the list: $_l"
  msg "    > not checked here: this Terminal lost its grant too -- give it back, then $US list"
  msg " >>> to give back what had been allowed:"
  awk -F '\t' '$4 == "allowed[2]" && $5 !~ /^GONE/' "$WORK/all" > "$WORK/back"
  while IFS="$TAB" read -r _i _t _c _rest; do
    if [ "$_t" = "1" ]; then msg "    > $US add $_c"
    else msg "    > $_c: System Settings > Full Disk Access, +, the app"; fi
  done < "$WORK/back"
}

############################################################## refusals

# tccd logs each check in lines that share its msgID: REQUEST (which tccd
# answers: tccd_uid 0 is the system's, N that user's), AUTHREQ_CTX (the
# service), AUTHREQ_SUBJECT (the client, as a grant names it),
# AUTHREQ_ATTRIBUTION (the binary that touched the file, the process held
# responsible) and AUTHREQ_RESULT (authValue, authReason). A msgID is unique
# only within one tccd process, and the lines of checks in flight
# interleave: they are joined by tccd pid + msgID, never by order.
# A check tccd could not answer has no AUTHREQ_RESULT: tccd logs
# "forwardMessage error" (it could not reach the tccd it forwards to), or
# sandboxd logs "tcc_server_message_request_authorization(<service>)
# failed", and the kernel then refuses -- "System Policy: <process>(<pid>)
# deny(1) <operation> <path>". Its "Sandbox: ..." lines are other sandboxes'
# and stay out.
REFUSAL_PREDICATE='(process == "tccd" AND (eventMessage BEGINSWITH "REQUEST:" OR eventMessage BEGINSWITH "AUTHREQ_CTX" OR eventMessage BEGINSWITH "AUTHREQ_SUBJECT" OR eventMessage BEGINSWITH "AUTHREQ_ATTRIBUTION" OR eventMessage BEGINSWITH "AUTHREQ_RESULT" OR eventMessage CONTAINS "forwardMessage error")) OR (process == "sandboxd" AND eventMessage BEGINSWITH "tcc_server_message_request_authorization(") OR (process == "kernel" AND eventMessage CONTAINS "System Policy: ")'

# What denied reads, in words -- the services and the program -- and the
# program as it is matched: a path as macOS records it, its links followed.
# Sets _scope and _progarg.
refusal_scope() { # [PROGRAM]
  case "$SERVICE_SEL" in
    "")  _scope="services $DENIED_SERVICES" ;;
    all) _scope="every service" ;;
    *)   _scope="services matching '$SERVICE_SEL'" ;;
  esac
  _progarg=${1:-}
  case "$_progarg" in */*) _progarg=$(real_path "$_progarg") ;; esac
  [ -z "$_progarg" ] || _scope="$_scope; $_progarg only"
}

# `log show --style compact` lines on stdin -> one line per check that was
# not allowed, of the services denied selects and the program it was given:
# date time, client, authValue, via, responsible, pid, uid, service,
# authReason, tccd, the responsible's TCC identifier, refused|probe|noanswer,
# and then for a probe the check that followed it (service, authValue,
# authReason, tccd), for a noanswer the operation, the path, why there was
# no answer, and the program tccd was asked about (identifier[pid] or "-"),
# TAB-separated. via and pid are the process that touched the file,
# responsible the one macOS held responsible for it ("-": none, the program
# was started with no parent macOS attributes it to); tccd is "system[0]"
# or a user's, "alice[501]".
# A PROBE: macOS asks Full Disk Access first and, when that is not allowed,
# the narrower protection in its very next request -- the caller's msgID
# is <caller pid>.<sequence>, whichever tccd answers. A Full Disk Access
# answer that is not 2 is a probe when the caller's next sequence number,
# within a second, is for the same accessing pid, another service, and
# allowed: nothing was refused. So such an answer is held until the
# caller's next one.
# `refusals catch` reads `log stream` instead and, at each refusal, prints
# the refused process and its parents -- looked at as the check ends, while
# it may still run, since tccd's line names no parent -- then the files it
# has open, as near as anything comes to the file it was refused (tccd's
# line names none either); it stops after the first one it could still see.
refusals() { # [catch] [PROGRAM]
  _sm="set"; _sp=$DENIED_SERVICES
  case "$SERVICE_SEL" in "") ;; all) _sm="all" ;; *) _sm="part"; _sp=$SERVICE_SEL ;; esac
  awk -v svc="$SERVICE" -v catch="${1:-}" -v prog="${2:-}" -v selmode="$_sm" -v selpat="$_sp" \
      -v ps="$c_ps" -v lsof="$c_lsof" -v idc="$c_id" -v ign="$DENIED_IGNORE" -v vrb="$VRB" '
    BEGIN {
      if (ign != "") {            # DENIED_IGNORE as one regex, lower case
        ni = split(tolower(ign), gi, "|"); ignre = ""
        for (i = 1; i <= ni; i++) {
          r = gi[i]; gsub(/\./, "\\.", r); gsub(/\*/, ".*", r); gsub(/\?/, ".", r)
          ignre = ignre (ignre == "" ? "" : "|") "^" r "$"
        }
      }
      if (selmode == "set") {     # the shell patterns of DENIED_SERVICES as one regex
        ng = split(selpat, g, "|"); setre = ""
        for (i = 1; i <= ng; i++) {
          r = g[i]; gsub(/\./, "\\.", r); gsub(/\*/, ".*", r); gsub(/\?/, ".", r)
          setre = setre (setre == "" ? "" : "|") "^" r "$"
        }
      }
      lsel = tolower(selpat); lprog = tolower(prog); progpath = (index(prog, "/") > 0)
    }
    function key(   p, m) {
      p = $4; sub(/^tccd\[/, "", p); sub(/:.*/, "", p)
      m = $0; sub(/.*msgID=/, "", m); sub(/,.*/, "", m)
      return p ":" m
    }
    function field(name, from,   i) {   # the value of name= in from, up to the next , or }
      i = index(from, name "=")
      if (i == 0) return ""
      from = substr(from, i + length(name) + 1); sub(/[,}].*/, "", from)
      return from
    }
    function block(name,   i, b) {     # the {...} of name= in this line
      i = index($0, name "={")
      if (i == 0) return ""
      b = substr($0, i); sub(/}.*/, "", b)
      return b
    }
    function short(x) { sub(/^kTCCService/, "", x); return x }
    function base(x) { sub(/.*\//, "", x); return tolower(x) }
    function secs(t,   a) { split(t, a, ":"); return a[1] * 3600 + a[2] * 60 + a[3] }
    function tname(x,   cmd, l) {     # the tccd by its uid: system[0], alice[501]
      if (x !~ /^[0-9]+$/) return "?"
      if (x == "0") return "system[0]"
      if (!(x in tn)) {
        l = ""; cmd = idc " -un " x " 2>/dev/null"; cmd | getline l; close(cmd)
        tn[x] = (l == "" ? "uid" : l) "[" x "]"
      }
      return tn[x]
    }
    function ignored(i) {              # a program DENIED_IGNORE names, as program, via or from
      if (ignre == "") return 0
      return (base(CL[i]) ~ ignre || base(VV[i]) ~ ignre || base(RR[i]) ~ ignre)
    }
    function wanted(i) {               # of the services selected, and of the program
      # a refusal whose service is unknown ("") is still a refusal: only
      # --service <part>, which asks for one service, leaves it out
      if (selmode == "set" && SV[i] != "" && SV[i] !~ setre) return 0
      if (selmode == "part" && index(tolower(SV[i]), lsel) == 0) return 0
      if (prog == "") return 1
      if (progpath) return (CL[i] == prog || VV[i] == prog || RR[i] == prog)
      return (base(CL[i]) == lprog || base(VV[i]) == lprog || base(RR[i]) == lprog)
    }
    function tree(p,   cmd, l, n, seen, f, c) {   # p and its parents, up to launchd, into buf; 0 when p is gone
      n = 0
      while (p > 1 && !(p in seen)) {
        seen[p]; l = ""
        cmd = ps " -o pid=,ppid=,user=,command= -p " p
        cmd | getline l; close(cmd)
        if (l == "") break
        # ps pads its columns to the widest pid: one space each, the command as it is
        split(l, f, /[ \t]+/); c = l; sub(/^[ \t]*[0-9]+[ \t]+[0-9]+[ \t]+[^ \t]+[ \t]+/, "", c)
        if (f[1] == "") { f[1] = f[2]; f[2] = f[3]; f[3] = f[4] }
        buf = buf "   > " f[1] " " f[2] " " f[3] " " c "\n"; n++
        p = f[2]
      }
      return n
    }
    function files(p,   cmd, l, f, n) {   # what p has open, into buf: FD, TYPE and NAME of each
      cmd = lsof " -n -P -p " p " 2>/dev/null"
      while ((cmd | getline l) > 0) {
        if (n++ == 0) { buf = buf "   > its open files (lsof, while it ran):\n"; continue }   # the header
        # NAME is the 9th column on; a pipe or a socket has no NODE column
        if (split(l, f, /[ \t]+/) >= 9) sub(/^([^ \t]+[ \t]+){8}/, "", l); else l = f[split(l, f, /[ \t]+/)]
        buf = buf "      " f[4] "  " f[5] "  " l "\n"
      }
      close(cmd)
      if (n == 0) buf = buf "   > its open files: none seen -- it ended first\n"
    }
    function snap(i,   c) {           # catch: the process of check i, while it may still run
      buf = ""; c = 0
      if (PD[i] ~ /^[0-9]+$/) c = tree(PD[i])
      if (c > 0) files(PD[i])
      cap[i] = buf; ct[i] = c
    }
    function emit(i, kind, j,   d1, d2, d3, d4) {
      if (!wanted(i)) return
      ig = ((kind == "refused" || kind == "noanswer") && ignored(i)) ? 1 : 0
      if (catch == "") {
        d1 = d2 = d3 = d4 = "-"
        if (j > 0) { d1 = SV[j]; d2 = AV[j]; d3 = AR[j]; d4 = TU[j] }
        else if (OP[i] != "") { d1 = OP[i]; d2 = PA[i]; d3 = WY[i]; d4 = IDN[i] }
        printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n", T[i], CL[i], AV[i], VV[i], RR[i], PD[i], UU[i],
          SV[i], AR[i], TU[i], IDN[i], kind, d1, d2, d3, d4, ig
        return
      }
      # what --catch waits for: a refusal; with -V, as in a listing, also a
      # kernel refusal with no privacy check
      if (kind == "probe" || (kind == "unpaired" && vrb != "1") || ig) return
      if (kind == "noanswer" || kind == "unpaired")
        printf "%s  %s  %s  %s  tccd %s  %s %s  for %s  pid %s\n", T[i], CL[i], (SV[i] == "" ? "?" : short(SV[i])),
          (kind == "unpaired" ? "other[kernel]" : "no answer[" WY[i] "]"), TU[i], OP[i], PA[i], IDN[i], PD[i]
      else
        printf "%s  %s  %s  refused[%s] reason[%s]  tccd %s  via %s  from %s  uid %s  pid %s\n", T[i], CL[i], short(SV[i]), AV[i], AR[i], TU[i],
          VV[i], (RR[i] == "-" ? "(none: started with no parent macOS attributes it to)" : RR[i]), UU[i], PD[i]
      if (ct[i] > 0) { printf "%s", cap[i]; done = 1; exit }
      print "   > pid " PD[i] " ended before it could be looked at -- waiting for the next refusal"
      fflush()
    }
    function forget(i) {
      delete T[i]; delete D[i]; delete SS[i]; delete SN[i]; delete SQ[i]; delete CL[i]; delete AV[i]; delete AR[i]
      delete VV[i]; delete RR[i]; delete PD[i]; delete UU[i]; delete SV[i]; delete TU[i]; delete IDN[i]; delete cap[i]; delete ct[i]
      delete OP[i]; delete PA[i]; delete WY[i]
    }
    function failed(sv, why, tg, tu,   t) {   # a check tccd could not answer, at the moment it failed
      t = secs($2)
      # two failures for different services within a second: which one a
      # kernel refusal right after belongs to cannot be told
      fa = (fd == $1 && t - ft <= 1 && fsv != sv) ? 1 : 0
      fd = $1; ft = t; fsv = sv; fwhy = why; ftg = tg; ftu = tu
    }
    $4 ~ /^tccd\[/ && index($0, "forwardMessage error: ") {
      w = $0; sub(/.*forwardMessage error: /, "", w); sub(/\. \(service=.*/, "", w)
      p = $4; sub(/^tccd\[/, "", p); sub(/:.*/, "", p)
      failed(field("service", $0), w, field("target_id", $0) "[" field("target_pid", $0) "]", (p in tpu ? tname(tpu[p]) : "?"))
      next
    }
    $4 ~ /^sandboxd\[/ && index($0, "tcc_server_message_request_authorization(") {
      sv = $0; sub(/.*request_authorization\(/, "", sv); sub(/\).*/, "", sv)
      if (fd == $1 && secs($2) - ft <= 1 && fsv == sv) next   # the failure tccd named already, with its reason and target
      w = $0; sub(/.*Code=[0-9]+ "/, "", w); sub(/".*/, "", w)
      failed(sv, w, "-", "?")
      next
    }
    # The kernel refusing: paired with a failure of the second before it --
    # the kernel line names no service, the failure no path -- or, with
    # none, the kernel side of a refusal tccd answered (left out: that
    # answer is the line), or a refusal with no answer seen at all.
    $4 ~ /^kernel\[/ && index($0, "System Policy: ") {
      x = $0; sub(/.*System Policy: /, "", x)
      if (x !~ /^[^(]+\([0-9]+\) deny\(/) next
      pr = x; sub(/\(.*/, "", pr); kp = x; sub(/^[^(]*\(/, "", kp); sub(/\).*/, "", kp)
      x = substr(x, index(x, ") deny(") + 2); sub(/^deny\([0-9]+\) /, "", x)
      op = x; sub(/ .*/, "", op); pa = x; sub(/^[^ ]+ ?/, "", pa)
      dup = 1; if (match($0, /[0-9]+ duplicate reports for System Policy: /)) dup = substr($0, RSTART, RLENGTH) + 0
      t = secs($2)
      kd = "noanswer"
      if (fd == $1 && t - ft >= 0 && t - ft <= 1) { sv = (fa ? "" : fsv); w = fwhy; tg = ftg; tu = ftu }
      else if ((kp in rec) && rec[kp] == $1 && t - rsec[kp] <= 1) next
      # no tccd or sandboxd failure came with it: another macOS protection
      # (contactsd writing under /private/var/db, a system-privilege), not a
      # privacy refusal -- counted, shown with -V
      else { sv = ""; w = "none seen"; tg = "-"; tu = "?"; kd = "unpaired" }
      n++; T[n] = $1 " " substr($2, 1, 8); D[n] = $1; SS[n] = t
      CL[n] = pr; AV[n] = "-"; AR[n] = "-"; VV[n] = pr; RR[n] = "-"; PD[n] = kp; UU[n] = "-"
      SV[n] = sv; TU[n] = tu; IDN[n] = tg; OP[n] = op; PA[n] = pa; WY[n] = w
      if (catch != "" && (kd == "noanswer" || vrb == "1") && wanted(n)) snap(n)
      for (r = 0; r < dup; r++) emit(n, kd, 0)
      forget(n)
      next
    }
    $6 == "REQUEST:"             {
      u[key()] = field("tccd_uid", $0)
      p = $4; sub(/^tccd\[/, "", p); sub(/:.*/, "", p); tpu[p] = field("tccd_uid", $0)   # which tccd a tccd pid is
    }
    $6 == "AUTHREQ_CTX:"         { s[key()] = field("service", $0) }
    $6 == "AUTHREQ_SUBJECT:"     { c[key()] = field("subject", $0) }
    $6 == "AUTHREQ_ATTRIBUTION:" {
      k = key(); b = block("accessing")
      v[k] = field("binary_path", b); pd[k] = field("pid", b); uu[k] = field("euid", b)
      b = block("responsible"); rp[k] = field("responsible_path", b); idn[k] = field("identifier", b)
    }
    $6 == "AUTHREQ_RESULT:"      {
      k = key(); n++
      m = $0; sub(/.*msgID=/, "", m); sub(/[, ].*/, "", m)
      SN[n] = m; sub(/\..*/, "", SN[n]); SQ[n] = m; sub(/^[^.]*\./, "", SQ[n])
      T[n] = $1 " " substr($2, 1, 8); D[n] = $1; SS[n] = secs($2)
      CL[n] = (c[k] == "" ? "?" : c[k]); AV[n] = field("authValue", $0); AR[n] = field("authReason", $0)
      VV[n] = (v[k] == "" ? "-" : v[k]); RR[n] = (rp[k] == "" ? "-" : rp[k])
      PD[n] = (pd[k] == "" ? "-" : pd[k]); UU[n] = (uu[k] == "" ? "-" : uu[k])
      SV[n] = s[k]; TU[n] = tname(u[k]); IDN[n] = (idn[k] == "" ? "-" : idn[k])
      # an answer whose request lines are not in the log (no service named): its
      # tccd and msgID are the handle to look it up by
      if (s[k] == "") OP[n] = "tccd[" k "]"
      delete u[k]; delete s[k]; delete c[k]; delete v[k]; delete pd[k]; delete uu[k]; delete rp[k]; delete idn[k]
      S = SN[n]
      if (S in pend) {                 # the answer held for this caller: a probe, or refused
        p = pend[S]; delete pend[S]
        if (SQ[n] + 0 == SQ[p] + 1 && PD[n] == PD[p] && SV[n] != svc && AV[n] == "2" && D[n] == D[p] && SS[n] - SS[p] <= 1)
          emit(p, "probe", n)
        else emit(p, "refused", 0)
        forget(p)
      }
      if (AV[n] != "2") {
        rec[PD[n]] = D[n]; rsec[PD[n]] = SS[n]   # for the kernel line that follows it
        if (catch != "" && wanted(n)) snap(n)
        if (SV[n] == svc) { pend[S] = n; next }
        emit(n, "refused", 0)
      }
      forget(n)
    }
    END {                              # what was still held: no next answer came
      if (done) exit
      for (S in pend) inv[pend[S]] = 1
      for (i = 1; i <= n; i++) if (i in inv) emit(i, "refused", 0)
    }'
}

# The checks of refusals on stdin, the grants in <FILE> -> one line per
# client, service, answer, tccd and responsible process: the client first,
# the service, the answer raw, the tccd, how often, when last (-V: first),
# the binary that touched the file (-V: its path, and every one), the
# process macOS held responsible (-V: its TCC identifier, path, the user
# and the last pid), what to do. A probe is left out but for -V. An ssh
# login is responsible for what runs in it, and Remote Login passes no Full
# Disk Access on unless the pane says so.
render_refusals() { # <grants FILE>
  cat > "$WORK/refused.in"
  cut -f 2 "$WORK/refused.in" | sort -u | while IFS= read -r _rc; do
    printf '%s\t%s\n' "$_rc" "$(grant_flag "$_rc")"
  done > "$WORK/flags"
  awk -F '\t' -v vrb="$VRB" -v us="$US" -v svc="$SERVICE" -v shells="$SHELLS" '
    function short(x) { sub(/^kTCCService/, "", x); return x }
    # nothing names the job: no responsible process, or only a shell (SHELLS)
    # every script runs in -- com.apple.sh, sh[123], /bin/sh
    function unnamed(r,   s, i, n) {
      if (r == "-" || r == "") return 1
      sub(/\[[0-9]+\]$/, "", r); sub(/^.*\//, "", r); sub(/^com\.apple\./, "", r)
      n = split(shells, s, " ")
      for (i = 1; i <= n; i++) { sub(/^.*\//, "", s[i]); if (r == s[i]) return 1 }
      return 0
    }
    FILENAME == ARGV[1] { g[$3] = $4; gd[$3] = $6; next }
    FILENAME == ARGV[2] { fl[$1] = $2; next }
    ($12 == "probe" || $12 == "unpaired" || ($12 == "refused" && $8 == "") || $17 == "1") && vrb != "1" { next }
    { k = $2 SUBSEP $3 SUBSEP $5 SUBSEP $8 SUBSEP $9 SUBSEP $10 SUBSEP $12 SUBSEP $13 SUBSEP $14 SUBSEP $17
      if (!(k in n)) { o[++rows] = k; first[k] = $1; last[k] = $1; cl[k] = $2; av[k] = $3; rs[k] = $5
                       sv[k] = $8; ar[k] = $9; tu[k] = $10; kind[k] = $12; pn[k] = $13 SUBSEP $14 SUBSEP $15 SUBSEP $16
                       ig[k] = $17 }
      n[k]++; uid[k] = $7; pid[k] = $6; idn[k] = $11
      # held answers come out of order: the dates, local "YYYY-MM-DD HH:MM:SS", compare as strings
      if ($1 < first[k]) first[k] = $1
      if ($1 > last[k]) last[k] = $1
      if (!((k, $4) in seen)) { seen[k, $4]; nv[k]++; via[k] = (via[k] == "" ? $4 : via[k] "," $4) } }
    END {
      for (i = 1; i <= rows; i++) {
        k = o[i]; c = cl[k]; note = ""
        if (kind[k] == "probe") {
          split(pn[k], q, SUBSEP)
          note = "probe: then " short(q[1]) " allowed[" q[2] "] reason[" q[3] "] by tccd " q[4]
        }
        else if (kind[k] == "unpaired") {    # the kernel refused, and no privacy check came with it
          split(pn[k], q, SUBSEP)
          note = q[1] " " q[2] " -> no tccd or sandboxd failure came with it: another macOS protection, not a privacy refusal"
        }
        else if (kind[k] == "noanswer") {    # the kernel refused, tccd gave no answer
          split(pn[k], q, SUBSEP)
          note = q[1] " " q[2] " -> " (q[3] == "none seen" \
            ? "no tccd answer in the log: catch the next one (" us " denied --catch)" \
            : unnamed(q[4]) \
            ? "tccd could not answer, and nothing names the job behind it: find it first (" us " denied --catch)" \
            : q[4] ~ /(^|\/)my-fda-[^\/]*(\[[0-9]+\])?$/ \
            ? "tccd could not answer, and it runs from what is already a my-fda launcher: no grant to add -- act only if what ran it failed" \
            : "tccd could not answer; a launcher with Full Disk Access is answered by the system tccd itself (" us " create)")
        }
        else if (sv[k] == "") {              # tccd answered, and its request is not in the log
          split(pn[k], q, SUBSEP)
          note = "tccd'"'"'s request is not in the log (" q[1] "): " (c == "?" ? "program and service" : "service") " unknown, nothing to act on"
        }
        else if (rs[k] ~ /\/sshd-keygen-wrapper$/)
          note = "run in an ssh login -> System Settings > General > Sharing > Remote Login (i): Allow full disk access for remote users -- or run it through a launcher"
        else if (fl[c] != "" && rs[k] == "-")
          note = fl[c] " -> started with no parent macOS names: find who runs it (" us " denied --catch), give that a launcher (" us " create)"
        else if (fl[c] != "") note = fl[c] " -> give its job a launcher (" us " create)"
        if (note != "") ;
        else if (sv[k] !~ /^kTCCServiceSystemPolicy/)
          note = "not a file protection: System Settings > Privacy & Security > " short(sv[k])
        else if (c ~ /^com\.apple\./ || c ~ /^\/(System|bin|sbin|usr\/bin|usr\/sbin|usr\/libexec|Library\/Apple)\//)
          note = "Apple'"'"'s own, no grant: macOS refuses it routinely -- act only if a job of yours runs through it (via)"
        # an app the user runs (a bundle id, not the program path of a job): the pane grants it
        else if (sv[k] != svc && c !~ /^\//)
          note = "an app: System Settings > Privacy & Security > Files and Folders, " c " -- allow it there, or leave it refused"
        else if (sv[k] != svc) note = "no grant here -> give its job a launcher with Full Disk Access (" us " create)"
        # both dates are local "YYYY-MM-DD HH:MM:SS": they compare as strings
        else if (g[c] == "allowed[2]" && gd[c] > last[k]) note = "granted " gd[c] ", after the last refusal -- nothing to do"
        else if (g[c] == "allowed[2]") note = "granted, still refused: the grant no longer matches the binary -> " us " remove it, then add"
        else if (g[c] == "denied[0]") note = "switched OFF in the pane -> switch it on there, if it should have it"
        else if (c ~ /^\//) note = "no grant -> " us " add " c
        else note = "no grant (an app) -> System Settings > Full Disk Access, +"
        st[i] = (av[k] == "0" ? "denied[0]" : "other[" av[k] "]") " reason[" ar[k] "]"
        if (ig[k] == "1") note = "ignored (DENIED_IGNORE); " note
        ss[i] = (sv[k] == "" ? "?" : short(sv[k])); cnt[i] = n[k] "x"; nt[i] = note
        if (vrb == "1") vs[i] = via[k]
        else { vs[i] = via[k]; sub(/,.*/, "", vs[i]); sub(/.*\//, "", vs[i]); if (nv[k] > 1) vs[i] = vs[i] " (+" nv[k] - 1 ")" }
        fr[i] = rs[k]
        if (vrb == "1") fr[i] = (idn[k] == "-" || rs[k] == "-" ? "" : idn[k] " ") fr[i] " uid " uid[k] " pid " pid[k]
        else sub(/.*\//, "", fr[i])
        if (kind[k] == "unpaired") { st[i] = "other[kernel]"; fr[i] = "-" }
        if (kind[k] == "noanswer") {         # the answer it never got, and whom tccd was asked about
          st[i] = "no answer[" q[3] "]"; fr[i] = q[4]
          if (vrb != "1") sub(/-[0-9a-f]+\[/, "[", fr[i])   # python3-5555...[18476] -> python3[18476]
        }
        if (length(c) > w) w = length(c)
        if (length(ss[i]) > ws) ws = length(ss[i])
        if (length(st[i]) > wa) wa = length(st[i])
        if (length(tu[k]) > wt) wt = length(tu[k])
        if (length(cnt[i]) > wn) wn = length(cnt[i])
        if (length(vs[i]) > wv) wv = length(vs[i])
        if (length(fr[i]) > wf) wf = length(fr[i])
      }
      for (i = 1; i <= rows; i++) {
        k = o[i]
        l = sprintf("%-" w "s  %-" ws "s  %-" wa "s  tccd %-" wt "s  %" wn "s  ", cl[k], ss[i], st[i], tu[k], cnt[i])
        if (vrb == "1") l = l "first " first[k] "  "
        print l sprintf("last %s  via %-" wv "s  from %-" wf "s  %s", last[k], vs[i], fr[i], nt[i])
      }
    }' "$1" "$WORK/flags" "$WORK/refused.in"
}

# denied [PROGRAM] [LAST]: told apart by their shape -- a LAST starts with a
# digit, or is boot. --since <TIME> is the other window: from that local
# time to now, however long ago -- a caller that reads window after window
# asks each from where the last one ended, with no gap and no overlap, which
# a LAST rounded to minutes cannot give. --until <TIME> ends such a window
# at a time the caller took before it asked, so the next window starts there.

# A local time as --since and --until take it: YYYY-MM-DD HH:MM:SS, and one
# that exists -- date turns 2026-02-30 into 2026-03-02 without a word, so a
# time that does not come back as it went in does not exist.
check_time() { # <OPTION> <TIME>
  case "$2" in
    [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]\ [0-9][0-9]:[0-9][0-9]:[0-9][0-9]) ;;
    *) err 00071 "$1 '$2': a local time, YYYY-MM-DD HH:MM:SS (2026-11-12 08:15:00)" ;;
  esac
  _ct=$("$c_date" -j -f '%Y-%m-%d %H:%M:%S' "$2" '+%Y-%m-%d %H:%M:%S' 2>&1)
  [ "$_ct" = "$2" ] || err 00072 "$1 '$2': no such time [$c_date reads it as '$_ct']"
}

cmd_denied() { # [PROGRAM] [LAST]
  _prog=""; _last=""
  for _a in "$@"; do
    case "$_a" in
      boot|[0-9]*) [ -z "$_last" ] || err 00073 "two windows, '$_last' and '$_a' -- usage: $US denied [<PROGRAM>] [<LAST>]"; _last=$_a ;;
      *)           [ -z "$_prog" ] || err 00074 "two programs, '$_prog' and '$_a' -- usage: $US denied [<PROGRAM>] [<LAST>]"; _prog=$_a ;;
    esac
  done
  if [ "$CATCH" = "1" ]; then
    [ -z "$_last" ] && [ -z "$SINCE_ARG" ] && [ -z "$UNTIL_ARG" ] || err 00075 "denied --catch takes no LAST, --since or --until -- it waits for the next refusal"
    catch_refusal "$_prog"; return
  fi
  [ -z "$UNTIL_ARG" ] || [ -n "$SINCE_ARG" ] || err 00076 "--until '$UNTIL_ARG' goes with --since -- the window it ends starts there"
  if [ -n "$SINCE_ARG" ]; then
    [ -z "$_last" ] || err 00077 "two windows, '$_last' and --since '$SINCE_ARG' -- usage: $US denied [<PROGRAM>] [<LAST> | --since <TIME> [--until <TIME>]]"
    check_time --since "$SINCE_ARG"
    set -- --start "$SINCE_ARG"; _of="since $SINCE_ARG"; _in=$_of
    if [ -n "$UNTIL_ARG" ]; then
      check_time --until "$UNTIL_ARG"
      # both are YYYY-MM-DD HH:MM:SS: as strings they compare as times
      [ "$UNTIL_ARG" \< "$SINCE_ARG" ] && err 00078 "--until '$UNTIL_ARG' is before --since '$SINCE_ARG'"
      set -- --start "$SINCE_ARG" --end "$UNTIL_ARG"; _of="from $SINCE_ARG to $UNTIL_ARG"; _in=$_of
    fi
  else
    _last="${_last:-$DENIED_LAST_DEFAULT}"
    case "$_last" in
      boot) ;;
      ""|[!0-9]*|*[!0-9mhd]*|*[mhd]?*) err 00079 "LAST='$_last': a number with m, h or d (30m, 2h, 3d), or boot -- what log show --last takes" ;;
    esac
    set -- --last "$_last"; _of="of the last $_last"; _in="in the last $_last"
  fi
  [ -x "$c_log" ] || err 00080 "c_log='$c_log' is not executable (config: $CONFIG_FILE)"
  refusal_scope "$_prog"
  PHASE="reading the system log -- nothing was changed"
  msg " >>> tccd's checks in the system log $_of ($_scope) -- a long window takes a while"
  run "$c_log" show --style compact "$@" --predicate "$REFUSAL_PREDICATE" > "$WORK/log" 2> "$WORK/log.err" \
    || err 00081 "log show failed: $(cat "$WORK/log.err")"
  # what was read, raw -- tccd's answers, the checks it could not answer
  # (its own forwarding error, or sandboxd's), the kernel's refusals --
  # each part only when not 0; with all 0 the bracket is left out
  _r=$(awk '$6 == "AUTHREQ_RESULT:" { n++ }
    ($4 ~ /^tccd\[/ && index($0, "forwardMessage error: ")) || ($4 ~ /^sandboxd\[/ && index($0, "tcc_server_message_request_authorization(")) { f++ }
    $4 ~ /^kernel\[/ && / System Policy: [^(]+\([0-9]+\) deny\(/ { k++ }
    function part(s, v) { if (v) o = o (o == "" ? "" : "; ") s v }
    END { part("tccd answers read: ", n); part("tccd failures read: ", f); part("kernel refusals read: ", k); if (o != "") printf " [%s]", o }' "$WORK/log")
  refusals "" "$_progarg" < "$WORK/log" > "$WORK/checks"
  # listed: refused, and refused with no answer, unless DENIED_IGNORE names
  # the program; counted, and shown only with -V: probes, kernel refusals
  # with no privacy check, ignored programs, answers whose request (the
  # service) is not in the log -- none of these is anything to act on
  awk -F '\t' '(($12 == "refused" && $8 != "") || $12 == "noanswer") && $17 != "1"' "$WORK/checks" > "$WORK/refused"
  _pb=$(awk -F '\t' '$12 == "probe" { n++ } END { print n+0 }' "$WORK/checks")
  _ot=$(awk -F '\t' '$12 == "unpaired" { n++ } END { print n+0 }' "$WORK/checks")
  _ig=$(awk -F '\t' '$17 == "1" { n++ } END { print n+0 }' "$WORK/checks")
  _un=$(awk -F '\t' '$12 == "refused" && $8 == "" && $17 != "1" { n++ } END { print n+0 }' "$WORK/checks")
  _pr=""
  [ "$_pb" = "0" ] || _pr="; $_pb probe(s) a narrower grant then allowed"
  [ "$_ot" = "0" ] || _pr="$_pr; $_ot kernel refusal(s) with no privacy check"
  [ "$_ig" = "0" ] || _pr="$_pr; $_ig ignored (DENIED_IGNORE)"
  [ "$_un" = "0" ] || _pr="$_pr; $_un answer(s) whose request is not in the log"
  [ -z "$_pr" ] || _pr="$_pr (-V)"
  if [ ! -s "$WORK/refused" ] && { [ "$((_pb + _ot + _ig + _un))" = "0" ] || [ "$VRB" != "1" ]; }; then
    msg "nothing refused $_in ($_scope)$_pr$_r"
    return 0
  fi
  # The grants say what to do; without Full Disk Access (a LaunchDaemon)
  # they cannot be read, and the log alone has to do.
  if ! ( grants_to "$WORK/every" ) 2> "$WORK/grants.err"; then
    : > "$WORK/every"
    msg "    > grants not read ($(head -n 1 "$WORK/grants.err")) -- what to do is from the log alone"
  fi
  ours < "$WORK/every" > "$WORK/all"
  render_refusals "$WORK/all" < "$WORK/checks"
  [ "$QUIET" = "1" ] || awk -F '\t' -v win="$_in" -v scope="$_scope" -v pr="$_pr" -v r="$_r" '
    { rows++; if (!($2 in c)) { c[$2]; progs++ } }
    END { printf "%d refused check(s) from %d program(s) %s (%s)%s%s\n", rows, progs, win, scope, pr, r }' "$WORK/refused"
}

# denied --catch: the next refusals as they happen, each with the refused
# process and its parents -- the job behind a program that macOS names with
# no responsible parent. Ends after the first whose process could still be
# seen, or on Ctrl-C.
catch_refusal() { # [PROGRAM]
  [ -x "$c_log" ] || err 00082 "c_log='$c_log' is not executable (config: $CONFIG_FILE)"
  refusal_scope "${1:-}"
  PHASE="waiting for the next refusal -- nothing was changed"
  msg " >>> waiting for the next refused check ($_scope), then its process, parents and open files (Ctrl-C to stop)"
  "$c_log" stream --style compact --predicate "$REFUSAL_PREDICATE" 2> "$WORK/log.err" | refusals catch "$_progarg" | tee "$WORK/caught"
  [ -s "$WORK/caught" ] || err 00083 "log stream ended with no refusal: $(cat "$WORK/log.err")"
}

############################################################## launchers

# The launcher program. `create` compiles it with the target (and the name,
# for its error lines) passed as -D on the cc command line; the marker
# string is how `status` reads the target back out of the binary.
launcher_c() {
  cat <<'_EOF'
/* my-fda launcher -- built by `my-fda create`, never edited by hand.
 *
 * A Full Disk Access grant sticks to one program's code. Granted to this
 * launcher, it lasts, because the launcher never changes; the target it
 * runs -- and all that runs -- is its child and counts as its.
 *
 * It SPAWNS the target and waits (instead of exec'ing it), so the process
 * launchd started, which holds the grant, lives for the whole run. It
 * passes on all arguments, exits with the target's status, and passes on
 * SIGTERM/SIGINT/SIGHUP. Built with --user, it first becomes that user, so
 * the target runs as the user while the grant stays this launcher's.
 *
 * Everyone may execute it -- the Full Disk Access pane loses a dragged-in
 * program its user cannot -- so it refuses to run unless started as root:
 * its LaunchDaemon. Signed with the hardened runtime, no DYLD_ variable can
 * put code into it before this check.
 */
#include <errno.h>
#include <grp.h>
#include <pwd.h>
#include <signal.h>
#include <spawn.h>
#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#include <sys/wait.h>
#include <unistd.h>

#if !defined(MY_FDA_TARGET) || !defined(MY_FDA_NAME)
#error "build with -DMY_FDA_TARGET='\"/path\"' -DMY_FDA_NAME='\"name\"'"
#endif
#ifndef MY_FDA_RUN_UID
#define MY_FDA_RUN_UID 0
#endif

__attribute__((used)) static const char marker[] = "MY-FDA-TARGET=" MY_FDA_TARGET;

#ifdef MY_FDA_USER
__attribute__((used)) static const char user_marker[] = "MY-FDA-USER=" MY_FDA_USER;
#ifdef MY_FDA_GROUP
__attribute__((used)) static const char group_marker[] = "MY-FDA-GROUP=" MY_FDA_GROUP;
#define MY_FDA_AS MY_FDA_USER ":" MY_FDA_GROUP
#else
#define MY_FDA_AS MY_FDA_USER
#endif

/* Become MY_FDA_USER for good -- groups, group, user, and the variables a
 * login gives -- or say why not; the target never runs as anyone else. */
static int become_user(void) {
    struct passwd *pw = getpwnam(MY_FDA_USER);
    const char *step = "getpwnam";
    gid_t gid = 0;
    int found = pw != NULL;
    if (found) gid = pw->pw_gid;
#ifdef MY_FDA_GROUP
    if (found) {                 /* --group: this primary group, not the user's own */
        struct group *gr = getgrnam(MY_FDA_GROUP);
        step = "getgrnam";
        found = gr != NULL;
        if (found) gid = gr->gr_gid;
    }
#endif
    if (found) {
        step = "initgroups";
        if (initgroups(pw->pw_name, (int)gid) == 0) {
            step = "setgid";
            if (setgid(gid) == 0) {
                step = "setuid";
                if (setuid(pw->pw_uid) == 0) {
                    step = "check";
                    if (setuid(0) != 0 && getuid() == pw->pw_uid && geteuid() == pw->pw_uid
                        && getgid() == gid && getegid() == gid) {
                        setenv("HOME", pw->pw_dir, 1);
                        setenv("USER", pw->pw_name, 1);
                        setenv("LOGNAME", pw->pw_name, 1);
                        setenv("SHELL", pw->pw_shell, 1);
                        return 1;
                    }
                }
            }
        }
    }
    fprintf(stderr, "ERROR 00084 [70]: my-fda-" MY_FDA_NAME ": cannot run as " MY_FDA_AS
            " (%s: %s) -- its LaunchDaemon must start it as root\n", step, errno ? strerror(errno) : "no such user or group");
    return 0;
}
#endif

extern char **environ;
static volatile pid_t child = 0;

static void forward(int sig) { if (child > 0) kill(child, sig); }

int main(int argc, char **argv) {
    pid_t pid;
    int rc, st;

    (void)argc;
    if (getuid() != MY_FDA_RUN_UID) {
        fprintf(stderr, "ERROR 00085 [77]: my-fda-" MY_FDA_NAME ": runs only as root, started by its"
                " LaunchDaemon -- not as uid %d\n", (int)getuid());
        return 77;
    }
    argv[0] = (char *)MY_FDA_TARGET;
    signal(SIGTERM, forward);
    signal(SIGINT, forward);
    signal(SIGHUP, forward);
#ifdef MY_FDA_USER
    if (!become_user()) return 70;
#endif

    rc = posix_spawn(&pid, MY_FDA_TARGET, NULL, NULL, argv, environ);
    if (rc != 0) {
        fprintf(stderr, "ERROR 00086 [70]: my-fda-" MY_FDA_NAME ": cannot start %s: %s\n",
                MY_FDA_TARGET, strerror(rc));
        return 70;
    }
    child = pid;

    while (waitpid(pid, &st, 0) < 0) {
        if (errno != EINTR) {
            fprintf(stderr, "ERROR 00087 [70]: my-fda-" MY_FDA_NAME ": waitpid: %s\n", strerror(errno));
            return 70;
        }
    }
    if (WIFEXITED(st)) return WEXITSTATUS(st);
    return 128 + WTERMSIG(st);
}
_EOF
}

# The target compiled into a launcher; empty when it carries no marker.
marker_of() { # <launcher>
  LC_ALL=C grep -a -o 'MY-FDA-TARGET=[[:print:]]*' "$1" 2>/dev/null | head -n 1 | sed 's/^MY-FDA-TARGET=//'
}

# The user a launcher runs its target as; empty: root.
user_of() { # <launcher>
  LC_ALL=C grep -a -o 'MY-FDA-USER=[[:print:]]*' "$1" 2>/dev/null | head -n 1 | sed 's/^MY-FDA-USER=//'
}
group_of() { # <launcher>
  LC_ALL=C grep -a -o 'MY-FDA-GROUP=[[:print:]]*' "$1" 2>/dev/null | head -n 1 | sed 's/^MY-FDA-GROUP=//'
}

# Where launcher <NAME> lives. No dot in its name: macOS takes what follows a
# dot for an extension, files the launcher as a Document, and the Full Disk
# Access pane then refuses it, dragged in or chosen with + (2026-10-22).
launcher_path() { # <NAME>
  printf '%s/my-fda-%s\n' "$HELPER_DIR" "$1"
}

check_name() { # <NAME>
  case "$1" in
    ""|*[!A-Za-z0-9._-]*) err 00088 "name '$1': letters, digits, '.', '_' and '-' only" ;;
  esac
}

# Every LaunchDaemon's program: program<TAB>label<TAB>plist, into <FILE>.
daemons_to() { # <FILE>
  : > "$1"
  for _pl in "$LAUNCHD_DIR"/*.plist; do
    [ -f "$_pl" ] || continue
    _pg=$("$c_plutil" -extract Program raw -o - "$_pl" 2>/dev/null) \
      || _pg=$("$c_plutil" -extract ProgramArguments.0 raw -o - "$_pl" 2>/dev/null) \
      || continue
    _lb=$("$c_plutil" -extract Label raw -o - "$_pl" 2>/dev/null) || _lb="${_pl##*/}"
    printf '%s\t%s\t%s\n' "$_pg" "$_lb" "$_pl" >> "$1"
  done
}

# The NAME create takes when given none: the target's file name without
# its extension, any other character a launcher's name may not have as '-'.
name_of() { # <TARGET>
  _nm=${1##*/}
  printf '%s\n' "${_nm%.*}" | sed 's/[^A-Za-z0-9_-]/-/g'
}

cmd_create() { # [NAME] <TARGET>
  case $# in
    1) set -- "$(name_of "$1")" "$1"
       msg "    > NAME $1, from the target's file name -- $US create <NAME> <TARGET> chooses another" ;;
    2) ;;
    *) err 00089 "usage: $US create [<NAME>] <TARGET>" ;;
  esac
  check_name "$1"
  case "$1" in *.*) err 00090 "name '$1': no '.' -- my-fda-$1 would look like a document, and the pane cannot add it" ;; esac
  _t=$2
  _l=$(launcher_path "$1")
  case "$_t" in /*) ;; *) err 00091 "target '$_t' must be an absolute path" ;; esac
  case "$_t" in *\"*|*\\*) err 00092 "target '$_t': no '\"' or '\\' in the path" ;; esac
  [ -f "$_t" ] && [ -x "$_t" ] || err 00093 "target '$_t' is not an executable file"
  for _cel in $BREW_CELLARS; do
    case "$_t" in "$_cel"/*)
      err 00094 "target '$_t' is a Homebrew version path: it changes on upgrade -- use its stable path, /opt/homebrew/bin/${_t##*/}" ;;
    esac
  done
  for _sh in $SHELLS; do
    [ "$_t" = "$_sh" ] && err 00095 "target '$_t' is a shell: every script it runs would get full disk access"
  done
  if [ -n "$USER_ARG" ]; then
    case "$USER_ARG" in (*[!A-Za-z0-9._-]*) err 00096 "--user '$USER_ARG': not a user name" ;; esac
    _uid=$(id -u "$USER_ARG" 2>/dev/null) || err 00097 "--user '$USER_ARG': no such user on this machine"
    [ "$_uid" != "0" ] || err 00098 "--user $USER_ARG: that is root -- leave --user out, a launcher runs as root anyway"
  fi
  if [ -n "$GROUP_ARG" ]; then
    [ -n "$USER_ARG" ] || err 00099 "--group goes with --user: it is the primary group the launcher takes when it becomes that user"
    case "$GROUP_ARG" in (*[!A-Za-z0-9._-]*) err 00100 "--group '$GROUP_ARG': not a group name" ;; esac
    "$c_dscl" . -read "/Groups/$GROUP_ARG" PrimaryGroupID > /dev/null 2>&1 \
      || err 00101 "--group '$GROUP_ARG': no such group on this machine"
  fi
  [ -e "$_l" ] && err 00102 "'$_l' exists -- a rebuild loses its grant; to rebuild on purpose: $US destroy go $1, then create"
  if ! { [ -x "$c_cc" ] && "$c_xcode_select" -p > /dev/null 2>&1; }; then
    err 00103 "no compiler: needs the Command Line Tools -- xcode-select --install"
  fi
  if [ ! -d "$HELPER_DIR" ]; then
    if [ "$(id -u)" = "0" ]; then run install -d -m 755 -o root -g wheel "$HELPER_DIR"
    else run install -d -m 755 "$HELPER_DIR"; fi || err 00104 "cannot create '$HELPER_DIR'"
    msg "    > $HELPER_DIR (created: it did not exist -- macOS's place for root's helper programs)"
  fi
  PHASE="building the launcher -- nothing was installed yet"
  launcher_c > "$WORK/launcher.c"
  run "$c_cc" -O2 -Wall "-DMY_FDA_TARGET=\"$_t\"" "-DMY_FDA_NAME=\"$1\"" "-DMY_FDA_RUN_UID=$LAUNCHER_UID" ${USER_ARG:+"-DMY_FDA_USER=\"$USER_ARG\""} ${GROUP_ARG:+"-DMY_FDA_GROUP=\"$GROUP_ARG\""} \
    -o "$WORK/launcher" "$WORK/launcher.c" > "$WORK/cc.log" 2>&1 \
    || err 00105 "cc failed: $(cat "$WORK/cc.log")"
  [ "$(marker_of "$WORK/launcher")" = "$_t" ] \
    || err 00106 "the built launcher does not carry its target marker -- not installed"
  [ "$(user_of "$WORK/launcher")" = "$USER_ARG" ] \
    || err 00107 "the built launcher does not carry its user marker ($USER_ARG) -- not installed"
  [ "$(group_of "$WORK/launcher")" = "$GROUP_ARG" ] \
    || err 00108 "the built launcher does not carry its group marker ($GROUP_ARG) -- not installed"
  # cc only linker-signs, under the temp file's name: the Full Disk Access
  # pane takes such a file with + but loses it when dragged in (macOS 27,
  # 2026-10-26). A program with a real ad-hoc signature under its own name
  # is dragged in like any other program.
  run "$c_codesign" -s - -f -o runtime -i "my-fda-$1" "$WORK/launcher" > "$WORK/sign.log" 2>&1 \
    || err 00109 "codesign failed: $(cat "$WORK/sign.log") -- not installed"
  # 755: System Settings, running as the screen's user, loses a dragged-in
  # program that user cannot execute (2026-10-26); the launcher itself
  # refuses to run as anyone but root, so executing it grants nothing
  if [ "$(id -u)" = "0" ]; then run install -m 755 -o root -g wheel "$WORK/launcher" "$_l"
  else run install -m 755 "$WORK/launcher" "$_l"; fi || err 00110 "cannot install '$_l'"
  msg "created $_l -> $_t${USER_ARG:+, as $USER_ARG${GROUP_ARG:+:$GROUP_ARG}} [marker ok]"
  msg "--> next: $US add $_l -- then point the LaunchDaemon's Program at it${USER_ARG:+ (and no UserName in it)}, and $US test $1"
}

# A launcher by name, or an error that names what exists.
launcher_of() { # <NAME>
  check_name "$1"
  _lo=$(launcher_path "$1")
  # a launcher from before 2026-10-22, named with a dot, still runs its job
  [ -e "$_lo" ] || [ ! -e "$HELPER_DIR/my-fda.$1" ] || _lo="$HELPER_DIR/my-fda.$1"
  [ -e "$_lo" ] || err 00111 "no launcher '$1' ($_lo) -- $US status lists them"
  printf '%s\n' "$_lo"
}

cmd_status() { # [NAME]
  [ $# -le 1 ] || err 00112 "usage: $US status [<NAME>]"
  if [ $# -eq 1 ]; then
    launcher_of "$1" > "$WORK/launchers" || exit 1
  else
    : > "$WORK/launchers"
    for _f in "$HELPER_DIR"/my-fda-* "$HELPER_DIR"/my-fda.*; do
      [ -e "$_f" ] && printf '%s\n' "$_f" >> "$WORK/launchers"
    done
  fi
  if [ ! -s "$WORK/launchers" ]; then
    msg "no launchers in $HELPER_DIR -- $US create <TARGET> makes one"
    return 0
  fi
  PHASE="reading the grants -- nothing was changed"
  grants_to "$WORK/all"
  daemons_to "$WORK/daemons"
  : > "$WORK/status"
  while IFS= read -r _l; do
    _nm=${_l##*/my-fda[.-]}
    _t=$(marker_of "$_l"); _tn=""; _as=$(user_of "$_l"); _ag=$(group_of "$_l")
    if [ -z "$_t" ]; then _t="?"; _tn="no target marker: not built by $US"
    elif [ ! -e "$_t" ]; then _tn="target GONE -> recreate it, or $US destroy $_nm"; fi
    [ -n "$_as" ] && _t="$_t (as $_as${_ag:+:$_ag})"
    case "$_l" in */my-fda.*) _tn="${_tn:+$_tn; }old name (a dot): the pane cannot add it -> rebuild as my-fda-$_nm" ;; esac
    _g=$(awk -F '\t' -v c="$_l" '$2 == "1" && $3 == c { print $1 " " $4 }' "$WORK/all")
    if [ -z "$_g" ]; then _g="none"; _gn="no grant -> $US add $_l"; else _gn=""; fi
    _u=$(awk -F '\t' -v l="$_l" '$1 == l { printf "%s%s", sep, $2; sep = "," }' "$WORK/daemons")
    [ -n "$_u" ] || _u="unused"
    _note="${_tn:-${_gn:--}}"
    [ -n "$_tn" ] && [ -n "$_gn" ] && _note="$_tn; $_gn"
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$_nm" "$_t" "$_g" "$_u" "$_note" "$_l" >> "$WORK/status"
  done < "$WORK/launchers"
  awk -F '\t' -v vrb="$VRB" '
    { for (k = 1; k <= 6; k++) { f[NR, k] = $k; if (length($k) > w[k]) w[k] = length($k) } }
    END {
      for (i = 1; i <= NR; i++) {
        l = sprintf("%-" w[1] "s  %-" w[2] "s  grant %-" w[3] "s  used by %-" w[4] "s  %s",
                    f[i, 1], f[i, 2], f[i, 3], f[i, 4], f[i, 5])
        if (vrb == "1") l = l "  (" f[i, 6] ")"
        print l
      }
    }' "$WORK/status"
}

cmd_test() { # <NAME>
  [ $# -eq 1 ] || err 00113 "usage: $US test <NAME>"
  _l=$(launcher_of "$1") || exit 1
  daemons_to "$WORK/daemons"
  awk -F '\t' -v l="$_l" '$1 == l' "$WORK/daemons" > "$WORK/users"
  _k=$(wc -l < "$WORK/users" | tr -d ' ')
  [ "$_k" != "0" ] || err 00114 "no LaunchDaemon in $LAUNCHD_DIR runs $_l -- set its Program to that path first"
  [ "$_k" = "1" ] || err 00115 "$_k LaunchDaemons run $_l: $(cut -f 2 "$WORK/users" | tr '\n' ' ')-- start the one you mean: launchctl kickstart system/<label>"
  _lb=$(cut -f 2 "$WORK/users"); _pl=$(cut -f 3 "$WORK/users")
  _as=$(user_of "$_l")
  if [ -n "$_as" ] && _un=$("$c_plutil" -extract UserName raw -o - "$_pl" 2>/dev/null); then
    err 00116 "$_pl runs it as $_un, but $_l drops to $_as itself and must start as root -- take UserName out of the plist"
  fi
  PHASE="starting system/$_lb -- if it started, it runs on under launchd"
  if ! run "$c_launchctl" kickstart "system/$_lb" > "$WORK/kick" 2>&1; then
    err 00117 "launchctl kickstart system/$_lb failed: $(cat "$WORK/kick") -- is it loaded? launchctl bootstrap system $_pl"
  fi
  _log=$("$c_plutil" -extract StandardErrorPath raw -o - "$_pl" 2>/dev/null) \
    || _log=$("$c_plutil" -extract StandardOutPath raw -o - "$_pl" 2>/dev/null) \
    || _log="none set in $_pl"
  msg "started system/$_lb through launchd -- it runs under the grant of $_l${_as:+, as $_as}, as it will unattended"
  msg "    > its log: $_log"
  msg "--> when it ends: launchctl print system/$_lb | grep 'last exit code'"
}

cmd_destroy() { # [go] <NAME>
  _go=0; [ "${1:-}" = "go" ] && { _go=1; shift; }
  [ $# -eq 1 ] || err 00118 "usage: $US destroy [go] <NAME>"
  _l=$(launcher_of "$1") || exit 1
  PHASE="reading the grants -- nothing was changed"
  grants_to "$WORK/all"
  daemons_to "$WORK/daemons"
  awk -F '\t' -v c="$_l" '$2 == "1" && $3 == c' "$WORK/all" > "$WORK/sel"
  _u=$(awk -F '\t' -v l="$_l" '$1 == l { printf "%s%s", sep, $2; sep = "," }' "$WORK/daemons")
  say "launcher  $_l -> $(marker_of "$_l")"
  if [ -s "$WORK/sel" ]; then say "grant     $(render < "$WORK/sel")"; else say "grant     none"; fi
  say "used by   ${_u:-unused}"
  [ -n "$_u" ] && say "    > that job fails once the launcher is gone -- point its Program elsewhere first"
  if [ "$_go" = "0" ]; then
    say "--> nothing changed -- '$US destroy go $1' deletes the launcher and its grant"
    return 0
  fi
  [ -s "$WORK/sel" ] && take_away "$WORK/sel"
  PHASE="deleting the launcher -- its grant is already gone"
  run rm -f "$_l" || err 00119 "cannot delete '$_l'"
  if [ -s "$WORK/sel" ]; then
    msg "destroyed $_l, its grant $TOOK -- TCC.db backup: $BACKUP_FILE"
  else
    msg "destroyed $_l [it had no grant]"
  fi
}

# Ctrl-C (or TERM, HUP) ends a run with ONE line saying where it stopped, and
# exit 130; WORK goes either way.
interrupt_traps() {
  trap 'rm -rf "$WORK"' EXIT
  trap 'rm -rf "$WORK"; printf "%s: interrupted (Ctrl-C) while %s\n" "$US" "$PHASE" 1>&2; exit 130' INT TERM HUP
}

