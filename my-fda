# list --service reads every user's TCC.db too: App Management is kept per
# user (horse 2026-11-13: my-fda-my-system-update ON only in me's db, the
# system db with no AppBundles row at all). A column names whose db a row is
# from; plain list stays the system db's Full Disk Access, with no such
# column; a user db that cannot be read is an error, never skipped.
t_list_service_reads_each_users_tcc_db() {
  _udb="$USERS_DIR/me/Library/Application Support/com.apple.TCC"
  mkdir -p -- "$_udb" "$USERS_DIR/do"
  "$c_sqlite3" "$_udb/TCC.db" "create table access (service text, client text, client_type integer, auth_value integer, last_modified integer, indirect_object_identifier text default 'UNUSED', primary key (service, client, client_type, indirect_object_identifier));"
  "$c_sqlite3" "$_udb/TCC.db" "insert into access (service, client, client_type, auth_value, last_modified) values ('kTCCServiceSystemPolicyAppBundles', '$T_DIR/bin/tool', 1, 2, 1790000000);"
  t_grant 1 "$T_DIR/bin/tool"
  _d=$(QUIET=1 cmd_list)
  case "$_d" in *AppBundles*|*" system "*) t_fail "default: '$_d'"; return ;; esac
  _o=$( (SERVICE_SEL=appbundles; QUIET=1; cmd_list) 2>&1)
  case "$_o" in *"/bin/tool "*"SystemPolicyAppBundles  me "*"allowed[2]"*) ;; *) t_fail "user db: '$_o'"; return ;; esac
  _a=$( (SERVICE_SEL=all; QUIET=1; cmd_list) 2>&1)
  case "$_a" in *"SystemPolicyAllFiles    system "*) ;; *) t_fail "all: '$_a'"; return ;; esac
  printf 'not a database\n' > "$_udb/TCC.db"
  _o=$( (SERVICE_SEL=appbundles; QUIET=1; cmd_list) 2>&1); _rc=$?
  case "$_rc|$_o" in 1"|ERROR "*"$_udb/TCC.db"*) t_pass ;; *) t_fail "broken user db: rc $_rc '$_o'" ;; esac
}
# A user's TCC.db that cannot be looked at is not a missing one: ada (macOS
# 27, 2026-11-14) showed App Management ON while every check of me's TCC.db
# answered "not there" -- `[ -e ]` reads "may not look" (EPERM) as absent, and
# a missing row then reads as OFF. A folder on the way that cannot be searched
# must be an error; a home with no Library at all is simply skipped.
t_list_service_tells_a_hidden_user_db_from_a_missing_one() {
  _udb="$USERS_DIR/me/Library/Application Support/com.apple.TCC"
