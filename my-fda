#!/bin/dash
# my-fda -- Full Disk Access for root jobs, kept stable across upgrades.
#
# macOS ties a Full Disk Access grant to a binary's path and contents. A
# Homebrew binary changes both on every upgrade, so its grant silently stops
# applying. my-fda lists the grants and says which are stale, takes them
# away, and builds LAUNCHERS: tiny programs that hold the grant for a root
# job and never change, so the grant lasts.

SCRIPT_VERSION="0.2"
SCRIPT_COMMIT="f8d706a"
SCRIPT_RELEASE=""

US="${0##*/}"
QUIET=0; VRB=0
CONFIG_ARG=""
USER_ARG=""          # create --user: the user the launcher runs its target as
GROUP_ARG=""         # create --group: that user's primary group instead of their own
LAUNCHER_UID=0       # the only uid a launcher runs under: root (the tests set their own)
TAB=$(printf '\t')
SERVICE="kTCCServiceSystemPolicyAllFiles"
# An Endpoint Security system extension's Full Disk Access is kept under this
# service instead -- the pane shows it with the others, my-fda only lists it.
SERVICE_ES="kTCCServiceEndpointSecurityClient"
WORK=""
PHASE="starting -- nothing was changed"

err() { # <code> [text]
  _c="$1"; shift
  printf 'ERROR %s [1]: %s\n' "$_c" "$*" 1>&2
  exit 1
}

msg() { [ "$QUIET" = "1" ] || printf '%s\n' "$*"; }   # standard output; -Q silences it
say() { printf '%s\n' "$*"; }                          # a plan a destructive step depends on: never silenced
warn() { printf '%s\n' "$*" 1>&2; }

# Echo a command under -V, then run it: one source for both.
run() {
  [ "$VRB" = "1" ] && printf ' >>> %s\n' "$*"
  "$@"
}

is_root() { [ "$(id -u)" = "0" ]; }

need_root() {
  is_root && return 0
  printf '%s\n' "needs root -- rerun under sudo:" "    sudo $0 $ARGS_TEXT" 1>&2
  exit 1
}

# The real file behind $0 -- /LINKS/sbin/my-fda is a link or a copy.
self_path() {
  _p="$0"
  while [ -L "$_p" ]; do
    _l=$(readlink "$_p")
    case "$_l" in /*) _p="$_l" ;; *) _p="${_p%/*}/$_l" ;; esac
  done
  printf '%s\n' "$_p"
}
# PATH as macOS records it in a grant: its own links and its directories
# followed -- /LINKS/local/sbin/x is granted as /Users/.../local/sbin/x
real_path() { # <PATH>
  _rp=$1
  while [ -L "$_rp" ]; do
    _rl=$(readlink "$_rp")
    case "$_rl" in /*) _rp="$_rl" ;; *) _rp="${_rp%/*}/$_rl" ;; esac
  done
  _rd=$(cd "${_rp%/*}" 2>/dev/null && pwd -P) || { printf '%s\n' "$1"; return 0; }
  printf '%s\n' "$_rd/${_rp##*/}"
}
self_dir() { _sd=$(self_path); _sd=$(cd "${_sd%/*}" 2>/dev/null && pwd -P) && printf '%s\n' "$_sd"; }

# git is asked only where my-fda OWNS the repository: a copy inside another
# repo (the container that mirrors it) would report THAT repo's tags.
own_git() {
  _og=$(self_dir)
  [ -n "$_og" ] && [ "$(git -c safe.directory='*' -C "$_og" rev-parse --show-toplevel 2>/dev/null)" = "$_og" ]
}

version() {
  _b=$(shasum -a 256 "$(self_path)" | awk '{ print substr($1, 1, 12) }')
  _d=""; _c=""
  if own_git; then
    _d=$(git -c safe.directory='*' -C "$(self_dir)" describe --tags --long 2>/dev/null)
    _c=$(git -c safe.directory='*' -C "$(self_dir)" rev-parse --short HEAD 2>/dev/null)
  fi
  [ -z "$_d" ] && [ -z "$_c" ] && [ -n "$SCRIPT_COMMIT" ] && _d=$SCRIPT_RELEASE
  case "$_d" in
    *-*-g*)
      _t=${_d%-*-g*}
      _n=${_d%-g*}; _n=${_n##*-}
      if [ "$_n" = "0" ]; then
        printf '%s %s (%s: the %s tag, build %s)\n' "$US" "$SCRIPT_VERSION" "$_d" "$_t" "$_b"
      else
        printf '%s %s+%s (%s: %s commit(s) past %s, unreleased, build %s)\n' \
          "$US" "$SCRIPT_VERSION" "$_n" "$_d" "$_n" "$_t" "$_b"
      fi ;;
    *)
      if [ -n "$_c" ]; then
        printf '%s %s (commit %s, no release tag yet, build %s)\n' "$US" "$SCRIPT_VERSION" "$_c" "$_b"
      elif [ -n "$SCRIPT_COMMIT" ]; then
        printf '%s %s (commit %s, build %s)\n' "$US" "$SCRIPT_VERSION" "$SCRIPT_COMMIT" "$_b"
      else
        printf '%s %s (build %s, unstamped)\n' "$US" "$SCRIPT_VERSION" "$_b"
      fi ;;
  esac
}

# Record HEAD and git's describe string in this file, then AMEND the commit
# they belong to. After committing, BEFORE pushing; tag afterwards. The
# stamped sha lags HEAD by one: amending changes it, and that is expected.
stamp_version() {
  _sv_dir=$(self_dir) || err 00001 "--stamp-version: cannot resolve my own directory"
  _sv_self="$_sv_dir/my-fda"
  own_git || err 00002 "--stamp-version: $_sv_dir is not the top of my-fda's own checkout"
  _sv_sha=$(git -C "$_sv_dir" rev-parse --short HEAD 2>/dev/null)
  [ -n "$_sv_sha" ] || err 00003 "--stamp-version: no commit to stamp from"
  if git -C "$_sv_dir" rev-parse -q --verify '@{upstream}' >/dev/null 2>&1 \
     && git -C "$_sv_dir" merge-base --is-ancestor HEAD '@{upstream}' 2>/dev/null; then
    err 00004 "--stamp-version: HEAD $_sv_sha is already pushed -- amending would rewrite published history. Commit, stamp, THEN push"
  fi
  [ -n "$(git -C "$_sv_dir" show --name-only --format= HEAD -- my-fda 2>/dev/null)" ] \
    || err 00005 "--stamp-version: HEAD does not touch my-fda -- commit it first"
  _sv_staged=$(git -C "$_sv_dir" diff --cached --name-only 2>/dev/null)
  [ -z "$_sv_staged" ] || err 00006 "--stamp-version: something is staged -- the amend would fold it in: $_sv_staged"
  git -C "$_sv_dir" diff --quiet -- my-fda 2>/dev/null || err 00007 "--stamp-version: my-fda has uncommitted edits -- commit them first"
  _sv_desc=$(git -c safe.directory='*' -C "$_sv_dir" describe --tags --long 2>/dev/null)
  _sv_tmp=$(mktemp "${TMPDIR:-/tmp}/my-fda.stamp.XXXXXX") || err 00008 "--stamp-version: mktemp failed"
  cp -p "$_sv_self" "$_sv_tmp" 2>/dev/null
  sed -e "s|^SCRIPT_COMMIT=.*|SCRIPT_COMMIT=\"$_sv_sha\"|" \
      -e "s|^SCRIPT_RELEASE=.*|SCRIPT_RELEASE=\"$_sv_desc\"|" "$_sv_self" > "$_sv_tmp" \
    || { rm -f "$_sv_tmp"; err 00009 "--stamp-version: could not rewrite the stamp"; }
  grep -q "^SCRIPT_COMMIT=\"$_sv_sha\"\$" "$_sv_tmp" \
    || { rm -f "$_sv_tmp"; err 00010 "--stamp-version: the rewritten file carries no stamp -- refusing to install it"; }
  mv -f "$_sv_tmp" "$_sv_self" || { rm -f "$_sv_tmp"; err 00011 "--stamp-version: could not install the stamped file"; }
  git -C "$_sv_dir" add -- my-fda || err 00012 "--stamp-version: git add failed"
  git -C "$_sv_dir" commit -q --amend --no-edit || err 00013 "--stamp-version: git amend failed"
  printf 'stamped SCRIPT_COMMIT=%s SCRIPT_RELEASE=%s -- HEAD is now %s\n' \
    "$_sv_sha" "${_sv_desc:-<no tag yet>}" "$(git -C "$_sv_dir" rev-parse --short HEAD)"
  printf '  > the stamped sha lags HEAD by one: amending changes it. Tag AFTER this.\n'
}

usage() {
  cat <<_EOF
usage: $US [-Q] [-V] [--config <FILE>] <COMMAND> [<ARGS>]

Full Disk Access for root jobs, kept stable across Homebrew upgrades.

GRANTS -- the "+" and "-" of System Settings > Full Disk Access
  list          every grant, one line each: an ID, a TAB, the client (a path
                or an app id), allowed[2] / denied[0] with the raw value, and
                what to do with it:
                  GONE -> remove        the path or the app no longer exists
                  a shell, a general tool (GENERAL_TOOLS), a script, or
                  anything in Homebrew (BREW_TREES) -> remove; its job
                                        gets a launcher: whatever runs a
                                        shell or a tool gets full disk
                                        access, macOS checks a script's
                                        interpreter, and Homebrew's files
                                        change on upgrade
                  system extension      an Endpoint Security extension's
                                        grant: in the pane, not removed here
                  profile               given by a configuration profile
                                        (MDMOverrides.plist): not in the pane,
                                        it goes with the profile
                An app id is GONE only when neither Spotlight nor
                LaunchServices knows it (Spotlight misses helpers inside
                other apps); Apple's own app ids are never called GONE.
  denied [<LAST>]
                every program macOS refused Full Disk Access, from the
                system log of the last LAST (30m, 2h, 3d or boot; default
                DENIED_LAST_DEFAULT, 1d), one line each: the program as a
                grant names it, denied[0] with the raw value, how often,
                when last (-V: first), the binary that touched the file
                (via), and what to do
  add <PATH>    "+": puts PATH into the Full Disk Access list switched OFF
                and opens the pane -- macOS grants only on a click, so you
                switch it on there -- then checks that it is on. Where
                TCC.db cannot be written: shows PATH in Finder and puts it
                on the clipboard, for +, Cmd-Shift-G, Cmd-V. An app
                (.app) is granted under its bundle id, as the pane does
  remove [go] [<ID>...]
                "-": shows the grants it would take away; with go, takes them
                away. IDs as arguments, or one per line on stdin (the first
                column of a list line is enough):
                  $US list | grep 'denied\\[0\\]' | cut -f 1 | $US remove go
  cleanup [go]  the GONE grants -- the one class safe to take away without
                looking: shows them; with go, takes them away
  reset [go]    all grants at once: shows them; with go, takes them all away
                -- the Terminal running this loses its grant too -- and says
                what to give back
                Every change first backs up TCC.db (BACKUP_DIR). An app id
                goes through tccutil (installed apps only); the rest through
                sqlite where TCC.db can be written, else the pane opens with
                the names to take away with "-". A GONE app neither can
                take stays, said once: the pane does not show it, and it
                applies to nothing. Then the grants are read again, and
                anything else still there is an error. reset is tccutil's
                own: every grant at once. Extension and profile grants are
                never taken away by my-fda.

LAUNCHERS -- /Library/PrivilegedHelperTools/my-fda-<NAME>, root:wheel 755,
  run only as root
  create [<NAME>] <TARGET> [--user <USER> [--group <GROUP>]]
                build a launcher that runs TARGET (a script, or a Homebrew
                binary by its stable path such as /opt/homebrew/bin/rsync)
                with all its arguments; needs the Command Line Tools (cc).
                NAME: the target's file name without its extension, unless
                given (no '.': the pane cannot add a dotted name).
                Never over an existing one: a rebuild loses its grant.
                --user: TARGET runs as USER -- launchd starts the launcher as
                root (its LaunchDaemon names no UserName) and it drops to
                USER first; without it, TARGET runs as root.
                --group (with --user): GROUP is the primary group instead
                of USER's own -- what a LaunchDaemon's GroupName did; USER's
                other groups stay.
  destroy [go] <NAME>
                shows the launcher, its target, its grant and the daemon(s)
                using it; with go, deletes the launcher and its grant
  status [<NAME>]
                each launcher: its target, its grant, the LaunchDaemon that
                runs it
  test <NAME>   starts that LaunchDaemon through launchd -- the only run that
                proves the grant (a run from a Terminal uses the Terminal's)

Every command needs root, run from a Terminal that has Full Disk Access
itself: the permission database is protected.

OPTIONS
  -V, --verbose         also: each command before it runs, the date (local time) of each
                        grant, an app's path
  -Q, --quiet           nothing but errors -- and the plans that go acts on
  --config <FILE>       use this config, bypassing the search
  --create-config [<FILE>]
                        print the default config, or write it to <FILE>
                        (never over an existing one)
  --run-tests [<FILTER>]
                        run the built-in tests (name substring)
  --stamp-version       record the commit in this file (maintainer)
  --version             version, git describe, build id
  -h, --help            this help

CONFIG (first found wins)
  \$MY_FDA_CONFIG, --config <FILE>, /LINKS/default/my-fda.conf,
  /LINKS/default/my-fda, ~/.my-fda.conf, /etc/my-fda.conf,
  /usr/local/etc/my-fda.conf
  A key the file does not set keeps its default (--create-config).
_EOF
}

default_config() {
  cat <<'_EOF'
# my-fda config -- plain shell, sourced at startup

# The system-wide permission database (Full Disk Access lives here).
TCC_DB="/Library/Application Support/com.apple.TCC/TCC.db"

# Where each change first backs up TCC.db (and reset saves the list).
BACKUP_DIR="/var/lib/mine/$(id -un)/my-fda"

# Where launchers are installed, and where the daemons that run them live.
HELPER_DIR="/Library/PrivilegedHelperTools"
LAUNCHD_DIR="/Library/LaunchDaemons"

# The Full Disk Access pane, for add.
FDA_PANE_URL="x-apple.systempreferences:com.apple.preference.security?Privacy_AllFiles"

# Where Homebrew keeps its versioned binaries: a grant on a path under one
# of these breaks on the next upgrade of that formula.
BREW_CELLARS="/opt/homebrew/Cellar /usr/local/Cellar"

# Shells: a grant on one gives full disk access to every script it runs.
SHELLS="/bin/sh /bin/bash /bin/zsh /bin/dash /bin/ksh /bin/tcsh /bin/csh"

# Homebrew's trees: a grant on anything in them breaks on the next upgrade,
# and gives full disk access to what its packages run. (BREW_CELLARS above
# only keeps create off a version path: /opt/homebrew/bin/x is its target.)
BREW_TREES="/opt/homebrew /usr/local/Cellar /usr/local/Caskroom /usr/local/Homebrew"

# General tools, by file name (shell patterns): whatever runs one gets full
# disk access too -- a job that needs it gets a launcher instead.
GENERAL_TOOLS="curl wget python python[0-9]* perl perl[0-9]* ruby node env osascript php lua tclsh* expect"

# The commands my-fda runs.
c_sqlite3="/usr/bin/sqlite3"
c_md5="/sbin/md5"
c_mdfind="/usr/bin/mdfind"
c_open="/usr/bin/open"
c_pbcopy="/usr/bin/pbcopy"
c_killall="/usr/bin/killall"
c_launchctl="/bin/launchctl"
c_plutil="/usr/bin/plutil"
c_cc="/usr/bin/cc"
c_xcode_select="/usr/bin/xcode-select"
c_tccutil="/usr/bin/tccutil"
c_osascript="/usr/bin/osascript"
c_codesign="/usr/bin/codesign"
c_csreq="/usr/bin/csreq"
c_dscl="/usr/bin/dscl"
c_log="/usr/bin/log"

# How far back denied reads the system log when given no window.
DENIED_LAST_DEFAULT="1d"

# Full Disk Access given by configuration profiles (MDM) -- listed, never
# shown in System Settings.
MDM_OVERRIDES="/Library/Application Support/com.apple.TCC/MDMOverrides.plist"
_EOF
}

CONFIG_KEYS="TCC_DB BACKUP_DIR HELPER_DIR LAUNCHD_DIR FDA_PANE_URL BREW_CELLARS SHELLS BREW_TREES GENERAL_TOOLS
  c_sqlite3 c_md5 c_mdfind c_open c_killall c_launchctl c_plutil c_cc c_xcode_select c_tccutil c_osascript c_codesign c_csreq MDM_OVERRIDES c_log DENIED_LAST_DEFAULT c_pbcopy c_dscl"

config_search_paths() {
  printf '%s\n' "${LINKS:-/LINKS}/default/my-fda.conf" "${LINKS:-/LINKS}/default/my-fda" \
    "$HOME/.my-fda.conf" /etc/my-fda.conf /usr/local/etc/my-fda.conf
}

# The offer names only paths the search reads, most common place first.
config_offer_paths() {
  for _o in /LINKS/global/etc/default/my-fda.conf /etc/my-fda.conf "$HOME/.my-fda.conf"; do
    case "$_o" in
      /LINKS/global/etc/default/my-fda.conf)
        config_search_paths | grep -qx "${LINKS:-/LINKS}/default/my-fda.conf" && printf '%s\n' "$_o" ;;
      *) config_search_paths | grep -qx "$_o" && printf '%s\n' "$_o" ;;
    esac
  done
}

load_config() {
  _cf="${MY_FDA_CONFIG:-$CONFIG_ARG}"
  if [ -z "$_cf" ]; then
    while IFS= read -r _p; do
      [ -f "$_p" ] && { _cf="$_p"; break; }
    done <<_EOF
$(config_search_paths)
_EOF
  fi
  if [ -z "$_cf" ]; then
    {
      echo "!!! no config found -- write one, most common place first:"
      config_offer_paths | while IFS= read -r _o; do echo "    > $US --create-config > $_o"; done
      echo "    (/LINKS/global needs root, and a my-rollout run for the /LINKS/default link; --help: full search order)"
    } 1>&2
    exit 1
  fi
  [ -r "$_cf" ] || err 00014 "config '$_cf' is not readable"
  # The defaults first, the file over them: a key an older config does not
  # set keeps its default, so a new key needs no edit on every machine. The
  # defaults still live in one place only, the text --create-config prints.
  eval "$(default_config)" || err 00015 "the built-in defaults failed to load"
  # shellcheck disable=SC1090  # the config path is chosen at runtime
  . "$_cf" || err 00016 "config '$_cf' failed to load"
  CONFIG_FILE="$_cf"
  _miss=""
  for _k in $CONFIG_KEYS; do
    eval "_v=\${$_k:-}"
    [ -n "$_v" ] || _miss="$_miss $_k"
  done
  [ -z "$_miss" ] || err 00017 "config '$_cf' sets these empty:$_miss -- '$US --create-config' shows their defaults"
}

create_config() { # [FILE]
  if [ -z "$1" ]; then default_config; return 0; fi
  [ -e "$1" ] && err 00018 "'$1' exists -- not overwritten"
  default_config > "$1" || err 00019 "cannot write '$1'"
  msg " >>> default config written to $1"
}

############################################################## grants

# A grant's ID: 6 hex characters of its client, the same on every run.
grant_id() { # <type> <client>
  "$c_md5" -q -s "$1 $2" | cut -c 1-6
}

# The app's path, as Spotlight knows it; empty when it knows none.
app_path() { # <bundle id>
  case "$1" in *"'"*) return 0 ;; esac
  "$c_mdfind" "kMDItemCFBundleIdentifier == '$1'" 2>/dev/null | head -n 1
}

# The app's path, as LaunchServices knows it; empty when it knows none.
# It finds what Spotlight does not index: a helper app inside another app
# (Backblaze's bzbmenu, Claude's helper). Neither alone is enough: as root,
# LaunchServices may not know an app in a user's ~/Applications.
ls_path() { # <bundle id>
  case "$1" in ""|*[!A-Za-z0-9._-]*) return 0 ;; esac
  _lp=$("$c_osascript" -e "POSIX path of (path to application id \"$1\")" 2>/dev/null) || return 0
  printf '%s\n' "${_lp%/}"
}

# What is wrong with <PATH> holding Full Disk Access -- a shell, a general
# tool, a script, anything in Homebrew -- or nothing. Each caller adds what to
# do, which differs: list takes a grant away, denied has none to take.
grant_flag() { # <PATH>
  _gf=""
  for _gt in $BREW_TREES; do
    case "$1" in "$_gt"/*) _gf="Homebrew: breaks on upgrade, and its packages' code gets full disk access" ;; esac
  done
  [ -f "$1" ] && [ "$(head -c 2 "$1" 2>/dev/null)" = "#!" ] && _gf="a script: macOS checks its interpreter, not the script"
  for _gt in $GENERAL_TOOLS; do
    # shellcheck disable=SC2254  # the pattern is a glob on purpose
    case "${1##*/}" in $_gt) _gf="a general tool: whatever runs it gets full disk access" ;; esac
  done
  for _gt in $SHELLS; do
    [ "$1" = "$_gt" ] && _gf="a shell: every script it runs gets full disk access"
  done
  printf '%s\n' "$_gf"
}

# One grant per line on stdin: type<TAB>client<TAB>auth<TAB>date.
# Out: id<TAB>type<TAB>client<TAB>state<TAB>note<TAB>date<TAB>app path --
# never an empty field ("-"): a TAB is IFS whitespace, and read would
# collapse two of them into one.
classify() {
  _spot=""
  while IFS="$TAB" read -r _sv _t _c _a _d; do
    [ -n "$_c" ] || continue
    case "$_a" in
      2) _s="allowed[2]" ;;
      0) _s="denied[0]" ;;
      *) _s="other[$_a]" ;;
    esac
    _n="-"; _x=""; _idk=$_t
    # Grants my-fda lists but does not take away: their own notes, their
    # own IDs (the same client may also hold a plain grant).
    case "$_sv" in
      "$SERVICE_ES") _n="system extension (Endpoint Security): in the pane, not removed by my-fda"; _idk="es$_t" ;;
      mdm)           _n="profile: not in System Settings -- it goes with the profile"; _idk="mdm" ;;
    esac
    if [ "$_sv" != "$SERVICE" ]; then
      :
    elif [ "$_t" = "1" ]; then
      if [ ! -e "$_c" ]; then
        _n="GONE -> remove"
      else
        _f=$(grant_flag "$_c")
        [ -n "$_f" ] && _n="$_f -> remove; its job gets a launcher ($US create)"
      fi
    elif [ "$_t" = "0" ]; then
      # Spotlight off would make every app look gone: ask it about Finder first.
      if [ -z "$_spot" ]; then
        if [ -n "$(app_path com.apple.finder)" ]; then _spot=on; else _spot=off; fi
      fi
      _x=$(app_path "$_c")
      [ -n "$_x" ] || _x=$(ls_path "$_c")
      if [ -n "$_x" ]; then
        _n="app"
      elif [ "$_spot" = "off" ]; then
        _n="app (not checked: Spotlight finds no apps)"
      else
        case "$_c" in
          com.apple.*) _n="app (Apple's own, not found by Spotlight or LaunchServices: kept)" ;;
          *)           _n="GONE -> remove" ;;
        esac
      fi
    else
      _n="unknown client type [$_t]"
    fi
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(grant_id "$_idk" "$_c")" "$_t" "$_c" "$_s" "$_n" "${_d:--}" "${_x:--}"
  done
}

# Classified lines on stdin -> the table: the ID and a TAB first, so that
# `cut -f 1` returns it; -V adds the date and an app's path.
render() {
  awk -F '\t' -v vrb="$VRB" '
    { id[NR] = $1; c[NR] = $3; s[NR] = $4; n[NR] = $5; d[NR] = $6; x[NR] = $7
      if (length($3) > w) w = length($3) }
    END {
      for (i = 1; i <= NR; i++) {
        l = sprintf("%s\t%-" w "s  %-11s  ", id[i], c[i], s[i])
        if (vrb == "1") l = l sprintf("%-19s  ", d[i])
        l = l n[i]
        if (vrb == "1" && x[i] != "-") l = l "  (" x[i] ")"
        print l
      }
    }'
}

# Classified lines on stdin -> one summary line; the parts must add up. Its
# words are lower case, so `list | grep GONE` never picks it up.
summary() {
  awk -F '\t' '
    { rows++ }
    $5 ~ /^GONE/     { gone++ }
    $5 ~ /^Homebrew/ { brew++ }
    $5 ~ /^a general tool/ { tool++ }
    $5 ~ /^a script/ { script++ }
    $5 ~ /^a shell/  { shell++ }
    $5 ~ /^app/      { app++ }
    $5 ~ /^system extension/ { ext++ }
    $5 ~ /^profile/  { prof++ }
    END {
      other = rows - gone - brew - shell - tool - script - app - ext - prof
      printf "%d grant(s): %d gone, %d in Homebrew, %d shell(s), %d general tool(s), %d script(s), %d app(s), %d system extension(s), %d from profiles, %d other [rows %d]\n",
        rows, gone, brew, shell, tool, script, app, ext, prof, other, rows
    }'
}

# Every Full Disk Access grant, classified, into <FILE>.
grants_to() { # <FILE>
  [ -x "$c_sqlite3" ] || err 00020 "c_sqlite3='$c_sqlite3' is not executable (config: $CONFIG_FILE)"
  if ! "$c_sqlite3" -readonly -separator "$TAB" "$TCC_DB" \
       "select service, client_type, client, auth_value, datetime(last_modified,'unixepoch','localtime') from access where service in ('$SERVICE', '$SERVICE_ES') order by client;" \
       > "$WORK/rows" 2> "$WORK/rows.err"; then
    _e=$(cat "$WORK/rows.err")
    case "$_e" in
      *"authorization denied"*|*"unable to open"*)
        err 00021 "cannot read '$TCC_DB' ($_e) -- the Terminal running this needs Full Disk Access itself" ;;
      *) err 00022 "sqlite3 failed on '$TCC_DB': $_e" ;;
    esac
  fi
  mdm_rows >> "$WORK/rows"
  classify < "$WORK/rows" > "$1"
}

# Full Disk Access granted by a configuration profile (MDM, PPPC): kept in
# MDMOverrides.plist, never shown in System Settings. One row per client
# with a Full Disk Access entry: mdm<TAB>type<TAB>client<TAB>auth<TAB>-,
# auth 2 for Allowed true, 0 for false. Nothing when there is no file.
mdm_rows() {
  [ -e "$MDM_OVERRIDES" ] || return 0
  if ! "$c_plutil" -p "$MDM_OVERRIDES" > "$WORK/mdm.txt" 2> "$WORK/mdm.err"; then
    warn "    > cannot read $MDM_OVERRIDES ($(tr '\n' ' ' < "$WORK/mdm.err")) -- grants from profiles are not listed"
    return 0
  fi
  awk -v svc="$SERVICE" -v tab="$TAB" '
    /^  "/ && / => \{$/ { c = $0; sub(/^  "/, "", c); sub(/" => \{$/, "", c); insvc = 0; next }
    /^    "/          { insvc = (index($0, "\"" svc "\" => {") > 0); next }
    insvc && /"Allowed" => / {
      a = $0; sub(/.*=> /, "", a)
      printf "mdm%s%s%s%s%s%s%s-\n", tab, (substr(c, 1, 1) == "/") ? 1 : 0, tab, c, tab, (a == "1" || a == "true") ? 2 : 0, tab
      insvc = 0
    }' "$WORK/mdm.txt"
}

# Grants my-fda takes away -- not those of a system extension or a profile.
ours() { awk -F '\t' '$5 !~ /^(system extension|profile)/'; }

sql_q() { printf '%s' "$1" | sed "s/'/''/g"; }

# Back TCC.db up before a change: sqlite's own .backup, never cp -- tccd
# holds the file open, and a copy can be torn.
backup_tcc() {
  [ -n "$BACKUP_STAMP" ] || BACKUP_STAMP=$(date -u +%Y%m%dT%H%M%SZ)
  mkdir -p "$BACKUP_DIR" || err 00023 "cannot create BACKUP_DIR '$BACKUP_DIR'"
  chmod 700 "$BACKUP_DIR" || err 00024 "cannot chmod 700 '$BACKUP_DIR'"
  BACKUP_FILE="$BACKUP_DIR/TCC.db.$BACKUP_STAMP"
  [ -e "$BACKUP_FILE" ] && BACKUP_FILE="$BACKUP_FILE.$$"
  run "$c_sqlite3" "$TCC_DB" ".backup '$BACKUP_FILE'" \
    || err 00025 "backup of '$TCC_DB' to '$BACKUP_FILE' failed -- nothing was changed"
  [ -s "$BACKUP_FILE" ] || err 00026 "backup '$BACKUP_FILE' is empty -- nothing was changed"
}

# Can this process write TCC.db? Not everywhere, even as root with Full Disk
# Access (macado refused it). The probe must WRITE: sqlite opens a file it
# may not write read-only without a word, and `BEGIN IMMEDIATE; ROLLBACK`
# alone still succeeds then -- a DELETE of nothing is refused. The answer,
# or sqlite's refusal, is left in $WORK/probe.
tcc_writable() {
  "$c_sqlite3" "$TCC_DB" "BEGIN IMMEDIATE; DELETE FROM access WHERE 0; ROLLBACK;" > "$WORK/probe" 2>&1
}

# The grants of <FILE> (classified lines) that are still there, read afresh.
still_there() { # <FILE>
  grants_to "$WORK/after"
  # FILENAME, never NR == FNR: with an empty first file that is true for the
  # second one too -- every line a key, nothing printed
  awk -F '\t' 'FILENAME == ARGV[1] { k[$1] = 1; next } $1 in k' "$WORK/after" "$1"
}

# Take away the grants in <FILE>, each the one way this machine allows: an
# app id through tccutil, macOS's own command -- it knows installed apps
# only; the rest (paths, and apps tccutil does not know, such as a GONE one)
# through sqlite where TCC.db can be written, else by hand in System
# Settings. Then the grants are read again: only that says what is gone.
# Sets TOOK to the tally; an error when anything asked for is still there.
take_away() { # <FILE>
  backup_tcc
  grants_to "$WORK/before"          # to tell, afterwards, what went that was NOT asked for
  VIA_TCC=0; VIA_SQL=0; VIA_HAND=0
  : > "$WORK/rest"
  PHASE="taking grants away -- TCC.db backup: $BACKUP_FILE; '$US list' shows what is gone"
  while IFS= read -r _line; do
    _t=$(printf '%s\n' "$_line" | cut -f 2); _c=$(printf '%s\n' "$_line" | cut -f 3)
    if [ "$_t" = "0" ]; then
      [ "$VRB" = "1" ] && printf ' >>> %s reset SystemPolicyAllFiles %s\n' "$c_tccutil" "$_c"
      if "$c_tccutil" reset SystemPolicyAllFiles "$_c" < /dev/null > "$WORK/tccutil.out" 2>&1; then
        VIA_TCC=$((VIA_TCC + 1)); continue
      fi
      [ "$VRB" = "1" ] && printf '    > %s\n' "$(cat "$WORK/tccutil.out")"
    fi
    printf '%s\n' "$_line" >> "$WORK/rest"
  done < "$1"
  _hand=0
  : > "$WORK/stays"; : > "$WORK/byhand"
  if [ -s "$WORK/rest" ]; then
    if tcc_writable; then
      sqlite_delete "$WORK/rest"
      VIA_SQL=$(wc -l < "$WORK/rest" | tr -d ' ')
    else
      # A GONE app tccutil does not know cannot go at all here: not by
      # sqlite, and not by hand -- the pane does not show it. It applies to
      # nothing, so it stays, said once, and is not an error.
      awk -F '\t' '$2 == "0" && $5 ~ /^GONE/' "$WORK/rest" > "$WORK/stays"
      awk -F '\t' '!($2 == "0" && $5 ~ /^GONE/)' "$WORK/rest" > "$WORK/byhand"
      if [ -s "$WORK/stays" ]; then
        say " >>> these stay: the app is gone, so tccutil does not know it, TCC.db cannot be written, and the pane does not show it -- it applies to nothing:"
        awk -F '\t' '{ printf "      %s   [%s]\n", $3, $1 }' "$WORK/stays"
      fi
      [ -s "$WORK/byhand" ] && { guide_removal "$WORK/byhand"; _hand=1; }
    fi
  fi
  STAYS=$(wc -l < "$WORK/stays" | tr -d ' ')
  still_there "$1" > "$WORK/still"
  # FILENAME, not NR == FNR: no grant STAYS (the usual case) made "still there"
  # read as "remaining 0" -- ada, 2026-10-05: the rsync asked for was counted gone
  awk -F '\t' 'FILENAME == ARGV[1] { k[$1] = 1; next } !($1 in k)' "$WORK/stays" "$WORK/still" > "$WORK/left"
  REMAINING=$(wc -l < "$WORK/left" | tr -d ' ')
  [ "$_hand" = "1" ] && VIA_HAND=$(( $(wc -l < "$WORK/byhand" | tr -d ' ') - REMAINING ))
  TAKEN=$((VIA_TCC + VIA_SQL + VIA_HAND))
  TOOK="[tccutil $VIA_TCC, sqlite $VIA_SQL, by hand $VIA_HAND, stay $STAYS; remaining $REMAINING]"
  # a grant that went although it was not asked for: by hand, the wrong row is
  # one click away (ada, 2026-10-05: My-dl-helper went, the rsync asked for stayed)
  awk -F '\t' 'FILENAME == ARGV[1] { a[$1] = 1; next } FILENAME == ARGV[2] { k[$1] = 1; next } !($1 in a) && !($1 in k)' \
    "$WORK/after" "$1" "$WORK/before" > "$WORK/other"
  if [ -s "$WORK/other" ]; then
    say " >>> taken away too, though NOT asked for -- add it back in System Settings if it should stay:"
    render < "$WORK/other" | sed 's/^/    /'
  fi
  if [ "$REMAINING" != "0" ]; then
    render < "$WORK/left" | sed 's/^/    /' 1>&2
    err 00027 "$REMAINING grant(s) still there $TOOK -- TCC.db backup: $BACKUP_FILE"
  fi
  [ -s "$WORK/other" ] && err 00028 "$(wc -l < "$WORK/other" | tr -d ' ') grant(s) taken away that were not asked for -- see above; TCC.db backup: $BACKUP_FILE"
  return 0
}

# Open something on the screen. Root's shell is outside the GUI session, and
# macOS refuses to launch an app from there (`open` failed with launchd's
# "Domain does not support specified action", macado 2026-10-04), so as root
# it runs inside the session of the user at the screen: the owner of
# /dev/console.
# Run a command in the session of the user at the screen -- where the pane,
# Finder and the clipboard are; as root, in its own session otherwise.
as_screen_user() { # <command...>
  if is_root; then
    _cu=$(/bin/ls -ln /dev/console 2>/dev/null | awk '{ print $3 }')
    case "$_cu" in
      ""|0|*[!0-9]*) ;;
      *) run "$c_launchctl" asuser "$_cu" "$@"; return ;;
    esac
  fi
  run "$@"
}
gui_open() { as_screen_user "$c_open" "$@"; }   # <open args...>

# Where TCC.db cannot be written: open the pane, name exactly what to take
# away with "-", and wait for it when someone is at the keyboard.
# Each one by the name the pane shows -- not the client, which it does not:
# a path by its file name, an app by its .app name. One short line each, so
# the rows shown above are not repeated.
guide_removal() { # <FILE>
  _n=$(wc -l < "$1" | tr -d ' ')
  say " >>> TCC.db cannot be written here -- macOS refuses it, even for root [sqlite: $(tr '\n' ' ' < "$WORK/probe")]"
  say "    > take these $_n grant(s) away by hand -- System Settings > Full Disk Access, find the name, select it, then -:"
  pane_names < "$1"
  guide_wait
}

# Classified lines on stdin -> "   > <name in the pane>   [<ID>]".
pane_names() {
  awk -F '\t' '{
    n = ($2 == "1") ? $3 : $7
    if (n == "-") n = $3 " (app gone: probably not in the pane)"
    else sub(/.*\//, "", n)
    printf "      %s   [%s]\n", n, $1
  }'
}

# The rest of the hand removal: open the pane, then wait at the keyboard.
guide_wait() {
  gui_open "$FDA_PANE_URL" || warn "    > could not open the pane ($FDA_PANE_URL) -- open it by hand"
  if [ -t 0 ] && [ -r /dev/tty ]; then
    PHASE="waiting for grants to be taken away by hand -- TCC.db backup: $BACKUP_FILE; '$US list' shows what is gone"
    printf '    > press Return when they are gone: '
    read -r _x < /dev/tty
  fi
}

# Delete the grants listed in <FILE> with sqlite: ONE transaction, a count
# in the same session of what is left, then restart tccd.
sqlite_delete() { # <FILE>
  _sql="$WORK/delete.sql"
  {
    echo "BEGIN;"
    while IFS="$TAB" read -r _i _t _c _rest; do
      case "$_t" in ""|*[!0-9]*) err 00029 "client type '$_t' of '$_c' is not a number -- nothing was changed" ;; esac
      printf "DELETE FROM access WHERE service='%s' AND client_type=%s AND client='%s';\n" "$SERVICE" "$_t" "$(sql_q "$_c")"
    done < "$1"
    echo "COMMIT;"
    echo "SELECT total_changes();"
    printf "SELECT count(*) FROM access WHERE service='%s' AND (0" "$SERVICE"
    while IFS="$TAB" read -r _i _t _c _rest; do
      printf " OR (client_type=%s AND client='%s')" "$_t" "$(sql_q "$_c")"
    done < "$1"
    echo ");"
  } > "$_sql"
  PHASE="deleting grants -- one transaction: it landed whole or not at all; TCC.db backup: $BACKUP_FILE"
  [ "$VRB" = "1" ] && printf ' >>> %s -bail %s < %s\n' "$c_sqlite3" "$TCC_DB" "$_sql"
  _out=$("$c_sqlite3" -bail "$TCC_DB" < "$_sql" 2>&1) \
    || err 00030 "sqlite3 delete failed: $_out -- the transaction did not land; backup: $BACKUP_FILE"
  DELETED=$(printf '%s\n' "$_out" | sed -n 1p)
  REMAINING=$(printf '%s\n' "$_out" | sed -n 2p)
  [ "$REMAINING" = "0" ] || err 00031 "grants still there after the delete [rows deleted $DELETED, remaining $REMAINING] -- backup: $BACKUP_FILE"
  run "$c_killall" tccd > /dev/null 2>&1 \
    || warn "    > could not restart tccd ($c_killall tccd) -- it may show the old grants until it restarts"
}

# Put <PATH> into the Full Disk Access list SWITCHED OFF: the pane then shows
# it, and one click there grants it -- the click stays the person's. The row
# is the one the pane keeps for a refused program: auth 0, the file's code
# requirement (codesign's designated requirement, compiled by csreq) where
# the schema has a csreq column, TCC.db backed up first and tccd restarted
# after. Fails, and changes nothing, where TCC.db cannot be written.
# An app bundle's id -- macOS records an app's grant under it, not under
# the path; empty for anything that is not an app bundle.
bundle_id() { # <PATH>
  [ -f "$1/Contents/Info.plist" ] || return 0
  "$c_plutil" -extract CFBundleIdentifier raw -o - "$1/Contents/Info.plist" 2>/dev/null
}

list_off() { # <PATH> <client type> <client>
  tcc_writable || return 1
  backup_tcc
  PHASE="listing $1 switched off -- TCC.db backup: $BACKUP_FILE"
  "$c_sqlite3" -readonly "$TCC_DB" "select name from pragma_table_info('access');" > "$WORK/cols" \
    || err 00032 "cannot read the columns of $TCC_DB's access table -- nothing was changed"
  _cols="service, client, client_type, auth_value"
  _vals="'$SERVICE', '$(sql_q "$3")', $2, 0"
  for _cv in "auth_reason:3" "auth_version:1" "flags:0" "last_modified:CAST(strftime('%s','now') AS INTEGER)"; do
    grep -qx "${_cv%%:*}" "$WORK/cols" && { _cols="$_cols, ${_cv%%:*}"; _vals="$_vals, ${_cv#*:}"; }
  done
  if grep -qx csreq "$WORK/cols"; then
    _req=$("$c_codesign" -d -r- "$1" 2>&1 | sed -n 's/^# *designated => //p; s/^designated => //p')
    if [ -n "$_req" ] && "$c_csreq" -r "=$_req" -b "$WORK/csreq.bin" > /dev/null 2>&1; then
      _cols="$_cols, csreq"; _vals="$_vals, readfile('$WORK/csreq.bin')"
    else
      warn "    > no code requirement for $1 (codesign: ${_req:-none}) -- listed without one"
    fi
  fi
  [ "$VRB" = "1" ] && printf ' >>> %s %s "insert into access (%s) ..."\n' "$c_sqlite3" "$TCC_DB" "$_cols"
  "$c_sqlite3" -bail "$TCC_DB" "INSERT INTO access ($_cols) VALUES ($_vals);" > "$WORK/insert.out" 2>&1 \
    || err 00033 "cannot list $1 in TCC.db: $(cat "$WORK/insert.out") -- backup: $BACKUP_FILE"
  run "$c_killall" tccd > /dev/null 2>&1 \
    || warn "    > could not restart tccd ($c_killall tccd) -- the pane may show it only after a restart"
}

cmd_list() {
  [ $# -eq 0 ] || err 00034 "list takes no arguments"
  PHASE="reading the grants -- nothing was changed"
  grants_to "$WORK/all"
  render < "$WORK/all"
  [ "$QUIET" = "1" ] || summary < "$WORK/all"
}

# Can the user at the screen read (r) or execute (x) <PATH>? As its owner,
# through one of their groups, or as anyone else -- the mode bit that
# applies to THEM. Sets SCREEN_USER; nobody at the screen (or root): the
# "others" bit decides.
screen_user_can() { # <r|x> <PATH>
  case "$1" in r) _off=0 ;; x) _off=2 ;; *) err 00035 "screen_user_can: '$1' is neither r nor x" ;; esac
  _su=$(/bin/ls -ln /dev/console 2>/dev/null | awk '{ print $3 }')
  # shellcheck disable=SC2012  # only the MODE, owner and group columns are read, never a name
  set -- "$1" "$(ls -ld "$2" | cut -c1-10)" "$(ls -lnd "$2" | awk '{ print $3 " " $4 }')"
  _want=$1; _mode=$2; _own=${3% *}; _grp=${3#* }
  if case "$_su" in ""|0|*[!0-9]*) true ;; *) false ;; esac; then
    SCREEN_USER="nobody at the screen"; _bit=8
  else
    SCREEN_USER=$(id -un "$_su" 2>/dev/null || echo "uid $_su")
    if [ "$_su" = "$_own" ]; then _bit=2
    elif id -G "$_su" 2>/dev/null | tr ' ' '\n' | grep -qx "$_grp"; then _bit=5
    else _bit=8; fi
  fi
  case "$_want$(printf '%s' "$_mode" | cut -c$((_bit + _off)))" in rr|xx|xs|xt) return 0 ;; esac
  return 1
}

cmd_add() { # <PATH>
  [ $# -eq 1 ] || err 00036 "add takes one path: $US add <PATH>"
  _p=$1
  case "$_p" in /*) ;; *) _p="$(pwd)/$_p" ;; esac
  [ -e "$_p" ] || err 00037 "'$_p' does not exist"
  _r=$(real_path "$_p")
  if [ "$_r" != "$_p" ]; then
    msg "    > $_p is $_r -- macOS records the grant under that path"
    _p=$_r
  fi
  _f=$(grant_flag "$_p")
  [ -n "$_f" ] && warn "    > $_f -- a launcher holds it for the job instead: $US create <TARGET>"
  _add_t=1; _add_c=$_p; _b=$(bundle_id "$_p")
  if [ -n "$_b" ]; then
    _add_t=0; _add_c=$_b
    msg "    > $_p is the app $_b -- macOS records the grant under that id"
  fi
  PHASE="reading the grants -- nothing was changed"
  grants_to "$WORK/every"
  ours < "$WORK/every" > "$WORK/all"
  awk -F '\t' -v t="$_add_t" -v c="$_add_c" '$2 == t && $3 == c' "$WORK/all" > "$WORK/row"
  _listed=0
  if [ -s "$WORK/row" ]; then
    case "$(cut -f 4 "$WORK/row")" in
      "allowed[2]") msg "already granted:"; render < "$WORK/row" | sed 's/^/    /'; return 0 ;;
      *) _listed=1; msg " >>> listed, but not allowed:"; render < "$WORK/row" | sed 's/^/    /' ;;
    esac
  fi
  case "$_p" in "$HELPER_DIR"/my-fda.*)
    err 00038 "'$_p' is named with a dot: macOS takes it for a document, and the pane cannot add it -- $US destroy go ${_p##*/my-fda.}, then $US create (it is named my-fda-<NAME> now)" ;;
  esac
  # System Settings runs as the screen's user and must READ the file to add
  # it -- a file that user cannot read is refused there without a word
  if ! screen_user_can r "$_p"; then
    case "$_p" in
      "$HELPER_DIR"/my-fda-*)
        run chmod 744 "$_p" || err 00039 "cannot make '$_p' readable (chmod 744)"
        msg "    > $_p made readable (744): System Settings, running as you, reads it to add it" ;;
      *) err 00040 "'$_p' is not readable by the screen's user ($SCREEN_USER) -- System Settings runs as that user and cannot add it: chmod a+r '$_p' first" ;;
    esac
  fi
  if [ "$_listed" = "0" ] && list_off "$_p" "$_add_t" "$_add_c"; then
    _listed=1
    msg "    > $_p put into the list, switched OFF [TCC.db backup: $BACKUP_FILE]"
  fi
  gui_open "$FDA_PANE_URL" || err 00041 "could not open the Full Disk Access pane ($FDA_PANE_URL)"
  if [ "$_listed" = "1" ]; then
    say " >>> Full Disk Access is open: switch ${_p##*/} ON there"
  else
    gui_open -R "$_p" || err 00042 "could not show '$_p' in Finder"
    say " >>> Full Disk Access is open, and $_p is selected in Finder (TCC.db cannot be written here):"
    # The pane silently loses a dragged-in program the screen's user cannot
    # execute (ada, macOS 27, 2026-10-26: 744 lost, 755 taken); + takes it.
    if printf '%s' "$_p" | as_screen_user "$c_pbcopy" > /dev/null 2>&1; then
      _plus="+, then Cmd-Shift-G, Cmd-V, Return -- the path is on the clipboard"
    else
      _plus="+, then Cmd-Shift-G, paste the path, Return"
    fi
    if screen_user_can x "$_p"; then
      say "    > drag it into the list -- or $_plus"
    else
      say "    > $_plus"
      say "    > (not by drag: the pane loses a program $SCREEN_USER cannot execute)"
    fi
  fi
  if [ -t 0 ] && [ -r /dev/tty ]; then
    PHASE="waiting for the grant to be switched on"
    printf '    > press Return when it is ON: '
    read -r _x < /dev/tty
    grants_to "$WORK/all"
    awk -F '\t' -v t="$_add_t" -v c="$_add_c" '$2 == t && $3 == c && $4 == "allowed[2]"' "$WORK/all" > "$WORK/row"
    [ -s "$WORK/row" ] || err 00043 "'$_add_c' is not in the list as allowed yet [grants $(wc -l < "$WORK/all" | tr -d ' ')] -- add it with + and switch it on, then $US list"
    msg "granted:"; render < "$WORK/row" | sed 's/^/    /'
  else
    say "--> then check: $US list"
  fi
}

# IDs from the arguments, or one per line on stdin -- the first word of each
# line, so a whole `list` line works too. Every ID must be 6 hex characters.
ids_to() { # <FILE> [ID...]
  _f=$1; shift
  if [ $# -gt 0 ]; then
    printf '%s\n' "$@" > "$_f"
  elif [ -t 0 ]; then
    err 00044 "no IDs: give them as arguments, or pipe them in ($US list | grep ... | cut -f 1 | $US remove)"
  else
    awk 'NF { print $1 }' > "$_f"
  fi
  while IFS= read -r _i; do
    case "$_i" in
      [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]) ;;
      *) err 00045 "'$_i' is not an ID -- IDs are the first column of '$US list' -- nothing was changed" ;;
    esac
  done < "$_f"
}

cmd_remove() { # [go] [ID...]
  _go=0; [ "${1:-}" = "go" ] && { _go=1; shift; }
  ids_to "$WORK/ids" "$@"
  if [ ! -s "$WORK/ids" ]; then msg "no IDs on stdin -- nothing to remove"; return 0; fi
  PHASE="reading the grants -- nothing was changed"
  grants_to "$WORK/all"
  : > "$WORK/sel"; _bad=""
  while IFS= read -r _i; do
    _m=$(awk -F '\t' -v i="$_i" '$1 == i' "$WORK/all")
    [ -n "$_m" ] || { _bad="$_bad $_i"; continue; }
    [ "$(printf '%s\n' "$_m" | wc -l | tr -d ' ')" = "1" ] || err 00046 "ID $_i matches more than one grant -- nothing was changed; remove those in System Settings"
    grep -qxF "$_m" "$WORK/sel" || printf '%s\n' "$_m" >> "$WORK/sel"
  done < "$WORK/ids"
  [ -z "$_bad" ] || err 00047 "no such grant:$_bad -- nothing was changed ($US list shows the IDs)"
  _not=$(awk -F '\t' '$5 ~ /^(system extension|profile)/ { printf " %s", $1 }' "$WORK/sel")
  [ -z "$_not" ] || err 00048 "not taken away by $US:$_not -- a system extension's grant goes in System Settings, a profile's with the profile; nothing was changed"
  _k=$(wc -l < "$WORK/sel" | tr -d ' ')
  render < "$WORK/sel"
  if [ "$_go" = "0" ]; then
    say "--> nothing changed -- '$US remove go' with the same IDs takes these $_k grant(s) away"
    return 0
  fi
  take_away "$WORK/sel"
  msg "removed $TAKEN of $_k grant(s) $TOOK -- TCC.db backup: $BACKUP_FILE"
}

# The GONE grants -- the one class safe to take away without looking: nothing
# is left that the grant could apply to. The same delete path as remove.
cmd_cleanup() { # [go]
  _go=0; [ "${1:-}" = "go" ] && { _go=1; shift; }
  [ $# -eq 0 ] || err 00049 "cleanup takes no IDs -- '$US remove' takes some"
  PHASE="reading the grants -- nothing was changed"
  grants_to "$WORK/all"
  awk -F '\t' '$5 ~ /^GONE/' "$WORK/all" > "$WORK/sel"
  _k=$(wc -l < "$WORK/sel" | tr -d ' ')
  if [ "$_k" = "0" ]; then
    msg "no GONE grants -- nothing to clean up [grants $(wc -l < "$WORK/all" | tr -d ' ')]"
    return 0
  fi
  render < "$WORK/sel"
  if [ "$_go" = "0" ]; then
    say "--> nothing changed -- '$US cleanup go' takes these $_k GONE grant(s) away"
    return 0
  fi
  take_away "$WORK/sel"
  msg "cleaned up $TAKEN of $_k GONE grant(s) $TOOK -- TCC.db backup: $BACKUP_FILE"
}

cmd_reset() { # [go]
  _go=0; [ "${1:-}" = "go" ] && { _go=1; shift; }
  [ $# -eq 0 ] || err 00050 "reset takes no IDs -- '$US remove' takes some"
  PHASE="reading the grants -- nothing was changed"
  grants_to "$WORK/every"
  ours < "$WORK/every" > "$WORK/all"
  _k=$(wc -l < "$WORK/all" | tr -d ' ')
  if [ "$_k" = "0" ]; then msg "no grants -- nothing to reset"; return 0; fi
  render < "$WORK/all"
  say " >>> this takes away ALL $_k grant(s) -- the Terminal running this loses its grant too:"
  say "    > give that one back first (System Settings > Full Disk Access), then $US list"
  if [ "$_go" = "0" ]; then
    say "--> nothing changed -- '$US reset go' does it"
    return 0
  fi
  BACKUP_STAMP=$(date -u +%Y%m%dT%H%M%SZ)
  mkdir -p "$BACKUP_DIR" || err 00051 "cannot create BACKUP_DIR '$BACKUP_DIR'"
  _l="$BACKUP_DIR/list.$BACKUP_STAMP.txt"
  VRB=1 render < "$WORK/all" > "$_l" || err 00052 "cannot save the list to '$_l' -- nothing was changed"
  backup_tcc
  # macOS's own bulk command: no app lookup, no writable TCC.db needed.
  PHASE="taking all grants away -- TCC.db backup: $BACKUP_FILE, the list: $_l"
  [ "$VRB" = "1" ] && printf ' >>> %s reset SystemPolicyAllFiles\n' "$c_tccutil"
  "$c_tccutil" reset SystemPolicyAllFiles < /dev/null > "$WORK/tccutil.out" 2>&1; _rc=$?
  [ "$_rc" = "0" ] || err 00053 "tccutil reset SystemPolicyAllFiles failed [rc $_rc]: $(cat "$WORK/tccutil.out") -- backup: $BACKUP_FILE"
  msg "took away all $_k grant(s) [tccutil rc $_rc] -- TCC.db backup: $BACKUP_FILE, the list: $_l"
  msg "    > not checked here: this Terminal lost its grant too -- give it back, then $US list"
  msg " >>> to give back what had been allowed:"
  awk -F '\t' '$4 == "allowed[2]" && $5 !~ /^GONE/' "$WORK/all" > "$WORK/back"
  while IFS="$TAB" read -r _i _t _c _rest; do
    if [ "$_t" = "1" ]; then msg "    > $US add $_c"
    else msg "    > $_c: System Settings > Full Disk Access, +, the app"; fi
  done < "$WORK/back"
}

############################################################## refusals

# tccd logs each check in lines that share its msgID: AUTHREQ_CTX (the
# service), AUTHREQ_SUBJECT (the client, as a grant names it),
# AUTHREQ_ATTRIBUTION (the binary that touched the file) and AUTHREQ_RESULT
# (authValue). A msgID is unique only within one tccd process, and the lines
# of checks in flight interleave: they are joined by tccd pid + msgID, never
# by order.
TCCD_PREDICATE='process == "tccd" AND (eventMessage BEGINSWITH "AUTHREQ_CTX" OR eventMessage BEGINSWITH "AUTHREQ_SUBJECT" OR eventMessage BEGINSWITH "AUTHREQ_ATTRIBUTION" OR eventMessage BEGINSWITH "AUTHREQ_RESULT")'

# `log show --style compact` lines on stdin -> one line per Full Disk Access
# check that was not allowed: date time<TAB>client<TAB>authValue<TAB>via.
refusals() {
  awk -v svc="$SERVICE" '
    function key(   p, m) {
      p = $4; sub(/^tccd\[/, "", p); sub(/:.*/, "", p)
      m = $0; sub(/.*msgID=/, "", m); sub(/,.*/, "", m)
      return p ":" m
    }
    function field(name, from,   i) {   # the value of name= in from, up to the next , or }
      i = index(from, name "=")
      if (i == 0) return ""
      from = substr(from, i + length(name) + 1); sub(/[,}].*/, "", from)
      return from
    }
    $6 == "AUTHREQ_CTX:"         { s[key()] = field("service", $0) }
    $6 == "AUTHREQ_SUBJECT:"     { c[key()] = field("subject", $0) }
    $6 == "AUTHREQ_ATTRIBUTION:" { i = index($0, "accessing={"); if (i) v[key()] = field("binary_path", substr($0, i)) }
    $6 == "AUTHREQ_RESULT:"      {
      k = key(); r = field("authValue", $0)
      if (s[k] == svc && r != "2")
        printf "%s %s\t%s\t%s\t%s\n", $1, substr($2, 1, 8), (c[k] == "" ? "?" : c[k]), r, (v[k] == "" ? "-" : v[k])
      delete s[k]; delete c[k]; delete v[k]
    }'
}

# Refusals on stdin, the grants in <FILE> -> one line per client and value:
# the client first, the value raw, how often, when last (-V: first), the
# binary that touched the file (-V: its path, and every one), what to do.
render_refusals() { # <grants FILE>
  cat > "$WORK/refused.in"
  cut -f 2 "$WORK/refused.in" | sort -u | while IFS= read -r _rc; do
    printf '%s\t%s\n' "$_rc" "$(grant_flag "$_rc")"
  done > "$WORK/flags"
  awk -F '\t' -v vrb="$VRB" -v us="$US" '
    FILENAME == ARGV[1] { g[$3] = $4; gd[$3] = $6; next }
    FILENAME == ARGV[2] { fl[$1] = $2; next }
    { k = $2 SUBSEP $3
      if (!(k in n)) { o[++rows] = k; first[k] = $1; cl[k] = $2; av[k] = $3 }
      n[k]++; last[k] = $1
      if (!((k, $4) in seen)) { seen[k, $4]; nv[k]++; via[k] = (via[k] == "" ? $4 : via[k] "," $4) } }
    END {
      for (i = 1; i <= rows; i++) {
        k = o[i]; c = cl[k]; note = ""
        if (fl[c] != "") note = fl[c] " -> give its job a launcher (" us " create)"
        if (note != "") ;
        # both dates are local "YYYY-MM-DD HH:MM:SS": they compare as strings
        else if (g[c] == "allowed[2]" && gd[c] > last[k]) note = "granted " gd[c] ", after the last refusal -- nothing to do"
        else if (g[c] == "allowed[2]") note = "granted, still refused: the grant no longer matches the binary -> " us " remove it, then add"
        else if (g[c] == "denied[0]") note = "switched OFF in the pane -> switch it on there, if it should have it"
        else if (c ~ /^com\.apple\./ || c ~ /^\/(System|bin|sbin|usr\/bin|usr\/sbin|usr\/libexec|Library\/Apple)\//)
          note = "Apple'"'"'s own, no grant: macOS refuses it routinely -- act only if a job of yours runs through it (via)"
        else if (c ~ /^\//) note = "no grant -> " us " add " c
        else note = "no grant (an app) -> System Settings > Full Disk Access, +"
        st[i] = (av[k] == "0" ? "denied[0]" : "other[" av[k] "]")
        cnt[i] = n[k] "x"; nt[i] = note
        if (vrb == "1") vs[i] = via[k]
        else { vs[i] = via[k]; sub(/,.*/, "", vs[i]); sub(/.*\//, "", vs[i]); if (nv[k] > 1) vs[i] = vs[i] " (+" nv[k] - 1 ")" }
        if (length(c) > w) w = length(c)
        if (length(cnt[i]) > wn) wn = length(cnt[i])
        if (length(vs[i]) > wv) wv = length(vs[i])
      }
      for (i = 1; i <= rows; i++) {
        k = o[i]
        l = sprintf("%-" w "s  %s  %" wn "s  ", cl[k], st[i], cnt[i])
        if (vrb == "1") l = l "first " first[k] "  "
        print l sprintf("last %s  via %-" wv "s  %s", last[k], vs[i], nt[i])
      }
    }' "$1" "$WORK/flags" "$WORK/refused.in"
}

cmd_denied() { # [LAST]
  [ $# -le 1 ] || err 00054 "usage: $US denied [<LAST>]"
  _last="${1:-$DENIED_LAST_DEFAULT}"
  case "$_last" in
    boot) ;;
    ""|[!0-9]*|*[!0-9mhd]*|*[mhd]?*) err 00055 "LAST='$_last': a number with m, h or d (30m, 2h, 3d), or boot -- what log show --last takes" ;;
  esac
  [ -x "$c_log" ] || err 00056 "c_log='$c_log' is not executable (config: $CONFIG_FILE)"
  PHASE="reading the system log -- nothing was changed"
  msg " >>> tccd's checks in the system log of the last $_last -- a long window takes a while"
  run "$c_log" show --style compact --last "$_last" --predicate "$TCCD_PREDICATE" > "$WORK/log" 2> "$WORK/log.err" \
    || err 00057 "log show failed: $(cat "$WORK/log.err")"
  _r=$(awk '$6 == "AUTHREQ_RESULT:" { n++ } END { print n+0 }' "$WORK/log")
  refusals < "$WORK/log" > "$WORK/refused"
  if [ ! -s "$WORK/refused" ]; then
    msg "no Full Disk Access refused in the last $_last [tccd checks read: $_r]"
    return 0
  fi
  grants_to "$WORK/every"
  ours < "$WORK/every" > "$WORK/all"
  render_refusals "$WORK/all" < "$WORK/refused"
  [ "$QUIET" = "1" ] || awk -F '\t' -v last="$_last" -v r="$_r" '
    { rows++; if (!($2 in c)) { c[$2]; progs++ } }
    END { printf "%d refused check(s) from %d program(s) in the last %s [tccd checks read: %d]\n", rows, progs, last, r }' "$WORK/refused"
}

############################################################## launchers

# The launcher program. `create` compiles it with the target (and the name,
# for its error lines) passed as -D on the cc command line; the marker
# string is how `status` reads the target back out of the binary.
launcher_c() {
  cat <<'_EOF'
/* my-fda launcher -- built by `my-fda create`, never edited by hand.
 *
 * A Full Disk Access grant sticks to one program's code. Granted to this
 * launcher, it lasts, because the launcher never changes; the target it
 * runs -- and all that runs -- is its child and counts as its.
 *
 * It SPAWNS the target and waits (instead of exec'ing it), so the process
 * launchd started, which holds the grant, lives for the whole run. It
 * passes on all arguments, exits with the target's status, and passes on
 * SIGTERM/SIGINT/SIGHUP. Built with --user, it first becomes that user, so
 * the target runs as the user while the grant stays this launcher's.
 *
 * Everyone may execute it -- the Full Disk Access pane loses a dragged-in
 * program its user cannot -- so it refuses to run unless started as root:
 * its LaunchDaemon. Signed with the hardened runtime, no DYLD_ variable can
 * put code into it before this check.
 */
#include <errno.h>
#include <grp.h>
#include <pwd.h>
#include <signal.h>
#include <spawn.h>
#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#include <sys/wait.h>
#include <unistd.h>

#if !defined(MY_FDA_TARGET) || !defined(MY_FDA_NAME)
#error "build with -DMY_FDA_TARGET='\"/path\"' -DMY_FDA_NAME='\"name\"'"
#endif
#ifndef MY_FDA_RUN_UID
#define MY_FDA_RUN_UID 0
#endif

__attribute__((used)) static const char marker[] = "MY-FDA-TARGET=" MY_FDA_TARGET;

#ifdef MY_FDA_USER
__attribute__((used)) static const char user_marker[] = "MY-FDA-USER=" MY_FDA_USER;
#ifdef MY_FDA_GROUP
__attribute__((used)) static const char group_marker[] = "MY-FDA-GROUP=" MY_FDA_GROUP;
#define MY_FDA_AS MY_FDA_USER ":" MY_FDA_GROUP
#else
#define MY_FDA_AS MY_FDA_USER
#endif

/* Become MY_FDA_USER for good -- groups, group, user, and the variables a
 * login gives -- or say why not; the target never runs as anyone else. */
static int become_user(void) {
    struct passwd *pw = getpwnam(MY_FDA_USER);
    const char *step = "getpwnam";
    gid_t gid = 0;
    int found = pw != NULL;
    if (found) gid = pw->pw_gid;
#ifdef MY_FDA_GROUP
    if (found) {                 /* --group: this primary group, not the user's own */
        struct group *gr = getgrnam(MY_FDA_GROUP);
        step = "getgrnam";
        found = gr != NULL;
        if (found) gid = gr->gr_gid;
    }
#endif
    if (found) {
        step = "initgroups";
        if (initgroups(pw->pw_name, (int)gid) == 0) {
            step = "setgid";
            if (setgid(gid) == 0) {
                step = "setuid";
                if (setuid(pw->pw_uid) == 0) {
                    step = "check";
                    if (setuid(0) != 0 && getuid() == pw->pw_uid && geteuid() == pw->pw_uid
                        && getgid() == gid && getegid() == gid) {
                        setenv("HOME", pw->pw_dir, 1);
                        setenv("USER", pw->pw_name, 1);
                        setenv("LOGNAME", pw->pw_name, 1);
                        setenv("SHELL", pw->pw_shell, 1);
                        return 1;
                    }
                }
            }
        }
    }
    fprintf(stderr, "ERROR 00058 [70]: my-fda-" MY_FDA_NAME ": cannot run as " MY_FDA_AS
            " (%s: %s) -- its LaunchDaemon must start it as root\n", step, errno ? strerror(errno) : "no such user or group");
    return 0;
}
#endif

extern char **environ;
static volatile pid_t child = 0;

static void forward(int sig) { if (child > 0) kill(child, sig); }

int main(int argc, char **argv) {
    pid_t pid;
    int rc, st;

    (void)argc;
    if (getuid() != MY_FDA_RUN_UID) {
        fprintf(stderr, "ERROR 00059 [77]: my-fda-" MY_FDA_NAME ": runs only as root, started by its"
                " LaunchDaemon -- not as uid %d\n", (int)getuid());
        return 77;
    }
    argv[0] = (char *)MY_FDA_TARGET;
    signal(SIGTERM, forward);
    signal(SIGINT, forward);
    signal(SIGHUP, forward);
#ifdef MY_FDA_USER
    if (!become_user()) return 70;
#endif

    rc = posix_spawn(&pid, MY_FDA_TARGET, NULL, NULL, argv, environ);
    if (rc != 0) {
        fprintf(stderr, "ERROR 00060 [70]: my-fda-" MY_FDA_NAME ": cannot start %s: %s\n",
                MY_FDA_TARGET, strerror(rc));
        return 70;
    }
    child = pid;

    while (waitpid(pid, &st, 0) < 0) {
        if (errno != EINTR) {
            fprintf(stderr, "ERROR 00061 [70]: my-fda-" MY_FDA_NAME ": waitpid: %s\n", strerror(errno));
            return 70;
        }
    }
    if (WIFEXITED(st)) return WEXITSTATUS(st);
    return 128 + WTERMSIG(st);
}
_EOF
}

# The target compiled into a launcher; empty when it carries no marker.
marker_of() { # <launcher>
  LC_ALL=C grep -a -o 'MY-FDA-TARGET=[[:print:]]*' "$1" 2>/dev/null | head -n 1 | sed 's/^MY-FDA-TARGET=//'
}

# The user a launcher runs its target as; empty: root.
user_of() { # <launcher>
  LC_ALL=C grep -a -o 'MY-FDA-USER=[[:print:]]*' "$1" 2>/dev/null | head -n 1 | sed 's/^MY-FDA-USER=//'
}
group_of() { # <launcher>
  LC_ALL=C grep -a -o 'MY-FDA-GROUP=[[:print:]]*' "$1" 2>/dev/null | head -n 1 | sed 's/^MY-FDA-GROUP=//'
}

# Where launcher <NAME> lives. No dot in its name: macOS takes what follows a
# dot for an extension, files the launcher as a Document, and the Full Disk
# Access pane then refuses it, dragged in or chosen with + (ada, 2026-10-22).
launcher_path() { # <NAME>
  printf '%s/my-fda-%s\n' "$HELPER_DIR" "$1"
}

check_name() { # <NAME>
  case "$1" in
    ""|*[!A-Za-z0-9._-]*) err 00062 "name '$1': letters, digits, '.', '_' and '-' only" ;;
  esac
}

# Every LaunchDaemon's program: program<TAB>label<TAB>plist, into <FILE>.
daemons_to() { # <FILE>
  : > "$1"
  for _pl in "$LAUNCHD_DIR"/*.plist; do
    [ -f "$_pl" ] || continue
    _pg=$("$c_plutil" -extract Program raw -o - "$_pl" 2>/dev/null) \
      || _pg=$("$c_plutil" -extract ProgramArguments.0 raw -o - "$_pl" 2>/dev/null) \
      || continue
    _lb=$("$c_plutil" -extract Label raw -o - "$_pl" 2>/dev/null) || _lb="${_pl##*/}"
    printf '%s\t%s\t%s\n' "$_pg" "$_lb" "$_pl" >> "$1"
  done
}

# The NAME create takes when given none: the target's file name without
# its extension, any other character a launcher's name may not have as '-'.
name_of() { # <TARGET>
  _nm=${1##*/}
  printf '%s\n' "${_nm%.*}" | sed 's/[^A-Za-z0-9_-]/-/g'
}

cmd_create() { # [NAME] <TARGET>
  case $# in
    1) set -- "$(name_of "$1")" "$1"
       msg "    > NAME $1, from the target's file name -- $US create <NAME> <TARGET> chooses another" ;;
    2) ;;
    *) err 00063 "usage: $US create [<NAME>] <TARGET>" ;;
  esac
  check_name "$1"
  case "$1" in *.*) err 00064 "name '$1': no '.' -- my-fda-$1 would look like a document, and the pane cannot add it" ;; esac
  _t=$2
  _l=$(launcher_path "$1")
  case "$_t" in /*) ;; *) err 00065 "target '$_t' must be an absolute path" ;; esac
  case "$_t" in *\"*|*\\*) err 00066 "target '$_t': no '\"' or '\\' in the path" ;; esac
  [ -f "$_t" ] && [ -x "$_t" ] || err 00067 "target '$_t' is not an executable file"
  for _cel in $BREW_CELLARS; do
    case "$_t" in "$_cel"/*)
      err 00068 "target '$_t' is a Homebrew version path: it changes on upgrade -- use its stable path, /opt/homebrew/bin/${_t##*/}" ;;
    esac
  done
  for _sh in $SHELLS; do
    [ "$_t" = "$_sh" ] && err 00069 "target '$_t' is a shell: every script it runs would get full disk access"
  done
  if [ -n "$USER_ARG" ]; then
    case "$USER_ARG" in (*[!A-Za-z0-9._-]*) err 00070 "--user '$USER_ARG': not a user name" ;; esac
    _uid=$(id -u "$USER_ARG" 2>/dev/null) || err 00071 "--user '$USER_ARG': no such user on this machine"
    [ "$_uid" != "0" ] || err 00072 "--user $USER_ARG: that is root -- leave --user out, a launcher runs as root anyway"
  fi
  if [ -n "$GROUP_ARG" ]; then
    [ -n "$USER_ARG" ] || err 00073 "--group goes with --user: it is the primary group the launcher takes when it becomes that user"
    case "$GROUP_ARG" in (*[!A-Za-z0-9._-]*) err 00074 "--group '$GROUP_ARG': not a group name" ;; esac
    "$c_dscl" . -read "/Groups/$GROUP_ARG" PrimaryGroupID > /dev/null 2>&1 \
      || err 00075 "--group '$GROUP_ARG': no such group on this machine"
  fi
  [ -e "$_l" ] && err 00076 "'$_l' exists -- a rebuild loses its grant; to rebuild on purpose: $US destroy go $1, then create"
  if ! { [ -x "$c_cc" ] && "$c_xcode_select" -p > /dev/null 2>&1; }; then
    err 00077 "no compiler: needs the Command Line Tools -- xcode-select --install"
  fi
  if [ ! -d "$HELPER_DIR" ]; then
    if [ "$(id -u)" = "0" ]; then run install -d -m 755 -o root -g wheel "$HELPER_DIR"
    else run install -d -m 755 "$HELPER_DIR"; fi || err 00078 "cannot create '$HELPER_DIR'"
    msg "    > $HELPER_DIR (created: it did not exist -- macOS's place for root's helper programs)"
  fi
  PHASE="building the launcher -- nothing was installed yet"
  launcher_c > "$WORK/launcher.c"
  run "$c_cc" -O2 -Wall "-DMY_FDA_TARGET=\"$_t\"" "-DMY_FDA_NAME=\"$1\"" "-DMY_FDA_RUN_UID=$LAUNCHER_UID" ${USER_ARG:+"-DMY_FDA_USER=\"$USER_ARG\""} ${GROUP_ARG:+"-DMY_FDA_GROUP=\"$GROUP_ARG\""} \
    -o "$WORK/launcher" "$WORK/launcher.c" > "$WORK/cc.log" 2>&1 \
    || err 00079 "cc failed: $(cat "$WORK/cc.log")"
  [ "$(marker_of "$WORK/launcher")" = "$_t" ] \
    || err 00080 "the built launcher does not carry its target marker -- not installed"
  [ "$(user_of "$WORK/launcher")" = "$USER_ARG" ] \
    || err 00081 "the built launcher does not carry its user marker ($USER_ARG) -- not installed"
  [ "$(group_of "$WORK/launcher")" = "$GROUP_ARG" ] \
    || err 00082 "the built launcher does not carry its group marker ($GROUP_ARG) -- not installed"
  # cc only linker-signs, under the temp file's name: the Full Disk Access
  # pane takes such a file with + but loses it when dragged in (ada,
  # 2026-10-26). A real ad-hoc signature under its own name, as my-tm signs
  # my-tm-launcher, is dragged in like any other program.
  run "$c_codesign" -s - -f -o runtime -i "my-fda-$1" "$WORK/launcher" > "$WORK/sign.log" 2>&1 \
    || err 00083 "codesign failed: $(cat "$WORK/sign.log") -- not installed"
  # 755: System Settings, running as the screen's user, loses a dragged-in
  # program that user cannot execute (ada, 2026-10-26); the launcher itself
  # refuses to run as anyone but root, so executing it grants nothing
  if [ "$(id -u)" = "0" ]; then run install -m 755 -o root -g wheel "$WORK/launcher" "$_l"
  else run install -m 755 "$WORK/launcher" "$_l"; fi || err 00084 "cannot install '$_l'"
  msg "created $_l -> $_t${USER_ARG:+, as $USER_ARG${GROUP_ARG:+:$GROUP_ARG}} [marker ok]"
  msg "--> next: $US add $_l -- then point the LaunchDaemon's Program at it${USER_ARG:+ (and no UserName in it)}, and $US test $1"
}

# A launcher by name, or an error that names what exists.
launcher_of() { # <NAME>
  check_name "$1"
  _lo=$(launcher_path "$1")
  # a launcher from before 2026-10-22, named with a dot, still runs its job
  [ -e "$_lo" ] || [ ! -e "$HELPER_DIR/my-fda.$1" ] || _lo="$HELPER_DIR/my-fda.$1"
  [ -e "$_lo" ] || err 00085 "no launcher '$1' ($_lo) -- $US status lists them"
  printf '%s\n' "$_lo"
}

cmd_status() { # [NAME]
  [ $# -le 1 ] || err 00086 "usage: $US status [<NAME>]"
  if [ $# -eq 1 ]; then
    launcher_of "$1" > "$WORK/launchers" || exit 1
  else
    : > "$WORK/launchers"
    for _f in "$HELPER_DIR"/my-fda-* "$HELPER_DIR"/my-fda.*; do
      [ -e "$_f" ] && printf '%s\n' "$_f" >> "$WORK/launchers"
    done
  fi
  if [ ! -s "$WORK/launchers" ]; then
    msg "no launchers in $HELPER_DIR -- $US create <TARGET> makes one"
    return 0
  fi
  PHASE="reading the grants -- nothing was changed"
  grants_to "$WORK/all"
  daemons_to "$WORK/daemons"
  : > "$WORK/status"
  while IFS= read -r _l; do
    _nm=${_l##*/my-fda[.-]}
    _t=$(marker_of "$_l"); _tn=""; _as=$(user_of "$_l"); _ag=$(group_of "$_l")
    if [ -z "$_t" ]; then _t="?"; _tn="no target marker: not built by $US"
    elif [ ! -e "$_t" ]; then _tn="target GONE -> recreate it, or $US destroy $_nm"; fi
    [ -n "$_as" ] && _t="$_t (as $_as${_ag:+:$_ag})"
    case "$_l" in */my-fda.*) _tn="${_tn:+$_tn; }old name (a dot): the pane cannot add it -> rebuild as my-fda-$_nm" ;; esac
    _g=$(awk -F '\t' -v c="$_l" '$2 == "1" && $3 == c { print $1 " " $4 }' "$WORK/all")
    if [ -z "$_g" ]; then _g="none"; _gn="no grant -> $US add $_l"; else _gn=""; fi
    _u=$(awk -F '\t' -v l="$_l" '$1 == l { printf "%s%s", sep, $2; sep = "," }' "$WORK/daemons")
    [ -n "$_u" ] || _u="unused"
    _note="${_tn:-${_gn:--}}"
    [ -n "$_tn" ] && [ -n "$_gn" ] && _note="$_tn; $_gn"
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$_nm" "$_t" "$_g" "$_u" "$_note" "$_l" >> "$WORK/status"
  done < "$WORK/launchers"
  awk -F '\t' -v vrb="$VRB" '
    { for (k = 1; k <= 6; k++) { f[NR, k] = $k; if (length($k) > w[k]) w[k] = length($k) } }
    END {
      for (i = 1; i <= NR; i++) {
        l = sprintf("%-" w[1] "s  %-" w[2] "s  grant %-" w[3] "s  used by %-" w[4] "s  %s",
                    f[i, 1], f[i, 2], f[i, 3], f[i, 4], f[i, 5])
        if (vrb == "1") l = l "  (" f[i, 6] ")"
        print l
      }
    }' "$WORK/status"
}

cmd_test() { # <NAME>
  [ $# -eq 1 ] || err 00087 "usage: $US test <NAME>"
  _l=$(launcher_of "$1") || exit 1
  daemons_to "$WORK/daemons"
  awk -F '\t' -v l="$_l" '$1 == l' "$WORK/daemons" > "$WORK/users"
  _k=$(wc -l < "$WORK/users" | tr -d ' ')
  [ "$_k" != "0" ] || err 00088 "no LaunchDaemon in $LAUNCHD_DIR runs $_l -- set its Program to that path first"
  [ "$_k" = "1" ] || err 00089 "$_k LaunchDaemons run $_l: $(cut -f 2 "$WORK/users" | tr '\n' ' ')-- start the one you mean: launchctl kickstart system/<label>"
  _lb=$(cut -f 2 "$WORK/users"); _pl=$(cut -f 3 "$WORK/users")
  _as=$(user_of "$_l")
  if [ -n "$_as" ] && _un=$("$c_plutil" -extract UserName raw -o - "$_pl" 2>/dev/null); then
    err 00090 "$_pl runs it as $_un, but $_l drops to $_as itself and must start as root -- take UserName out of the plist"
  fi
  PHASE="starting system/$_lb -- if it started, it runs on under launchd"
  if ! run "$c_launchctl" kickstart "system/$_lb" > "$WORK/kick" 2>&1; then
    err 00091 "launchctl kickstart system/$_lb failed: $(cat "$WORK/kick") -- is it loaded? launchctl bootstrap system $_pl"
  fi
  _log=$("$c_plutil" -extract StandardErrorPath raw -o - "$_pl" 2>/dev/null) \
    || _log=$("$c_plutil" -extract StandardOutPath raw -o - "$_pl" 2>/dev/null) \
    || _log="none set in $_pl"
  msg "started system/$_lb through launchd -- it runs under the grant of $_l${_as:+, as $_as}, as it will unattended"
  msg "    > its log: $_log"
  msg "--> when it ends: launchctl print system/$_lb | grep 'last exit code'"
}

cmd_destroy() { # [go] <NAME>
  _go=0; [ "${1:-}" = "go" ] && { _go=1; shift; }
  [ $# -eq 1 ] || err 00092 "usage: $US destroy [go] <NAME>"
  _l=$(launcher_of "$1") || exit 1
  PHASE="reading the grants -- nothing was changed"
  grants_to "$WORK/all"
  daemons_to "$WORK/daemons"
  awk -F '\t' -v c="$_l" '$2 == "1" && $3 == c' "$WORK/all" > "$WORK/sel"
  _u=$(awk -F '\t' -v l="$_l" '$1 == l { printf "%s%s", sep, $2; sep = "," }' "$WORK/daemons")
  say "launcher  $_l -> $(marker_of "$_l")"
  if [ -s "$WORK/sel" ]; then say "grant     $(render < "$WORK/sel")"; else say "grant     none"; fi
  say "used by   ${_u:-unused}"
  [ -n "$_u" ] && say "    > that job fails once the launcher is gone -- point its Program elsewhere first"
  if [ "$_go" = "0" ]; then
    say "--> nothing changed -- '$US destroy go $1' deletes the launcher and its grant"
    return 0
  fi
  [ -s "$WORK/sel" ] && take_away "$WORK/sel"
  PHASE="deleting the launcher -- its grant is already gone"
  run rm -f "$_l" || err 00093 "cannot delete '$_l'"
  if [ -s "$WORK/sel" ]; then
    msg "destroyed $_l, its grant $TOOK -- TCC.db backup: $BACKUP_FILE"
  else
    msg "destroyed $_l [it had no grant]"
  fi
}

