  t_grant 1 "$T_DIR/bin/other" 0 kTCCServiceSystemPolicyAppBundles
  t_grant 0 com.example.app 2 kTCCServiceAccessibility
  _d=$(QUIET=1 cmd_list)
  case "$_d" in *AppBundles*|*Accessibility*|*"/bin/other"*) t_fail "default took another service: '$_d'"; return ;; esac
  _o=$( (SERVICE_SEL=appbundles; QUIET=1; cmd_list) 2>&1)
  case "$_o" in *"/bin/tool "*"SystemPolicyAppBundles  system  allowed[2]"*) ;; *) t_fail "tool: '$_o'"; return ;; esac
  case "$_o" in *"/bin/other "*"SystemPolicyAppBundles  system  denied[0]"*) ;; *) t_fail "other: '$_o'"; return ;; esac
  case "$_o" in *AllFiles*|*Accessibility*) t_fail "part took another: '$_o'"; return ;; esac
