  case "$_o" in *"TCC_DB_WRITABLE=yes already recorded in $T_DIR/local/my-fda.conf"*) ;; *) t_fail "second: '$_o'"; return ;; esac
  [ "$(git -C "$T_DIR/local" rev-list --count HEAD)" = "$_c" ] || { t_fail "second run committed"; return; }
  [ "$(id -u)" = "0" ] && { echo "  SKIP  $T_NAME (read-only half) -- root writes a read-only file"; t_pass; return; }
  chmod 444 "$TCC_DB"
  _o=$( (CONFIG_LOCAL_DIR="$T_DIR/local"; cmd_install) 2>&1)
  chmod 644 "$TCC_DB"
  case "$_o" in *"TCC.db write test: refused ("*") -> TCC_DB_WRITABLE=no recorded in $T_DIR/local/my-fda.conf (was yes), committed"*) ;; *) t_fail "refused: '$_o'"; return ;; esac
  if [ "$(grep -c '^TCC_DB_WRITABLE=' "$T_DIR/local/my-fda.conf")" = "1" ] && grep -qx 'TCC_DB_WRITABLE=no' "$T_DIR/local/my-fda.conf"; then t_pass; else t_fail "file: $(cat "$T_DIR/local/my-fda.conf")"; fi
