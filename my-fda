# One tccd check, its lines as `log show --style compact` prints them.
t_check() { # <tccd pid> <msgID> <service> <subject> <accessing binary> <authValue> [<time>]
  _p="2026-10-25 ${7:-10:01:30}.083 Df tccd[$1:428a401] [com.apple.TCC:access]"
  printf '%s\n' \
    "$_p AUTHREQ_CTX: msgID=$2, function=TCCAccessRequest, service=$3, preflight=yes, query=1, client_dict=(null), daemon_dict=<private>" \
    "$_p AUTHREQ_ATTRIBUTION: msgID=$2, attribution={responsible={TCCDProcess: identifier=com.apple.dash, pid=45618, auid=0, euid=0, responsible_path=$4, binary_path=$4}, accessing={TCCDProcess: identifier=x, pid=45749, auid=0, euid=0, binary_path=$5}, requesting={TCCDProcess: identifier=com.apple.sandboxd, pid=186, auid=0, euid=0, binary_path=/usr/libexec/sandboxd}, }," \
    "$_p AUTHREQ_SUBJECT: msgID=$2, subject=$4," \
    "$_p AUTHREQ_RESULT: msgID=$2, authValue=$6, authReason=5, authVersion=1, desired_auth=0, error=(null),"
}
t_denied_names_the_program_how_often_and_via() {
  { t_check 191 186.1 "$SERVICE" /bin/sh /usr/sbin/diskutil 0 10:00:24
    t_check 191 186.2 "$SERVICE" /usr/sbin/sshd /usr/libexec/sshd-session 2
    t_check 191 186.3 "$SERVICE" /bin/sh /usr/sbin/diskutil 0 10:06:58; } > "$T_DIR/tccd.log"
  _o=$(cmd_denied 2>&1)
  case "$_o" in *sshd*) t_fail "an allowed check is listed: '$_o'"; return ;; esac
  case "$_o" in *"/bin/sh  denied[0]  2x  last 2026-10-25 10:06:58  via diskutil  a shell"*) ;; *) t_fail "got '$_o'"; return ;; esac
  _o=$(VRB=1 cmd_denied 2>&1)
  case "$_o" in *"first 2026-10-25 10:00:24  last 2026-10-25 10:06:58  via /usr/sbin/diskutil  a shell"*) t_pass ;; *) t_fail "-V: '$_o'" ;; esac
}
# Lines of two checks interleaved, with the SAME msgID from two tccd
# processes: joined by order or by msgID alone, the denial is pinned on the
# allowed program.
t_denied_joins_checks_by_tccd_and_msgid_not_by_order() {
  t_check 191 186.7 "$SERVICE" /bin/sh /usr/sbin/diskutil 0 > "$T_DIR/a"
  t_check 512 186.7 "$SERVICE" /usr/sbin/sshd /usr/libexec/sshd-session 2 > "$T_DIR/b"
  t_check 191 186.8 kTCCServiceSystemPolicyRemovableVolumes /bin/zsh /usr/sbin/diskutil 0 > "$T_DIR/c"
  paste -d '\n' "$T_DIR/a" "$T_DIR/b" "$T_DIR/c" > "$T_DIR/tccd.log"
  _o=$(cmd_denied 2>&1)
  case "$_o" in *sshd*|*zsh*) t_fail "pinned on the wrong check: '$_o'"; return ;; esac
  case "$_o" in *"/bin/sh  denied[0]  1x"*"via diskutil"*) t_pass ;; *) t_fail "got '$_o'" ;; esac
}
