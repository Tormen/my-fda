# The attack the hardened runtime is there for: code put into the launcher
# with DYLD_INSERT_LIBRARIES runs BEFORE main, so the uid check cannot stop it.
t_launcher_takes_no_injected_code() {
  { [ -x "$c_cc" ] && "$c_xcode_select" -p > /dev/null 2>&1; } || { echo "  SKIP  $T_NAME -- no cc"; t_pass; return; }
  printf '#!/bin/sh\n' > "$T_DIR/bin/job"; chmod 755 "$T_DIR/bin/job"
  cmd_create job "$T_DIR/bin/job" > /dev/null 2>&1
  printf '%s\n' '#include <stdio.h>' \
    "__attribute__((constructor)) static void in(void) { FILE *f = fopen(\"$T_DIR/injected\", \"w\"); if (f) fclose(f); }" \
    > "$T_DIR/inject.c"
  "$c_cc" -dynamiclib -o "$T_DIR/inject.dylib" "$T_DIR/inject.c" > /dev/null 2>&1 || { t_fail "cannot build the test library"; return; }
  # the library works: it goes into a program built the same way, without
  # the hardened runtime
  printf 'int main(void) { return 0; }\n' > "$T_DIR/plain.c"
  "$c_cc" -o "$T_DIR/plain" "$T_DIR/plain.c" > /dev/null 2>&1
  DYLD_INSERT_LIBRARIES="$T_DIR/inject.dylib" "$T_DIR/plain" > /dev/null 2>&1
  [ -e "$T_DIR/injected" ] || { t_fail "the test library never ran -- the test proves nothing"; return; }
  rm -f "$T_DIR/injected"
  DYLD_INSERT_LIBRARIES="$T_DIR/inject.dylib" "$HELPER_DIR/my-fda-job" > /dev/null 2>&1
  if [ ! -e "$T_DIR/injected" ]; then t_pass; else t_fail "code was injected into the launcher"; fi
}
