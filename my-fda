                t_test_refuses_unused_and_ambiguous t_destroy_shows_then_go_deletes_launcher_and_grant \
                t_list_refuses_without_root t_old_config_takes_new_keys_from_the_defaults \
                t_config_setting_a_key_empty_names_it \
                t_default_config_has_every_key t_config_offer_names_only_searched_paths t_site_conf_gives_the_bases_the_search_and_the_offer t_site_conf_behind_a_closed_folder_or_a_dangling_link_is_an_error t_site_conf_refused_by_the_system_is_an_error_whatever_the_mode_bits t_config_reads_global_then_local t_install_records_whether_tcc_db_can_be_written t_install_without_full_disk_access_records_nothing t_install_creates_the_local_config_or_uses_the_one_read \
                t_create_config_never_overwrites t_dashed_verb_and_rm_name_the_verb \
                t_help_names_every_verb t_help_keeps_the_lines_callers_probe t_completion_installs_once_and_names_every_verb t_err_codes_unique_in_order_without_gaps"
  # Each test builds its own world, so the selected tests are dealt
  # round-robin into BLOCKS, one process per core, run in parallel (the
  # spread puts the slow ones -- cc builds -- in different blocks). A test
  # keeps its number from the list, whatever order it ends in; a TAP line is
  # one write, so the lines never mix; what a block prints besides comes as
  # one piece at the end. A block that dies leaves its tests "not ok".
  _rt_tb=$(mktemp -d "${TMPDIR:-/tmp}/my-fda-tests.XXXXXX") || exit 1
  _rt_k=0
  for T_NAME in $T_ALL; do
    case "$T_NAME" in *"$1"*) _rt_k=$((_rt_k + 1)); printf '%s %s\n' "$_rt_k" "$T_NAME" >> "$_rt_tb/selected" ;; esac
  done
  _rt_n=$_rt_k
  T_STUBS="$_rt_tb/stubs"; t_stubs "$T_STUBS"
  echo "1..$_rt_n"
  _rt_b=$(sysctl -n hw.ncpu 2>/dev/null) || _rt_b=1
  [ "$_rt_b" -le "$_rt_n" ] || _rt_b=$_rt_n
  [ "$_rt_b" -ge 1 ] || _rt_b=1
  _rt_i=0
  while [ "$_rt_i" -lt "$_rt_b" ]; do
    (
      while read -r _rt_k T_NAME; do
        [ $(((_rt_k - 1) % _rt_b)) = "$_rt_i" ] || continue
        _rt_bad=$T_BAD
        { t_world; "$T_NAME"; } >> "$_rt_tb/detail.$_rt_i" 2>&1
        rm -rf "$T_DIR"
        if [ "$T_BAD" = "$_rt_bad" ]; then _rt_r="ok"; else _rt_r="not ok"; fi
        echo "$_rt_r $_rt_k - $T_NAME"
        echo "$_rt_k $_rt_r" >> "$_rt_tb/result.$_rt_i"
        echo "$T_OK $T_BAD" > "$_rt_tb/count.$_rt_i"
      done < "$_rt_tb/selected"
    ) &
    _rt_i=$((_rt_i + 1))
  done
  wait
  cat "$_rt_tb"/detail.* 2>/dev/null
  # a test with no result line: its block died -- it did not pass
  cat "$_rt_tb"/result.* 2>/dev/null | cut -d ' ' -f 1 | sort -n > "$_rt_tb/done"
  while read -r _rt_k T_NAME; do
    grep -qx "$_rt_k" "$_rt_tb/done" && continue
    echo "not ok $_rt_k - $T_NAME (its block ended before it)"; T_BAD=$((T_BAD + 1))
  done < "$_rt_tb/selected"
  for _rt_c in "$_rt_tb"/count.*; do
    [ -f "$_rt_c" ] || continue
    read -r _rt_o _rt_f < "$_rt_c"; T_OK=$((T_OK + _rt_o)); T_BAD=$((T_BAD + _rt_f))
  done
  rm -rf "$_rt_tb"
  echo "tests: $T_OK passed, $T_BAD failed [$((T_OK + T_BAD))] -- $_rt_n test(s) in $_rt_b block(s)"
  [ "$T_BAD" = "0" ]
}

############################################################## main

ARGS_TEXT="$*"
_n=$#
while [ "$_n" -gt 0 ]; do
  _a=$1; shift; _n=$((_n - 1))
  case "$_a" in
    -h|--help)        usage; exit 0 ;;
    --version)        version; exit 0 ;;
    --stamp-version)  stamp_version; exit $? ;;
    -V|--verbose)     VRB=1 ;;
    -Q|--quiet)       QUIET=1 ;;
    --config)         [ "$_n" -ge 1 ] || err 00120 "--config needs a file"; CONFIG_ARG="$1"; shift; _n=$((_n - 1)) ;;
    --config=*)       CONFIG_ARG="${_a#--config=}" ;;
    --user)           [ "$_n" -ge 1 ] || err 00121 "--user needs a user name"; USER_ARG="$1"; shift; _n=$((_n - 1)) ;;
    --user=*)         USER_ARG="${_a#--user=}" ;;
    --group)          [ "$_n" -ge 1 ] || err 00122 "--group needs a group name"; GROUP_ARG="$1"; shift; _n=$((_n - 1)) ;;
    --group=*)        GROUP_ARG="${_a#--group=}" ;;
    --recommended)    RECOMMENDED=1 ;;
    --catch)          CATCH=1 ;;
    --service)        [ "$_n" -ge 1 ] || err 00123 "--service needs a service: a part of its name (RemovableVolumes), or all"; SERVICE_SEL="$1"; shift; _n=$((_n - 1)) ;;
    --service=*)      SERVICE_SEL="${_a#--service=}" ;;
    --since)          [ "$_n" -ge 1 ] || err 00124 "--since needs a local time, YYYY-MM-DD HH:MM:SS"; SINCE_ARG="$1"; shift; _n=$((_n - 1)) ;;
    --since=*)        SINCE_ARG="${_a#--since=}" ;;
    --until)          [ "$_n" -ge 1 ] || err 00125 "--until needs a local time, YYYY-MM-DD HH:MM:SS"; UNTIL_ARG="$1"; shift; _n=$((_n - 1)) ;;
    --until=*)        UNTIL_ARG="${_a#--until=}" ;;
    --create-config)  if [ "$_n" -ge 1 ] && [ "${1#-}" = "$1" ]; then create_config "$1"; else create_config; fi; exit 0 ;;
    --create-config=*) create_config "${_a#--create-config=}"; exit 0 ;;
    --run-tests)      run_tests "${1:-}"; exit $? ;;
    --install)        INSTALL=1 ;;
    --list|--denied|--add|--remove|--cleanup|--reset|--create|--destroy|--status|--test)
                      err 00126 "no such option; you mean \`$US ${_a#--}\`" ;;
    -*)               err 00127 "unknown option '$_a' (--help)" ;;
    *)                set -- "$@" "$_a" ;;
  esac
done
[ "$VRB" = "1" ] && QUIET=0

CMD="${1:-}"; [ $# -gt 0 ] && shift
case "$CMD" in
  list|denied|add|remove|cleanup|reset|create|destroy|status|test) ;;
  rm)  err 00128 "no such command; you mean \`$US remove\`" ;;
  install) err 00129 "no such command; you mean \`$US --install\`" ;;
  "")  [ "$INSTALL" = "1" ] || { usage 1>&2; exit 1; } ;;
  *)   err 00130 "unknown command '$CMD' (--help)" ;;
esac
[ "$INSTALL" = "0" ] || [ -z "$CMD" ] || err 00131 "--install goes alone -- it records what this machine lets my-fda do"
[ -z "$USER_ARG" ] || [ "$CMD" = create ] || err 00132 "--user goes with create -- the user a new launcher runs its target as"
[ -z "$GROUP_ARG" ] || [ "$CMD" = create ] || err 00133 "--group goes with create -- with --user, the primary group a new launcher takes"
[ "$CATCH" = "0" ] || [ "$CMD" = denied ] || err 00134 "--catch goes with denied -- it waits for the next refused check"
[ -z "$SERVICE_SEL" ] || [ "$CMD" = denied ] || [ "$CMD" = list ] || err 00135 "--service goes with denied or list -- the TCC services whose refusals it reports, or whose grants it lists"
[ -z "$SINCE_ARG" ] || [ "$CMD" = denied ] || err 00136 "--since goes with denied -- the local time its window starts at"
[ -z "$UNTIL_ARG" ] || [ "$CMD" = denied ] || err 00137 "--until goes with denied -- with --since, the local time its window ends at"
[ "$RECOMMENDED" = "0" ] || [ "$CMD" = remove ] || err 00138 "--recommended goes with remove -- the grants '$US list' marks '$TO_REMOVE'"

need_root
load_config
install_zsh_completion
WORK=$(mktemp -d "${TMPDIR:-/tmp}/my-fda.XXXXXX") || err 00139 "mktemp failed"
interrupt_traps

case "$CMD" in
  "")      cmd_install ;;
  list)    cmd_list "$@" ;;
  denied)  cmd_denied "$@" ;;
  add)     cmd_add "$@" ;;
  remove)  cmd_remove "$@" ;;
  cleanup) cmd_cleanup "$@" ;;
  reset)   cmd_reset "$@" ;;
  create)  cmd_create "$@" ;;
  destroy) cmd_destroy "$@" ;;
  status)  cmd_status "$@" ;;
  test)    cmd_test "$@" ;;
esac
