                t_old_dotted_launcher_still_runs_its_job_and_is_flagged t_new_launcher_has_no_dot_in_its_name \
                t_create_takes_its_name_from_the_target t_launcher_is_signed_under_its_own_name \
                t_launcher_refuses_to_run_as_anyone_but_root t_launcher_takes_no_injected_code \
                t_test_refuses_unused_and_ambiguous t_destroy_shows_then_go_deletes_launcher_and_grant \
                t_list_refuses_without_root t_old_config_takes_new_keys_from_the_defaults \
                t_config_setting_a_key_empty_names_it \
                t_default_config_has_every_key t_config_offer_names_only_searched_paths \
                t_create_config_never_overwrites t_dashed_verb_and_rm_name_the_verb \
                t_help_names_every_verb t_err_codes_unique_in_order_without_gaps"
  _rt_n=0
  for T_NAME in $T_ALL; do
    case "$T_NAME" in *"$1"*) _rt_n=$((_rt_n + 1)) ;; esac
  done
  echo "1..$_rt_n"
  _rt_k=0
  for T_NAME in $T_ALL; do
    case "$T_NAME" in *"$1"*) ;; *) continue ;; esac
    _rt_k=$((_rt_k + 1)); _rt_bad=$T_BAD
    t_world
    "$T_NAME"
    rm -rf "$T_DIR"
    if [ "$T_BAD" = "$_rt_bad" ]; then echo "ok $_rt_k - $T_NAME"; else echo "not ok $_rt_k - $T_NAME"; fi
  done
  echo "tests: $T_OK passed, $T_BAD failed [$((T_OK + T_BAD))]"
  [ "$T_BAD" = "0" ]
}

############################################################## main

ARGS_TEXT="$*"
_n=$#
while [ "$_n" -gt 0 ]; do
  _a=$1; shift; _n=$((_n - 1))
  case "$_a" in
    -h|--help)        usage; exit 0 ;;
    --version)        version; exit 0 ;;
    --stamp-version)  stamp_version; exit $? ;;
    -V|--verbose)     VRB=1 ;;
    -Q|--quiet)       QUIET=1 ;;
    --config)         [ "$_n" -ge 1 ] || err 00094 "--config needs a file"; CONFIG_ARG="$1"; shift; _n=$((_n - 1)) ;;
    --config=*)       CONFIG_ARG="${_a#--config=}" ;;
    --user)           [ "$_n" -ge 1 ] || err 00095 "--user needs a user name"; USER_ARG="$1"; shift; _n=$((_n - 1)) ;;
    --user=*)         USER_ARG="${_a#--user=}" ;;
    --group)          [ "$_n" -ge 1 ] || err 00096 "--group needs a group name"; GROUP_ARG="$1"; shift; _n=$((_n - 1)) ;;
    --group=*)        GROUP_ARG="${_a#--group=}" ;;
    --create-config)  if [ "$_n" -ge 1 ] && [ "${1#-}" = "$1" ]; then create_config "$1"; else create_config; fi; exit 0 ;;
    --create-config=*) create_config "${_a#--create-config=}"; exit 0 ;;
    --run-tests)      run_tests "${1:-}"; exit $? ;;
    --list|--denied|--add|--remove|--cleanup|--reset|--create|--destroy|--status|--test)
                      err 00097 "no such option; you mean \`$US ${_a#--}\`" ;;
    -*)               err 00098 "unknown option '$_a' (--help)" ;;
    *)                set -- "$@" "$_a" ;;
  esac
done
[ "$VRB" = "1" ] && QUIET=0

CMD="${1:-}"; [ $# -gt 0 ] && shift
case "$CMD" in
  list|denied|add|remove|cleanup|reset|create|destroy|status|test) ;;
  rm)  err 00099 "no such command; you mean \`$US remove\`" ;;
  "")  usage 1>&2; exit 1 ;;
  *)   err 00100 "unknown command '$CMD' (--help)" ;;
esac
[ -z "$USER_ARG" ] || [ "$CMD" = create ] || err 00101 "--user goes with create -- the user a new launcher runs its target as"
[ -z "$GROUP_ARG" ] || [ "$CMD" = create ] || err 00102 "--group goes with create -- with --user, the primary group a new launcher takes"

need_root
load_config
WORK=$(mktemp -d "${TMPDIR:-/tmp}/my-fda.XXXXXX") || err 00103 "mktemp failed"
trap 'rm -rf "$WORK"' EXIT
trap 'rm -rf "$WORK"; printf "%s: interrupted (Ctrl-C) while %s\n" "$US" "$PHASE" 1>&2; exit 130' INT TERM HUP

case "$CMD" in
  list)    cmd_list "$@" ;;
  denied)  cmd_denied "$@" ;;
  add)     cmd_add "$@" ;;
  remove)  cmd_remove "$@" ;;
  cleanup) cmd_cleanup "$@" ;;
  reset)   cmd_reset "$@" ;;
  create)  cmd_create "$@" ;;
  destroy) cmd_destroy "$@" ;;
  status)  cmd_status "$@" ;;
  test)    cmd_test "$@" ;;
esac
