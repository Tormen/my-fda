# The zsh completion, rendered for this config: the launcher names come
# from HELPER_DIR when Tab is pressed, everything else is fixed text.
zsh_completion() {
  cat <<_EOF
#compdef my-fda
# written by my-fda on each run -- edits here are overwritten

_my-fda() {
  local -a cmds names
  cmds=(
    'list:every grant and what to do with it'
    'denied:file checks macOS refused, from the system log'
    'add:put a program into the Full Disk Access list, switched off'
    'remove:take grants away (go acts)'
    'cleanup:the GONE grants (go acts)'
    'reset:all grants at once (go acts)'
    'create:build and install a launcher'
    'destroy:delete a launcher and its grant (go acts)'
    'status:each launcher, its target, its grant, its daemon'
    'test:start the daemon of a launcher'
  )
  _arguments -C \\
    '(-V --verbose)'{-V,--verbose}'[also each command, dates and paths]' \\
    '(-Q --quiet)'{-Q,--quiet}'[nothing but errors]' \\
    '--config[use this config]:config file:_files' \\
    '--create-config[print the default config, or write it to a file]' \\
    '--install[record what this machine lets my-fda do]' \\
    '--run-tests[run the built-in tests]' \\
    '--stamp-version[record the commit in this file]' \\
    '--version[version, git describe, build id]' \\
    '(-h --help)'{-h,--help}'[help]' \\
    '1:command:->cmd' \\
    '*::arg:->args'
  case \$state in
    cmd) _describe -t commands 'my-fda command' cmds ;;
    args)
      names=( $HELPER_DIR/my-fda-*(N:t) ); names=( \${names#my-fda-} )
      case \$words[1] in
        denied)  _arguments '--catch[wait for the next refusal]' \\
                   '--service[a part of a service name, or all]:service:(all AllFiles RemovableVolumes NetworkVolumes)' \\
                   '--since[from this local time on]:time (YYYY-MM-DD HH\:MM\:SS):' \\
                   '--until[with --since: up to this local time]:time (YYYY-MM-DD HH\:MM\:SS):' \\
                   '*:program, or a window such as 2h:_files' ;;
        list)    _arguments '--service[a part of a service name, or all]:service:(all AllFiles AppBundles Accessibility)' ;;
        add)     _files ;;
        remove)  _arguments '--recommended[every grant list marks -> remove]' '*:ID:(go)' ;;
        cleanup|reset) _values 'act' go ;;
        create)  _arguments '--user[the user the target runs as]:user:_users' \\
                   '--group[that user'"'"'s primary group instead]:group:_groups' '*:target:_files' ;;
        destroy) _describe 'launcher' names; _values 'act' go ;;
        status|test) _describe 'launcher' names ;;
      esac ;;
  esac
}

_my-fda "\$@"
_EOF
}

# On every run, best-effort -- it never fails the run: the completion into
# ~/.zsh/completions/_my-fda when it differs (mode 644: compinit ignores a
# 600 file without a word; the zcompdump goes, or zsh keeps the old one),
# and ~/.zshrc given the fpath line once. Each write is said in one line;
# a run with nothing to write says nothing.
install_zsh_completion() {
  [ -n "${HOME:-}" ] || return 0
  _zd="$HOME/.zsh/completions"; _zf="$_zd/_my-fda"
  _zt=$(mktemp "${TMPDIR:-/tmp}/my-fda.comp.XXXXXX") || return 0
  zsh_completion > "$_zt" || { rm -f "$_zt"; return 0; }
  if [ -f "$_zf" ] && cmp -s "$_zt" "$_zf"; then
    rm -f "$_zt"
  else
    _zw="written"; [ -f "$_zf" ] && _zw="updated"
    { mkdir -p -- "$_zd" && chmod 644 "$_zt" && mv -f "$_zt" "$_zf"; } 2>/dev/null || { rm -f "$_zt"; return 0; }
    rm -f "$HOME"/.zcompdump* 2>/dev/null
    msg "    > zsh completion $_zw: $_zf (it was missing or older; a new shell loads it)"
  fi
  _zr="$HOME/.zshrc"
  [ -f "$_zr" ] || return 0
  grep -q '\.zsh/completions' "$_zr" 2>/dev/null && return 0
  _zt=$(mktemp "${TMPDIR:-/tmp}/my-fda.zshrc.XXXXXX") || return 0
  if grep -q 'oh-my-zsh\.sh' "$_zr" 2>/dev/null; then
    # before oh-my-zsh, whose compinit then finds the directory
    awk -v d="$_zd" '!done && /oh-my-zsh\.sh/ { print "# zsh completions (my-fda)"; print "fpath=(" d " $fpath)"; done = 1 } { print }' "$_zr" > "$_zt"
  else
    # shellcheck disable=SC2016  # $fpath is zsh's, written as it is
    { cat "$_zr"; printf '\n# zsh completions (my-fda)\nfpath=(%s $fpath)\nautoload -Uz compinit && compinit\n' "$_zd"; } > "$_zt"
  fi
  # the file keeps its mode: cat over it, never mv
  if [ -s "$_zt" ] && cat "$_zt" > "$_zr" 2>/dev/null; then
    msg "    > $_zr: fpath line for $_zd added (once), so zsh finds the completion"
  fi
  rm -f "$_zt"
}

