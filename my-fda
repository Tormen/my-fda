                t_id_is_first_stable_and_cut_returns_it t_grep_GONE_picks_only_grant_rows \
                t_other_services_are_not_listed \
                t_remove_without_go_changes_nothing t_remove_go_takes_only_the_named_and_backs_up \
                t_remove_reads_ids_from_a_list_pipe t_remove_the_documented_denied_pipe \
                t_remove_empty_pipe_is_nothing_to_do \
                t_remove_unknown_id_changes_nothing t_remove_quote_in_client_deletes_that_one \
                t_installed_app_goes_through_tccutil t_gone_app_falls_back_to_sqlite \
                t_readonly_db_guides_and_fails \
                t_cleanup_without_go_changes_nothing t_cleanup_go_takes_only_the_gone \
                t_cleanup_with_nothing_gone_is_nothing_to_do \
                t_reset_go_takes_all_and_saves_the_list t_reset_without_go_changes_nothing \
                t_add_opens_the_pane_and_shows_the_file t_add_already_granted_opens_nothing \
                t_create_refuses_what_it_must t_launcher_passes_args_status_and_carries_its_target \
                t_status_shows_target_grant_and_daemon t_test_kickstarts_the_one_daemon \
                t_test_refuses_unused_and_ambiguous t_destroy_shows_then_go_deletes_launcher_and_grant \
                t_list_refuses_without_root t_config_lacking_keys_names_them \
                t_default_config_has_every_key t_config_offer_names_only_searched_paths \
                t_create_config_never_overwrites t_dashed_verb_and_rm_name_the_verb \
                t_help_names_every_verb t_err_codes_unique_in_order_without_gaps; do
    case "$T_NAME" in *"$1"*) ;; *) continue ;; esac
    t_world
    "$T_NAME"
    rm -rf "$T_DIR"
  done
  echo "tests: $T_OK passed, $T_BAD failed [$((T_OK + T_BAD))]"
  [ "$T_BAD" = "0" ]
}

############################################################## main

ARGS_TEXT="$*"
_n=$#
while [ "$_n" -gt 0 ]; do
  _a=$1; shift; _n=$((_n - 1))
  case "$_a" in
    -h|--help)        usage; exit 0 ;;
    --version)        version; exit 0 ;;
    --stamp-version)  stamp_version; exit $? ;;
    -V|--verbose)     VRB=1 ;;
    -Q|--quiet)       QUIET=1 ;;
    --config)         [ "$_n" -ge 1 ] || err 00068 "--config needs a file"; CONFIG_ARG="$1"; shift; _n=$((_n - 1)) ;;
    --config=*)       CONFIG_ARG="${_a#--config=}" ;;
    --create-config)  if [ "$_n" -ge 1 ] && [ "${1#-}" = "$1" ]; then create_config "$1"; else create_config; fi; exit 0 ;;
    --create-config=*) create_config "${_a#--create-config=}"; exit 0 ;;
    --run-tests)      run_tests "${1:-}"; exit $? ;;
    --list|--add|--remove|--cleanup|--reset|--create|--destroy|--status|--test)
                      err 00069 "no such option; you mean \`$US ${_a#--}\`" ;;
    -*)               err 00070 "unknown option '$_a' (--help)" ;;
    *)                set -- "$@" "$_a" ;;
  esac
done
[ "$VRB" = "1" ] && QUIET=0

CMD="${1:-}"; [ $# -gt 0 ] && shift
case "$CMD" in
  list|add|remove|cleanup|reset|create|destroy|status|test) ;;
  rm)  err 00071 "no such command; you mean \`$US remove\`" ;;
  "")  usage 1>&2; exit 1 ;;
  *)   err 00072 "unknown command '$CMD' (--help)" ;;
esac

need_root
load_config
WORK=$(mktemp -d "${TMPDIR:-/tmp}/my-fda.XXXXXX") || err 00073 "mktemp failed"
trap 'rm -rf "$WORK"' EXIT
trap 'rm -rf "$WORK"; printf "%s: interrupted (Ctrl-C) while %s\n" "$US" "$PHASE" 1>&2; exit 130' INT TERM HUP

case "$CMD" in
  list)    cmd_list "$@" ;;
  add)     cmd_add "$@" ;;
  remove)  cmd_remove "$@" ;;
  cleanup) cmd_cleanup "$@" ;;
  reset)   cmd_reset "$@" ;;
  create)  cmd_create "$@" ;;
  destroy) cmd_destroy "$@" ;;
  status)  cmd_status "$@" ;;
  test)    cmd_test "$@" ;;
esac
