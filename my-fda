# The stub commands, written ONCE per run into <DIR>: macOS checks every NEW
# executable on its first run, through a service all blocks share (100 ms
# against 5 ms for one already run, 2026-10-26) -- eight fresh stubs per
# test made the blocks queue there. Each stub finds the test's own directory
# in $T_DIR when it RUNS, and logs into $T_DIR/stub.
t_stubs() { # <DIR>
  mkdir -p "$1" || exit 1
  # shellcheck disable=SC2016  # the stubs expand $1, $*, $T_DIR when THEY run
  {
    # Spotlight knows Finder and one app
    printf '%s\n' '#!/bin/sh' \
      'case "$1" in *com.apple.finder*) echo /System/Library/CoreServices/Finder.app ;;' \
      '  *com.known.app*) echo /Applications/Known.app ;; esac' > "$1/mdfind"
    # open and launchctl log what they get; `asuser <uid> <program...>` runs the program
    printf '%s\n' '#!/bin/sh' 'echo "$*" >> "$T_DIR/stub/open.log"' > "$1/open"
    printf '%s\n' '#!/bin/sh' 'echo "$*" >> "$T_DIR/stub/launchctl.log"' \
      '[ "$1" = asuser ] && { shift 2; exec "$@"; }' 'exit 0' > "$1/launchctl"
    # tccutil as macOS 26 showed it: it knows installed apps only (rc 64 for any
    # other id); with no id it takes every grant of the service
    printf '%s\n' '#!/bin/sh' 'echo "$*" >> "$T_DIR/stub/tccutil.log"' \
      '[ "$1" = reset ] && [ "$2" = SystemPolicyAllFiles ] || exit 64' \
      "[ -n \"\$3\" ] || exec /usr/bin/sqlite3 \"\$T_DIR/TCC.db\" \"delete from access where service='$SERVICE';\"" \
      'case "$3" in com.known.app|com.apple.*) ;; *) echo "tccutil: No such bundle identifier \"$3\"" >&2; exit 64 ;; esac' \
      "exec /usr/bin/sqlite3 \"\$T_DIR/TCC.db\" \"delete from access where service='$SERVICE' and client_type=0 and client='\$3';\"" \
      > "$1/tccutil"
    printf '%s\n' '#!/bin/sh' 'cat > "$T_DIR/stub/clipboard"' > "$1/pbcopy"
    # LaunchServices knows a nested helper Spotlight does not index
    printf '%s\n' '#!/bin/sh' \
      'case "$2" in *com.nested.helper*) echo "/Applications/Big.app/Contents/Helper.app/" ;; *) echo "execution error (-1728)" >&2; exit 1 ;; esac' \
      > "$1/osascript"
    # log logs what it gets and prints the tccd lines a test wrote
    printf '%s\n' '#!/bin/sh' 'echo "$*" >> "$T_DIR/stub/log.log"' 'cat "$T_DIR/tccd.log" 2>/dev/null' 'exit 0' > "$1/log"
    # id names every user tester
    printf '%s\n' '#!/bin/sh' 'echo tester' > "$1/id"
  } || exit 1
  chmod 755 "$1"/*
}
