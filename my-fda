t_list_says_what_remove_does_for_a_gone_app() {
  # list's '-> remove' is what `list | grep -- '-> remove' | cut -f 1 | remove go`
  # acts on; where remove can only say "these stay", a check counting those never
  # passed (two machines, 2026-10-28). list takes it from TCC_DB_WRITABLE, which
  # --install records -- it never writes TCC.db to find out: a writable TCC.db
  # with "no" still says stays -- the proof that it does not test-write.
  t_grant 0 com.vanished.app
  # shellcheck disable=SC2030,SC2031  # each subshell sets its own value
  _n=$( (TCC_DB_WRITABLE=no; QUIET=1; cmd_list) | awk -F '\t' '/com.vanished.app/ { print $NF }')
  # shellcheck disable=SC2030,SC2031  # each subshell sets its own value
  _y=$( (TCC_DB_WRITABLE=yes; QUIET=1; cmd_list) | awk -F '\t' '/com.vanished.app/ { print $NF }')
  # shellcheck disable=SC2030,SC2031  # each subshell sets its own value
  _u=$( (TCC_DB_WRITABLE=""; QUIET=1; cmd_list) | awk -F '\t' '/com.vanished.app/ { print $NF }')
  case "$_n" in *"GONE: stays"*) ;; *) t_fail "no: '$_n'"; return ;; esac
  case "$_y" in *"GONE: stays"*|*"("*) t_fail "yes: '$_y'"; return ;; *"GONE -> remove"*) ;; *) t_fail "yes: '$_y'"; return ;; esac
  case "$_u" in *"GONE -> remove ("*"--install"*) t_pass ;; *) t_fail "unknown: '$_u'" ;; esac
}
