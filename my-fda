# The completion: written once with mode 644 and every verb main knows,
# ~/.zshrc given its fpath line before oh-my-zsh once, an older file
# replaced -- and a second run writes and says nothing.
t_completion_installs_once_and_names_every_verb() {
  mkdir -p -- "$T_DIR/home"
  # shellcheck disable=SC2016  # a .zshrc line, $ZSH is zsh's
  printf '%s\n' 'export ZSH=x' 'source $ZSH/oh-my-zsh.sh' > "$T_DIR/home/.zshrc"
  _o=$( (HOME="$T_DIR/home"; install_zsh_completion) 2>&1)
  _f="$T_DIR/home/.zsh/completions/_my-fda"
  case "$_o" in *"zsh completion written: $_f"*"fpath line for $T_DIR/home/.zsh/completions added (once)"*) ;; *) t_fail "first: '$_o'"; return ;; esac
  case "$(ls -l "$_f")" in -rw-r--r--*) ;; *) t_fail "mode: $(ls -l "$_f")"; return ;; esac
  _r=$(awk '/fpath=/ { f = NR } /oh-my-zsh\.sh/ { o = NR } END { print (f && f < o) ? "before" : "not before" }' "$T_DIR/home/.zshrc")
  [ "$_r" = "before" ] || { t_fail "fpath $_r oh-my-zsh: $(cat "$T_DIR/home/.zshrc")"; return; }
  _bad=""
  for _v in $(sed -n 's/^  \(list|denied|[a-z|]*\)) ;;$/\1/p' "$(self_path)" | tr '|' ' '); do
    grep -q "^    '$_v:" "$_f" || _bad="$_bad $_v"
  done
  [ -z "$_bad" ] || { t_fail "the completion lacks:$_bad"; return; }
  if command -v zsh > /dev/null 2>&1; then zsh -n "$_f" 2> "$T_DIR/zsh.err" || { t_fail "zsh -n: $(cat "$T_DIR/zsh.err")"; return; }; fi
  _o=$( (HOME="$T_DIR/home"; install_zsh_completion) 2>&1)
  [ -z "$_o" ] || { t_fail "second run said: '$_o'"; return; }
  [ "$(grep -c 'fpath=' "$T_DIR/home/.zshrc")" = "1" ] || { t_fail "fpath twice"; return; }
  echo old > "$_f"
  _o=$( (HOME="$T_DIR/home"; install_zsh_completion) 2>&1)
  case "$_o" in *"zsh completion updated"*) ;; *) t_fail "older: '$_o'"; return ;; esac
  if [ "$(head -n 1 "$_f")" = "#compdef my-fda" ]; then t_pass; else t_fail "not replaced: $(head -n 1 "$_f")"; fi
}
t_err_codes_unique_in_order_without_gaps() {
  _got=$(grep -o -E '(err|ERROR) 0[0-9]{4}' "$(self_path)" | awk '{ printf "%d ", $2 + 0 }')
  _want=$(awk -v n="$(printf '%s\n' "$_got" | wc -w)" 'BEGIN { for (i = 1; i <= n; i++) printf "%d ", i }')
  if [ "$_got" = "$_want" ]; then t_pass; else t_fail "codes '$_got'"; fi
}

