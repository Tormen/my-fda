  [ "$_rc" = "0" ] || { t_fail "rc $_rc '$_o'"; return; }
  case "$_o" in *"TCC.db write test: allowed -> TCC_DB_WRITABLE=yes recorded in $T_DIR/local/my-fda.conf (was no), committed"*) ;; *) t_fail "first: '$_o'"; return ;; esac
